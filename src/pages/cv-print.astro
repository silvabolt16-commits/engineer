---
import { getDB, getProfile, getAllFromTable } from '../lib/d1';
const db = getDB(Astro.locals);
const profileData = await getProfile(db) || {} as any;

const profile = {
  name: (profileData.name || '').toUpperCase(),
  phone: profileData.phone || '',
  email: profileData.email || '',
  linkedin: (profileData.linkedin || '').replace(/^https?:\/\//, ''),
  summary: profileData.cvSummary || '',
};

let rawEducation = await getAllFromTable(db, 'education') || [];
const education = rawEducation.map((edu: any) => ({
  ...edu,
  achievements: typeof edu.achievements === 'string' ? JSON.parse(edu.achievements || '[]') : (edu.achievements || [])
}));

let rawSkills = await getAllFromTable(db, 'skills') || [];
const skills = rawSkills.map((skill: any) => {
  const itemsArray = typeof skill.items === 'string' ? JSON.parse(skill.items || '[]') : (skill.items || []);
  return { category: skill.category, items: itemsArray.join(', ') };
});

const experiences = (await getAllFromTable(db, 'experiences') || [])
  .sort((a: any, b: any) => parseInt(b.duration) - parseInt(a.duration));
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <title>CV Cetak - {profile.name}</title>
  <meta name="viewport" content="width=device-width" />
  <!-- Menggunakan Tailwind CSS dari Vite -->
  <style>
    @import "tailwindcss";

    /* Konfigurasi Kertas A4 & Base Style */
    @page {
      size: A4;
      margin: 1.5cm;
    }

    @media print {
      body {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        background-color: white !important;
      }
      .no-print {
        display: none !important;
      }
    }

    body {
      font-family: 'Times New Roman', Times, serif;
      background-color: #f3f4f6; /* Untuk preview web */
    }

    /* Kertas A4 Container untuk Preview di Layar */
    .a4-preview {
      width: 210mm;
      min-height: 297mm;
      margin: 2rem auto;
      background: white;
      padding: 1.5cm;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    @media print {
      .a4-preview {
        width: 100%;
        min-height: auto;
        margin: 0;
        padding: 0;
        box-shadow: none;
      }
    }
  </style>

  <!-- Auto-Print Trigger -->
  <script>
    window.onload = () => {
      // Tunggu sebentar agar font dan CSS ter-render sempurna
      setTimeout(() => {
        window.print();
        // Coba tutup tab setelah dialog print ditutup (jika dibuka via window.open)
        window.onafterprint = () => {
          window.close();
        };
      }, 500);
    };
  </script>
</head>
<body class="text-black bg-gray-100 print:bg-white antialiased leading-relaxed text-[11.5px]">
  
  <div class="a4-preview print:w-full print:shadow-none print:m-0 print:p-0">
    
    <!-- HEADER -->
    <header class="text-center mb-6">
      <h1 class="text-2xl font-bold uppercase tracking-wide mb-1">{profile.name}</h1>
      <div class="text-[11px] font-medium text-gray-800 flex items-center justify-center gap-2">
        <span>{profile.phone}</span>
        <span>|</span>
        <span>{profile.email}</span>
        <span>|</span>
        <span>{profile.linkedin}</span>
      </div>
    </header>

    <!-- SECTION PROFIL -->
    <section class="mb-5">
      <h2 class="text-[13px] font-bold uppercase mb-1 border-b border-black pb-0.5">Ringkasan Profil</h2>
      <p class="text-justify mt-2 leading-relaxed">
        {profile.summary}
      </p>
    </section>

    <!-- SECTION PENDIDIKAN -->
    <section class="mb-5">
      <h2 class="text-[13px] font-bold uppercase mb-1 border-b border-black pb-0.5">Pendidikan</h2>
      <div class="mt-2 space-y-3">
        {education.map((edu: any) => (
          <div>
            <div class="flex justify-between items-baseline font-bold mb-1">
              <span>{edu.institution} &mdash; <span class="font-normal italic">{edu.degree}</span></span>
              <span class="text-[10.5px] whitespace-nowrap">{edu.duration}</span>
            </div>
            <ul class="list-disc list-inside ml-2 space-y-0.5">
              {edu.achievements.map((ach: string) => (
                <li class="leading-snug">{ach}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION PENGALAMAN KERJA & PELATIHAN -->
    <section class="mb-5">
      <h2 class="text-[13px] font-bold uppercase mb-1 border-b border-black pb-0.5">Pengalaman Kerja &amp; Pelatihan</h2>
      <div class="mt-2 space-y-3">
        {experiences.map((exp: any) => (
          <div>
            <div class="flex justify-between items-baseline font-bold mb-1">
              <span>{exp.title} &mdash; <span class="font-normal italic">{exp.company}</span></span>
              <span class="text-[10.5px] whitespace-nowrap">{exp.duration}</span>
            </div>
            <ul class="list-disc list-outside ml-6 space-y-0.5">
              {(typeof exp.details === 'string' ? (exp.details.startsWith('[') ? JSON.parse(exp.details) : exp.details.split(',').map((t: string) => t.trim())) : (exp.details || [])).map((detail: string) => (
                <li class="leading-snug pl-1">{detail}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION KEMAMPUAN -->
    <section>
      <h2 class="text-[13px] font-bold uppercase mb-1 border-b border-black pb-0.5">Kemampuan &amp; Kompetensi</h2>
      <div class="mt-2">
        <table class="w-full text-left border-collapse">
          <tbody>
            {skills.map((skill: any) => (
              <tr class="align-top">
                <td class="py-0.5 pr-4 font-bold whitespace-nowrap w-[120px]">{skill.category}</td>
                <td class="py-0.5 font-bold px-2">:</td>
                <td class="py-0.5">{skill.items}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

  </div>

</body>
</html>
