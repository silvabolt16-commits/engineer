---
export const prerender = false;

import { marked } from 'marked';
import { getDB, getBySlugFromTable } from '../../lib/d1';
import MainLayout from '../../layouts/MainLayout.astro';

const { slug } = Astro.params;
const db = getDB(Astro.locals);
const cert = await getBySlugFromTable(db, 'certificates', slug as string);

if (!cert) {
  return Astro.redirect('/#certificates');
}

const Content = marked.parse(cert.body || '');

const title = cert.title || 'Certificate';
const issuer = cert.issuer || '';
let date = cert.date || '';
const description = cert.description || '';

if (date && !date.includes('|')) {
  try {
    const [year, month] = date.split('-');
    if (year && month) {
      const d = new Date(parseInt(year), parseInt(month) - 1);
      date = d.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
    }
  } catch (e) {}
}
---

<MainLayout 
  title={`${title} - Fajri Awwaluddin`}
  description={description}
>
  <!-- Article Header -->
  <div class="max-w-[1400px] mx-auto px-6 md:px-8 pt-32 pb-12">
    <div class="inline-block text-[#10b981] font-extrabold tracking-widest uppercase mb-4 text-sm bg-[#10b981]/10 px-4 py-2 rounded-lg">
      {date}
    </div>
    <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.1] mb-6">{title}</h1>
    <p class="text-xl md:text-2xl text-slate-500 dark:text-neutral-400 font-medium mb-12">{issuer}</p>

    <!-- Hero Image / Certificate Photo -->
    {cert.link && cert.link.startsWith('http') ? (
      <div class="w-full rounded-[2rem] overflow-hidden mb-16 shadow-xl border-4 border-white dark:border-slate-800 relative group">
        <img src={cert.link} class="w-full h-auto object-cover" alt={title} />
      </div>
    ) : (
      <div class="w-full rounded-[2rem] overflow-hidden neu-flat border-none flex items-center justify-center py-24 mb-16">
        <div class="text-center text-slate-400 dark:text-neutral-600">
          <svg class="w-20 h-20 mx-auto mb-6 opacity-50 text-[#10b981]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <p class="font-bold text-lg tracking-wide uppercase">Sertifikat Resmi / Dokumen Pendukung</p>
        </div>
      </div>
    )}
  </div>

  <!-- Content Section -->
  <div class="max-w-[1400px] mx-auto px-6 md:px-8 pb-24">
    <div class="prose prose-lg md:prose-xl prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-neutral-300 leading-relaxed prose-a:text-[#E9582A] hover:prose-a:text-[#d04a1f]">
      <p>{description}</p>
      {Content && <div set:html={Content} />}
    </div>

    <!-- Back button -->
    <div class="mt-20 pt-8 border-t border-slate-200 dark:border-white/10">
      <a href="/#certificates" class="inline-flex items-center gap-2 text-slate-500 dark:text-neutral-400 hover:text-[#E9582A] dark:hover:text-[#E9582A] font-bold transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Kembali ke Beranda
      </a>
    </div>
  </div>
</MainLayout>
