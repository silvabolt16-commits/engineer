---
import MainLayout from '../../layouts/MainLayout.astro';
import { certificates } from '../../data/portfolio.ts';

export function getStaticPaths() {
  return certificates.map((cert) => ({
    params: { slug: cert.slug },
    props: { cert },
  }));
}

const { cert } = Astro.props;
---

<MainLayout title={`${cert.title} - Fajri Awwaluddin`}>
  <!-- Article Header -->
  <div class="max-w-[800px] mx-auto px-8 pt-32 pb-12 text-center">
    <div class="inline-block text-[#10b981] font-extrabold tracking-widest uppercase mb-4 text-sm">
      {cert.date}
    </div>
    <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">{cert.title}</h1>
    <p class="text-xl text-slate-500 font-medium mb-8">{cert.issuer}</p>
    
    <!-- Hero Image placeholder -->
    <div class="w-full rounded-2xl overflow-hidden shadow-xl border border-slate-200 bg-slate-50 flex items-center justify-center p-12">
      <div class="text-center text-slate-400">
        <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <p class="font-medium">Sertifikat Resmi / Dokumen Pendukung</p>
      </div>
    </div>
  </div>

  <!-- Content Section -->
  <div class="max-w-[700px] mx-auto px-8 pb-24">
    <div class="prose prose-lg prose-slate max-w-none text-slate-700 leading-loose text-justify">
      <p>{cert.description}</p>
    </div>
    
    <!-- Back button -->
    <div class="mt-16 pt-8 border-t border-slate-200 text-center">
      <a href="/#certificates" class="inline-flex items-center gap-2 text-slate-500 hover:text-[#E9582A] font-bold transition-colors">
        <span class="text-xl">&larr;</span> Kembali ke Beranda
      </a>
    </div>
  </div>
</MainLayout>
