---
import { getDB, getAllFromTable } from '../lib/d1';
import MainLayout from '../layouts/MainLayout.astro';
const db = getDB(Astro.locals);
const allArticles = await getAllFromTable(db, 'articles') || [];
const updates = allArticles.filter((a: any) => a.category === 'Update').sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<MainLayout title="Updates - Fajri Awwaluddin">
  <div class="pt-6 pb-6 md:pt-10 md:pb-8 max-w-[1400px] mx-auto flex flex-col md:flex-row gap-16 relative">

    <!-- Left Column (Visual) -->
    <div class="hidden md:flex md:w-5/12 lg:w-1/2 md:sticky top-32 h-[calc(100vh-10rem)] items-center justify-center">
      <!-- 3D Graphic Placeholder matching tina.io style -->
      <img src="https://tina.io/img/tina-home/llama.png"
           class="w-full max-w-[400px] object-contain drop-shadow-xl opacity-90 animate-[float_7s_ease-in-out_infinite]"
           alt="Visual Pembaruan" />
    </div>

    <!-- Right Column (Cards) -->
    <div class="w-full md:w-7/12 lg:w-1/2 flex flex-col gap-6 pb-24">
      <h1 class="text-[40px] font-extrabold text-slate-900 mb-2 tracking-tight">Updates</h1>
      <p class="text-slate-500 font-medium mb-6">Catatan, pencapaian, dan rilis terbaru.</p>

      {updates.map((update: any) => (
        <a href={`/artikel/${update.slug}`} class="block group bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] transition-all duration-300 hover:-translate-y-1 cursor-pointer">
          <div class="flex flex-col sm:flex-row items-center p-6 gap-6 outline-none">
            <!-- Left Thumbnail -->
            <div class="w-full sm:w-40 h-32 rounded-xl bg-[#ecfdf5] shrink-0 overflow-hidden relative flex items-center justify-center text-[#10b981] border border-emerald-100">
               <svg class="w-12 h-12 opacity-80 transition-transform duration-500 ease-out group-hover:scale-125" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
            </div>

            <!-- Right Content -->
            <div class="flex-1 w-full">
              <div class="inline-block bg-[#10b981] text-white text-[11px] font-bold px-3 py-1 rounded-[4px] tracking-wider mb-3">
                {update.date}
              </div>
              <h2 class="text-[22px] font-extrabold text-slate-900 leading-tight mb-4 tracking-tight">{update.title}</h2>

              <div class="text-[13px] font-bold text-slate-500 flex items-center gap-1 uppercase tracking-widest group-hover:text-[#E9582A] transition-colors">
                Baca Detail <span class="text-lg leading-none">&rarr;</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</MainLayout>
