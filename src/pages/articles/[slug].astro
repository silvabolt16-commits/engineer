---
export const prerender = false;

import { marked } from 'marked';
import { getDB, getBySlugFromTable } from '../../lib/d1';
import MainLayout from '../../layouts/MainLayout.astro';

const { slug } = Astro.params;
const db = getDB(Astro.locals);
const article = await getBySlugFromTable(db, 'articles', slug as string);

if (!article) {
  return Astro.redirect('/#articles');
}

const Content = marked.parse(article.body || '');

const title = article.title || 'Article';
const summary = article.summary || '';
const category = article.category || 'General';
let date = article.date || '';
const image = article.image || undefined;

if (date && !date.includes('|')) {
  try {
    const [year, month] = date.split('-');
    if (year && month) {
      const d = new Date(parseInt(year), parseInt(month) - 1);
      date = d.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
    }
  } catch (e) {}
}
---

<MainLayout 
  title={`${title} - Fajri Awwaluddin`}
  description={summary}
  image={image}
>
  <article class="max-w-[1400px] mx-auto py-24 px-6 md:px-8">


    <div class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="bg-[#2a85ff] text-white text-[12px] font-bold px-3 py-1 rounded-[4px] tracking-wider">
          {category}
        </span>
        <span class="text-slate-400 dark:text-slate-500 text-sm font-bold">{date}</span>
      </div>
      <h1 class="text-[36px] md:text-[48px] font-extrabold text-slate-900 dark:text-white leading-[1.1] tracking-tight">{title}</h1>
      <p class="text-xl text-slate-500 dark:text-neutral-400 font-medium mt-6 leading-relaxed">{summary}</p>
    </div>

    {image && (
      <div class="w-full h-[300px] md:h-[500px] rounded-[2rem] overflow-hidden mb-12 neu-flat border-none p-3">
        <img src={image} alt={title} class="w-full h-full object-cover rounded-2xl" loading="lazy" decoding="async" />
      </div>
    )}

    <div class="prose prose-lg md:prose-xl prose-slate dark:prose-invert prose-a:text-[#E9582A] hover:prose-a:text-[#d04a1f] max-w-none prose-img:rounded-3xl prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-slate-900 dark:prose-headings:text-white" set:html={Content}>
    </div>
  </article>
</MainLayout>
