---
export const prerender = true;

import { getCollection, render } from '../../firebase/content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article || {});

const title = article?.data?.title || 'Article';
const summary = article?.data?.summary || '';
const category = article?.data?.category || 'General';
const date = article?.data?.date || '';
const image = article?.data?.image || (article?.data?.photos && article?.data?.photos.length > 0 ? article?.data?.photos[0] : undefined);
---

<MainLayout 
  title={`${title} - Fajri Awwaluddin`}
  description={summary}
  image={image}
>
  <article class="max-w-[1400px] mx-auto py-24 px-6 md:px-8">
    <a href="/articles" class="inline-flex items-center gap-2 text-slate-500 dark:text-neutral-400 hover:text-[#E9582A] dark:hover:text-[#E9582A] font-bold text-sm mb-8 transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      Back to Articles
    </a>

    <div class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="bg-[#2a85ff] text-white text-[12px] font-bold px-3 py-1 rounded-[4px] tracking-wider">
          {category}
        </span>
        <span class="text-slate-400 dark:text-slate-500 text-sm font-bold">{date}</span>
      </div>
      <h1 class="text-[36px] md:text-[48px] font-extrabold text-slate-900 dark:text-white leading-[1.1] tracking-tight">{title}</h1>
      <p class="text-xl text-slate-500 dark:text-neutral-400 font-medium mt-6 leading-relaxed">{summary}</p>
    </div>

    {image && (
      <div class="w-full h-[300px] md:h-[500px] rounded-[2rem] overflow-hidden mb-12 neu-flat border-none p-3">
        <img src={image} alt={title} class="w-full h-full object-cover rounded-2xl" loading="lazy" decoding="async" />
      </div>
    )}

    <div class="prose prose-lg md:prose-xl prose-slate dark:prose-invert prose-a:text-[#E9582A] hover:prose-a:text-[#d04a1f] max-w-none prose-img:rounded-3xl prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-slate-900 dark:prose-headings:text-white" set:html={Content}>
    </div>
  </article>
</MainLayout>
