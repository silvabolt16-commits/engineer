---
export const prerender = false;

import { marked } from 'marked';
import { getDB, getBySlugFromTable } from '../../lib/d1';
import MainLayout from '../../layouts/MainLayout.astro';

const { slug } = Astro.params;
const db = getDB(Astro.locals);
const achievement = await getBySlugFromTable(db, 'achievements', slug as string);

if (!achievement) {
  return Astro.redirect('/#achievements');
}

const Content = marked.parse(achievement.body || '');

const title = achievement.title || 'Achievement';
const issuer = achievement.issuer || '';
let date = achievement.date || '';
const description = achievement.description || '';

if (date && date.includes('|')) {
  const [start, end] = date.split('|');
  const formatDate = (dateStr: string) => {
    if (dateStr === 'present') return 'Sekarang';
    if (!dateStr) return '';
    try {
      const [year, month] = dateStr.split('-');
      if (!year || !month) return dateStr;
      const d = new Date(parseInt(year), parseInt(month) - 1);
      return d.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
    } catch (e) {
      return dateStr;
    }
  };
  const formattedStart = formatDate(start);
  const formattedEnd = formatDate(end);
  if (formattedStart && formattedEnd) {
    date = `${formattedStart} - ${formattedEnd}`;
  } else {
    date = formattedStart || formattedEnd || date;
  }
} else if (date) {
  try {
    const [year, month] = date.split('-');
    if (year && month) {
      const d = new Date(parseInt(year), parseInt(month) - 1);
      date = d.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
    }
  } catch (e) {}
}
---

<MainLayout 
  title={`${title} - Fajri Awwaluddin`}
  description={description}
>
  <!-- Article Header -->
  <div class="max-w-[1400px] mx-auto px-6 md:px-8 pt-16 md:pt-20 pb-6 md:pb-8">
    <div class="inline-block text-[#E9582A] font-extrabold tracking-widest uppercase mb-4 text-sm bg-[#E9582A]/10 px-4 py-2 rounded-lg">
      {date}
    </div>
    <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.1] mb-6">{title}</h1>
    <p class="text-xl md:text-2xl text-slate-500 dark:text-neutral-400 font-medium mb-12">{issuer}</p>

    <!-- Hero Image placeholder -->
    {achievement.image && achievement.image.startsWith('http') ? (
      <div class="w-full rounded-[2rem] overflow-hidden mb-8 md:mb-10 shadow-xl border-4 border-white dark:border-slate-800 relative group">
        <img src={achievement.image} class="w-full h-auto object-cover" alt={title} />
      </div>
    ) : (
      <div class="w-full rounded-[2rem] overflow-hidden neu-flat border-none flex items-center justify-center py-10 md:py-6 md:py-8 mb-8 md:mb-10 relative">
        <div class="text-center text-slate-400 dark:text-neutral-600 relative z-10">
          <svg class="w-20 h-20 mx-auto mb-6 text-[#E9582A] opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
          <p class="font-bold text-lg tracking-wide uppercase text-slate-500 dark:text-neutral-400">Dokumentasi Penghargaan</p>
        </div>
      </div>
    )}
  </div>

  <!-- Content Section -->
  <div class="max-w-[1400px] mx-auto px-6 md:px-8 pb-24">
    <div class="prose prose-lg md:prose-xl prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-neutral-300 leading-relaxed prose-a:text-[#E9582A] hover:prose-a:text-[#d04a1f]">
      <p>{description}</p>
      {Content && <div set:html={Content} />}
    </div>

    <!-- Back button -->
    <div class="mt-20 pt-8 border-t border-slate-200 dark:border-white/10">
      <a href="/#achievements" class="inline-flex items-center gap-2 text-slate-500 dark:text-neutral-400 hover:text-[#E9582A] dark:hover:text-[#E9582A] font-bold transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Kembali ke Beranda
      </a>
    </div>
  </div>
</MainLayout>
