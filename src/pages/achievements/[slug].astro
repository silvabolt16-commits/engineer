---
import MainLayout from '../../layouts/MainLayout.astro';
import { achievements } from '../../data/portfolio.ts';

export function getStaticPaths() {
  return achievements.map((achievement) => ({
    params: { slug: achievement.slug },
    props: { achievement },
  }));
}

const { achievement } = Astro.props;
---

<MainLayout title={`${achievement.title} - Fajri Awwaluddin`}>
  <!-- Article Header -->
  <div class="max-w-[800px] mx-auto px-8 pt-32 pb-12 text-center">
    <div class="inline-block text-orange-500 font-extrabold tracking-widest uppercase mb-4 text-sm bg-orange-50 px-3 py-1 rounded-full">
      {achievement.date}
    </div>
    <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">{achievement.title}</h1>
    <p class="text-xl text-slate-500 font-medium mb-8">{achievement.issuer}</p>
    
    <!-- Hero Image placeholder -->
    <div class="w-full rounded-2xl overflow-hidden shadow-xl border border-slate-200 bg-slate-900 flex items-center justify-center p-12 relative">
      <div class="absolute inset-0 bg-gradient-to-tr from-orange-500/20 to-blue-500/20 mix-blend-overlay"></div>
      <div class="text-center text-slate-400 relative z-10">
        <svg class="w-20 h-20 mx-auto mb-4 text-orange-400/80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
        <p class="font-medium text-white/80">Dokumentasi Penghargaan</p>
      </div>
    </div>
  </div>

  <!-- Content Section -->
  <div class="max-w-[700px] mx-auto px-8 pb-24">
    <div class="prose prose-lg prose-slate max-w-none text-slate-700 leading-loose text-justify">
      <p>{achievement.description}</p>
    </div>
    
    <!-- Back button -->
    <div class="mt-16 pt-8 border-t border-slate-200 text-center">
      <a href="/#achievements" class="inline-flex items-center gap-2 text-slate-500 hover:text-[#E9582A] font-bold transition-colors">
        <span class="text-xl">&larr;</span> Kembali ke Beranda
      </a>
    </div>
  </div>
</MainLayout>
