---
export const prerender = true;

import { getCollection, render } from '../../firebase/content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const achievements = await getCollection('achievements');
  return achievements.map((achievement) => ({
    params: { slug: achievement.id },
    props: { achievement },
  }));
}

const { achievement } = Astro.props;
const { Content } = await render(achievement || {});

const title = achievement?.data?.title || 'Achievement';
const issuer = achievement?.data?.issuer || '';
const date = achievement?.data?.date || '';
const description = achievement?.data?.description || '';
---

<MainLayout 
  title={`${title} - Fajri Awwaluddin`}
  description={description}
>
  <!-- Article Header -->
  <div class="max-w-[1400px] mx-auto px-6 md:px-8 pt-32 pb-12">
    <div class="inline-block text-[#E9582A] font-extrabold tracking-widest uppercase mb-4 text-sm bg-[#E9582A]/10 px-4 py-2 rounded-lg">
      {date}
    </div>
    <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.1] mb-6">{title}</h1>
    <p class="text-xl md:text-2xl text-slate-500 dark:text-neutral-400 font-medium mb-12">{issuer}</p>

    <!-- Hero Image placeholder -->
    <div class="w-full rounded-[2rem] overflow-hidden neu-flat border-none flex items-center justify-center py-24 mb-16 relative">
      <div class="text-center text-slate-400 dark:text-neutral-600 relative z-10">
        <svg class="w-20 h-20 mx-auto mb-6 text-[#E9582A] opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
        <p class="font-bold text-lg tracking-wide uppercase text-slate-500 dark:text-neutral-400">Dokumentasi Penghargaan</p>
      </div>
    </div>
  </div>

  <!-- Content Section -->
  <div class="max-w-[1400px] mx-auto px-6 md:px-8 pb-24">
    <div class="prose prose-lg md:prose-xl prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-neutral-300 leading-relaxed prose-a:text-[#E9582A] hover:prose-a:text-[#d04a1f]">
      <p>{description}</p>
      {Content && <div set:html={Content} />}
    </div>

    <!-- Back button -->
    <div class="mt-20 pt-8 border-t border-slate-200 dark:border-white/10">
      <a href="/#achievements" class="inline-flex items-center gap-2 text-slate-500 dark:text-neutral-400 hover:text-[#E9582A] dark:hover:text-[#E9582A] font-bold transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Kembali ke Beranda
      </a>
    </div>
  </div>
</MainLayout>
