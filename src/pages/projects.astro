---
import { getDB, getAllProjects } from '../lib/d1';
import MainLayout from '../layouts/MainLayout.astro';

const db = getDB(Astro.locals);
const projects = await getAllProjects(db);

function formatDuration(durationStr: string) {
  if (!durationStr || !durationStr.includes('|')) return durationStr;
  const [start, end] = durationStr.split('|');
  const formatDate = (dateStr: string) => {
    if (dateStr === 'present') return 'Sekarang';
    if (!dateStr) return '';
    try {
      const [year, month] = dateStr.split('-');
      if (!year || !month) return dateStr;
      const date = new Date(parseInt(year), parseInt(month) - 1);
      return date.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
    } catch (e) {
      return dateStr;
    }
  };
  
  const formattedStart = formatDate(start);
  const formattedEnd = formatDate(end);
  if (!formattedEnd) return formattedStart;
  if (!formattedStart) return formattedEnd;
  return `${formattedStart} - ${formattedEnd}`;
}
---

<MainLayout title="Projects - Fajri Awwaluddin">
  <section class="py-10 md:py-6 md:py-8 max-w-[1400px] mx-auto px-8">
    <div class="mb-8 md:mb-10 text-center max-w-2xl mx-auto">
      <h1 class="text-[36px] md:text-[44px] font-extrabold text-slate-900 dark:text-white mb-4 tracking-tight">Projects</h1>
      <p class="text-slate-500 dark:text-neutral-400 font-medium text-lg">Technical works, research, and systems built.</p>
    </div>

    <!-- Grid (Project List) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 pb-24">
      {projects.map((project) => (
        <a href={`/projects/${project.slug}`} class="group neu-flat border-none p-4 rounded-3xl block h-full">
          <!-- Cover Image -->
          <div class="w-full h-[240px] relative overflow-hidden bg-slate-200 dark:bg-[#222] rounded-2xl mb-4">
            {project.image_url ? (
              <img src={project.image_url} alt={project.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-slate-100 dark:bg-slate-800 text-slate-400">
                <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2-2v12a2 2 0 002 2z" /></svg>
              </div>
            )}
          </div>

          <!-- Text Section -->
          <div class="px-2 pb-2">
            <div class="flex items-center gap-3 mb-3">
              <span class="inline-block px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[11px] font-bold tracking-widest uppercase rounded-full">{project.category}</span>
              {project.date && <span class="text-[11px] font-bold text-slate-400 dark:text-neutral-500">{formatDuration(project.date)}</span>}
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 leading-tight group-hover:text-[#E9582A] transition-colors">{project.title}</h3>
            <p class="text-sm text-slate-500 dark:text-neutral-400 font-medium line-clamp-2 mb-6">{project.description}</p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 mb-6">
              {Array.isArray(project.tags) ? project.tags.map((tag: string) => (
                <span class="neu-flat border-none text-slate-700 dark:text-neutral-300 text-[11px] font-bold px-2 py-1 rounded-md">{tag}</span>
              )) : (typeof project.tags === 'string' ? project.tags.split(',').map((t: string) => (
                <span class="neu-flat border-none text-slate-700 dark:text-neutral-300 text-[11px] font-bold px-2 py-1 rounded-md">{t.trim()}</span>
              )) : null)}
            </div>

            <div class="text-[13px] font-bold text-[#E9582A] flex items-center gap-1 uppercase tracking-widest mt-auto">
              View Project <span class="text-lg leading-none transition-transform group-hover/card:translate-x-1">&rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</MainLayout>
