---
export const prerender = false;

import { marked } from 'marked';
import { getDB, getBySlugFromTable } from '../../lib/d1';
import MainLayout from '../../layouts/MainLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { slug } = Astro.params;
const db = getDB(Astro.locals);
const cert = await getBySlugFromTable(db, 'certificates', slug as string);

if (!cert) {
  return Astro.redirect('/#certificates');
}

const Content = marked.parse((lang === 'en' && cert.body_en ? cert.body_en : cert.body) || '');

const title = (lang === 'en' && cert.title_en ? cert.title_en : cert.title) || 'Certificate';
const issuer = (lang === 'en' && cert.issuer_en ? cert.issuer_en : cert.issuer) || '';
let date = (lang === 'en' && cert.date_en ? cert.date_en : cert.date) || '';
const description = (lang === 'en' && cert.description_en ? cert.description_en : cert.description) || '';

if (date && date.includes('|')) {
  const [start, end] = date.split('|');
  const formatDate = (dateStr: string) => {
    if (dateStr === 'present') return 'Sekarang';
    if (!dateStr) return '';
    try {
      const [year, month] = dateStr.split('-');
      if (!year || !month) return dateStr.replace('Jan', 'Januari').replace('Feb', 'Februari').replace('Mar', 'Maret').replace('Apr', 'April').replace('May', 'Mei').replace('Jun', 'Juni').replace('Jul', 'Juli').replace('Aug', 'Agustus').replace('Sep', 'September').replace('Oct', 'Oktober').replace('Nov', 'November').replace('Dec', 'Desember');
      const d = new Date(parseInt(year), parseInt(month) - 1);
      return d.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
    } catch (e) {
      return dateStr.replace('Jan', 'Januari').replace('Feb', 'Februari').replace('Mar', 'Maret').replace('Apr', 'April').replace('May', 'Mei').replace('Jun', 'Juni').replace('Jul', 'Juli').replace('Aug', 'Agustus').replace('Sep', 'September').replace('Oct', 'Oktober').replace('Nov', 'November').replace('Dec', 'Desember');
    }
  };
  const formattedStart = formatDate(start);
  const formattedEnd = formatDate(end);
  if (formattedStart && formattedEnd) {
    date = `${formattedStart} - ${formattedEnd}`;
  } else {
    date = formattedStart || formattedEnd || date;
  }
} else if (date) {
  date = date.replace('Jan', 'Januari').replace('Feb', 'Februari').replace('Mar', 'Maret')
      .replace('Apr', 'April').replace('May', 'Mei').replace('Jun', 'Juni').replace('Jul', 'Juli')
      .replace('Aug', 'Agustus').replace('Sep', 'September').replace('Oct', 'Oktober')
      .replace('Nov', 'November').replace('Dec', 'Desember');
  try {
    const [year, month] = date.split('-');
    if (year && month) {
      const d = new Date(parseInt(year), parseInt(month) - 1);
      date = d.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
    }
  } catch (e) {}
}
---

<MainLayout 
  title={`${title} - Fajri Awwaluddin`}
  description={description}
>
  <!-- Article Header -->
  <div class="max-w-[1400px] mx-auto px-6 md:px-8 pt-6 md:pt-10 pb-6 md:pb-8">
    <div class="inline-block text-[#10b981] font-extrabold tracking-widest uppercase mb-4 text-sm bg-[#10b981]/10 px-4 py-2 rounded-lg">
      {date}
    </div>
    <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.1] mb-6">{title}</h1>
    <p class="text-xl md:text-2xl text-slate-500 dark:text-neutral-400 font-medium mb-12">{issuer}</p>

    <!-- Hero Image / Certificate Photo -->
    {cert.link && cert.link.startsWith('http') ? (
      <div class="w-full rounded-[2rem] overflow-hidden mb-8 md:mb-10 shadow-xl border-4 border-white dark:border-slate-800 relative group">
        <img src={cert.link} class="w-full h-auto object-cover" alt={title} />
      </div>
    ) : (
      <div class="w-full rounded-[2rem] overflow-hidden neu-flat border-none flex items-center justify-center pt-6 pb-10 md:pt-10 md:pb-16 mb-8 md:mb-10">
        <div class="text-center text-slate-400 dark:text-neutral-600">
          <svg class="w-20 h-20 mx-auto mb-6 opacity-50 text-[#10b981]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <p class="font-bold text-lg tracking-wide uppercase">{lang === 'en' ? 'Official Certificate / Supporting Document' : 'Sertifikat Resmi / Dokumen Pendukung'}</p>
        </div>
      </div>
    )}
  </div>

  <!-- Content Section -->
  <div class="max-w-[1400px] mx-auto px-6 md:px-8 pb-24">
    <div class="prose prose-lg md:prose-xl prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-neutral-300 leading-relaxed prose-a:text-[#E9582A] hover:prose-a:text-[#d04a1f]">
      <p>{description}</p>
      {Content && <div set:html={Content} />}
    </div>

    <!-- Back button -->
    <div class="mt-20 pt-8 border-t border-slate-200 dark:border-white/10">
      <a href="/#sertifikat" class="inline-flex items-center gap-2 text-slate-500 dark:text-neutral-400 hover:text-[#E9582A] dark:hover:text-[#E9582A] font-bold transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        {lang === 'en' ? 'Back to Home' : 'Kembali ke Beranda'}
      </a>
    </div>
  </div>
</MainLayout>
