---
export const prerender = false;

import { marked } from 'marked';
import { getDB, getBySlugFromTable } from '../../lib/d1';
import MainLayout from '../../layouts/MainLayout.astro';

const { slug } = Astro.params;
const db = getDB(Astro.locals);
const exp = await getBySlugFromTable(db, 'experiences', slug as string);

if (!exp) {
  return Astro.redirect('/#experience');
}

const Content = marked.parse(exp.body || '');

const rawPhotos = exp.photos;
let photos: string[] = [];
try {
  photos = typeof rawPhotos === 'string' ? JSON.parse(rawPhotos) : (rawPhotos || []);
} catch(e) {}

const rawDetails = exp.details;
let details: string[] = [];
try {
  details = typeof rawDetails === 'string' ? JSON.parse(rawDetails) : (rawDetails || []);
} catch(e) {}

const title = exp.title || 'Experience';
const company = exp.company || '';
let duration = exp.duration || '';

if (duration && duration.includes('|')) {
  const [start, end] = duration.split('|');
  const formatDate = (dateStr: string) => {
    if (dateStr === 'present') return 'Sekarang';
    if (!dateStr) return '';
    try {
      const [year, month] = dateStr.split('-');
      const date = new Date(parseInt(year), parseInt(month) - 1);
      return date.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
    } catch (e) {
      return dateStr;
    }
  };
  duration = `${formatDate(start)} - ${formatDate(end)}`;
}
---

<MainLayout 
  title={`${title} - Fajri Awwaluddin`}
  description={`Experience as ${title} at ${company}`}
  image={photos.length > 0 ? photos[0] : undefined}
>
  <!-- Header Section -->
  <div class="pt-16 md:pt-20 pb-6 md:pb-8 px-6 md:px-8">
    <div class="max-w-[1400px] mx-auto">
      <div class="inline-block bg-[#E9582A] shadow-md text-white text-[12px] font-bold px-3 py-1.5 rounded-[4px] tracking-widest uppercase mb-6 border-none">
        {duration}
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold tracking-tight mb-4 text-slate-900 dark:text-white leading-[1.1]">{title}</h1>
      <p class="text-xl md:text-2xl text-slate-500 dark:text-neutral-400 font-medium mb-8">{company}</p>
    </div>
  </div>

  <!-- Content Section -->
  <div class="max-w-[1400px] mx-auto px-6 md:px-8 py-6 md:py-8 mb-8 md:mb-10">
    <!-- Main Content -->
    <div class="mb-8 md:mb-10">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6 border-b border-slate-200 dark:border-white/10 pb-4">Job Description</h2>
      <div class="prose prose-lg md:prose-xl prose-slate dark:prose-invert max-w-none mb-12 text-slate-600 dark:text-neutral-400 leading-relaxed prose-a:text-[#E9582A] hover:prose-a:text-[#d04a1f] prose-img:rounded-3xl prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-slate-900 dark:prose-headings:text-white" set:html={Content}>
      </div>
    </div>

    <!-- Photo Documentation Gallery -->
    {photos.length > 0 && (
      <div>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-8 border-b border-slate-200 dark:border-white/10 pb-4">Photo Documentation</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {photos.map((photo: string) => (
            <div class="neu-flat border-none p-3 rounded-[2rem] overflow-hidden transition-all duration-300 hover:-translate-y-2">
              <img src={photo} alt={`Documentation ${title}`} class="w-full h-auto object-cover rounded-3xl hover:scale-105 transition-transform duration-700" loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      </div>
    )}
  </div>


</MainLayout>
