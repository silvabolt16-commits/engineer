---
export const prerender = false;

import { marked } from 'marked';
import { getDB, getProjectBySlug } from '../../lib/d1';
import MainLayout from '../../layouts/MainLayout.astro';

const { slug } = Astro.params;
const db = getDB(Astro.locals);
const project = await getProjectBySlug(db, slug as string);

if (!project) {
  return Astro.redirect('/#projects');
}

const Content = marked.parse(project.content || '');

const photos = project.image_url ? [project.image_url] : [];
const tags = project.tags ? project.tags.split(',').map((t: string) => t.trim()) : [];
const title = project.title || 'Project';
const description = project.description || '';
const tech = project.category || 'Engineering';
let date = project.date || '';
const link = project.repo_url || project.demo_url || '#';

if (date && date.includes('|')) {
  const [start, end] = date.split('|');
  const formatDate = (dateStr: string) => {
    if (dateStr === 'present') return 'Sekarang';
    if (!dateStr) return '';
    try {
      const [year, month] = dateStr.split('-');
      if (!year || !month) return dateStr;
      const d = new Date(parseInt(year), parseInt(month) - 1);
      return d.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
    } catch (e) {
      return dateStr;
    }
  };
  const formattedStart = formatDate(start);
  const formattedEnd = formatDate(end);
  if (formattedStart && formattedEnd) {
    date = `${formattedStart} - ${formattedEnd}`;
  } else {
    date = formattedStart || formattedEnd || date;
  }
}
---

<MainLayout 
  title={`${title} - Fajri Awwaluddin`}
  description={description}
  image={photos.length > 0 ? photos[0] : undefined}
>
  <!-- Header Section -->
  <div class="pt-6 md:pt-10 pb-6 md:pb-8 px-6 md:px-8">
    <div class="max-w-[1400px] mx-auto">
      <div class="inline-flex flex-wrap items-center gap-3 mb-6">
        <div class="inline-block bg-[#E9582A] shadow-md text-white text-[12px] font-bold px-3 py-1.5 rounded-[4px] tracking-widest uppercase border-none">
          {tech}
        </div>
        {date && (
          <div class="inline-block bg-[#E9582A]/10 text-[#E9582A] text-[12px] font-bold px-3 py-1.5 rounded-[4px] tracking-widest uppercase">
            {date}
          </div>
        )}
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold tracking-tight mb-4 text-slate-900 dark:text-white leading-[1.1]">{title}</h1>
      <p class="text-xl md:text-2xl text-slate-500 dark:text-neutral-400 font-medium mb-8 max-w-3xl leading-relaxed">{description}</p>

      <div class="flex gap-3 flex-wrap">
        {tags.map((tag: string) => (
          <span class="text-[13px] font-bold text-slate-700 dark:text-neutral-300 neu-flat px-3 py-1 rounded-full border-none">{tag}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- Content Section -->
  <div class="max-w-[1400px] mx-auto px-6 md:px-8 pt-6 pb-6 md:pt-10 md:pb-8 mb-8 md:mb-10">

    <!-- Hero Image / Main Photo -->
    {photos.length > 0 && (
      <div class="w-full rounded-3xl overflow-hidden neu-flat border-none mb-8 md:mb-10 p-3">
        <img src={photos[0]} alt={title} class="w-full h-auto max-h-[600px] object-cover rounded-2xl" loading="lazy" decoding="async" />
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 lg:gap-16">
      <!-- Main Content -->
      <div class="md:col-span-3">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6 border-b border-slate-200 dark:border-white/10 pb-4">About Project</h2>
        <div class="prose prose-lg md:prose-xl prose-slate dark:prose-invert max-w-none text-slate-600 dark:text-neutral-400 leading-relaxed prose-a:text-[#E9582A] hover:prose-a:text-[#d04a1f] prose-img:rounded-3xl prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-slate-900 dark:prose-headings:text-white" set:html={Content}>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="md:col-span-1">
        <div class="neu-flat border-none p-8 rounded-3xl sticky top-32">
          <h3 class="text-[12px] font-bold text-slate-400 dark:text-neutral-500 mb-6 uppercase tracking-widest border-b border-slate-200 dark:border-white/10 pb-4">Project Links</h3>
          <a href={link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-full neu-flat neu-flat-hover text-[#1b85ff] dark:text-[#60a5fa] font-bold py-3 px-4 rounded-xl transition-all border-none h-12">
            View Repository
          </a>
        </div>
      </div>
    </div>

  </div>


</MainLayout>
