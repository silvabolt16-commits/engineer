---
export const prerender = true;

import { getCollection, render } from '../../firebase/content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project || {});

const rawPhotos = project?.data?.photos;
const photos = Array.isArray(rawPhotos) ? rawPhotos : (typeof rawPhotos === 'string' ? [rawPhotos] : []);
const rawTags = project?.data?.tags;
const tags = Array.isArray(rawTags) ? rawTags : (typeof rawTags === 'string' ? rawTags.split(',').map((t: string) => t.trim()) : []);
const title = project?.data?.title || 'Project';
const description = project?.data?.description || '';
const tech = project?.data?.tech || 'Engineering';
const link = project?.data?.link || '#';
---

<MainLayout 
  title={`${title} - Fajri Awwaluddin`}
  description={description}
  image={photos.length > 0 ? photos[0] : undefined}
>
  <!-- Header Section -->
  <div class="pt-32 pb-12 px-6 md:px-8">
    <div class="max-w-[1400px] mx-auto">
      <div class="inline-block bg-[#E9582A] shadow-md text-white text-[12px] font-bold px-3 py-1.5 rounded-[4px] tracking-widest uppercase mb-6 border-none">
        {tech}
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold tracking-tight mb-4 text-slate-900 dark:text-white leading-[1.1]">{title}</h1>
      <p class="text-xl md:text-2xl text-slate-500 dark:text-neutral-400 font-medium mb-8 max-w-3xl leading-relaxed">{description}</p>

      <div class="flex gap-3 flex-wrap">
        {tags.map((tag: string) => (
          <span class="text-[13px] font-bold text-slate-700 dark:text-neutral-300 neu-flat px-3 py-1 rounded-full border-none">{tag}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- Content Section -->
  <div class="max-w-[1400px] mx-auto px-6 md:px-8 py-12 mb-16">

    <!-- Hero Image / Main Photo -->
    {photos.length > 0 && (
      <div class="w-full rounded-3xl overflow-hidden neu-flat border-none mb-16 p-3">
        <img src={photos[0]} alt={title} class="w-full h-auto max-h-[600px] object-cover rounded-2xl" loading="lazy" decoding="async" />
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 lg:gap-16">
      <!-- Main Content -->
      <div class="md:col-span-3">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6 border-b border-slate-200 dark:border-white/10 pb-4">About Project</h2>
        <div class="prose prose-lg md:prose-xl prose-slate dark:prose-invert max-w-none text-slate-600 dark:text-neutral-400 leading-relaxed prose-a:text-[#E9582A] hover:prose-a:text-[#d04a1f] prose-img:rounded-3xl prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-slate-900 dark:prose-headings:text-white" set:html={Content}>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="md:col-span-1">
        <div class="neu-flat border-none p-8 rounded-3xl sticky top-32">
          <h3 class="text-[12px] font-bold text-slate-400 dark:text-neutral-500 mb-6 uppercase tracking-widest border-b border-slate-200 dark:border-white/10 pb-4">Project Links</h3>
          <a href={link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-full neu-flat neu-flat-hover text-[#1b85ff] dark:text-[#60a5fa] font-bold py-3 px-4 rounded-xl transition-all border-none h-12">
            View Repository
          </a>
        </div>
      </div>
    </div>

  </div>

  <!-- Back button -->
  <section class="py-12 max-w-[1400px] mx-auto px-6 md:px-8 relative mb-16">
    <a href="/projects" class="inline-flex items-center gap-2 text-slate-500 dark:text-neutral-400 hover:text-[#E9582A] dark:hover:text-[#E9582A] font-bold text-sm mb-8 transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      Back to Projects
    </a>
  </section>
</MainLayout>
