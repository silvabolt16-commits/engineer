---
import MainLayout from '../layouts/MainLayout.astro';
import { getDB, getAllProjects, getProfile, getAllFromTable } from '../lib/d1';

const db = getDB(Astro.locals);
const profileData = await getProfile(db) || {};
const profile = { ...profileData, phone: profileData.phone || '' }; // Ensure default properties

let experiences: any[] = await getAllFromTable(db, 'experiences') || [];
let certificates: any[] = await getAllFromTable(db, 'certificates') || [];
let achievements: any[] = await getAllFromTable(db, 'achievements') || [];
let articles: any[] = await getAllFromTable(db, 'articles') || [];
let skills: any[] = await getAllFromTable(db, 'skills') || [];
let d1Projects: any[] = await getAllProjects(db) || [];

// Map D1 data structure to match previous structure expected by UI components
experiences = experiences.map(exp => ({
  id: exp.slug,
  data: {
    title: exp.title,
    company: exp.company,
    duration: exp.duration,
    description: exp.body, // Use body as description in list
    photos: JSON.parse(exp.photos || '[]')
  },
  body: exp.body
})).sort((a, b) => parseInt(b.data.duration) - parseInt(a.data.duration));

certificates = certificates.map(cert => ({
  id: cert.slug,
  data: { ...cert }
}));

achievements = achievements.map(ach => ({
  id: ach.slug,
  data: { ...ach }
}));

articles = articles.map(art => ({
  id: art.slug,
  data: { ...art }
}));

if (!skills || skills.length === 0) {
  skills = profile.skills || [];
} else {
  skills = skills.map((s: any) => ({
    category: s.category,
    items: typeof s.items === 'string' ? JSON.parse(s.items || '[]') : s.items
  }));
}


let projects = d1Projects.length > 0
  ? d1Projects.map(p => ({
      id: p.slug || String(p.id),
      data: {
        title: p.title,
        description: p.description,
        tech: p.category || 'Web',
        photos: p.image_url ? [p.image_url] : [],
        tags: p.tags ? p.tags.split(',') : [],
      }
    }))
  : [];

// Gandakan 4 kali agar efek infinite scroll (marquee) mulus di layar ultra-wide
const marqueeProjects = [...projects, ...projects, ...projects, ...projects];

// Warna & ikon kategori skill di-cycle per index (data kategorinya sendiri dari profile.json)
const skillStyles = [
  { bg: 'bg-blue-100 dark:bg-blue-900/30', text: 'text-blue-600 dark:text-blue-400', tagHover: 'hover:border-blue-300 dark:hover:border-blue-500/50 hover:text-blue-600 dark:hover:text-blue-400', d: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { bg: 'bg-orange-100 dark:bg-[#E9582A]/20', text: 'text-[#E9582A] dark:text-[#E9582A]', tagHover: 'hover:border-[#E9582A]/50 hover:text-[#E9582A]', d: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { bg: 'bg-emerald-100 dark:bg-emerald-900/30', text: 'text-emerald-600 dark:text-emerald-400', tagHover: 'hover:border-emerald-300 dark:hover:border-emerald-500/50 hover:text-emerald-600 dark:hover:text-emerald-400', d: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
];
---


<MainLayout title="Fajri Awwaluddin">
  <!-- 1. Hero Section -->
  <section class="pt-6 pb-12 md:pt-24 md:pb-16 flex flex-col lg:flex-row items-center justify-between gap-12 w-full max-w-[1400px] mx-auto px-4 sm:px-8 overflow-hidden">
    <!-- Left Column (Text & CTA) -->
    <div class="w-full flex-1 max-w-[650px] text-left reveal-left">
      <!-- Top Badge -->
      <div class="inline-flex items-center gap-2 sm:gap-3 px-1 py-1 pr-3 sm:pr-4 rounded-full neu-pressed border-none mb-8 max-w-full overflow-hidden">
        <span class="bg-[#E9582A] text-white text-[10px] sm:text-[11px] font-bold px-2 sm:px-3 py-1 rounded-full tracking-wide shadow-md shrink-0">
          {profile.heroBadge}
        </span>
        <span class="text-[#00609c] dark:text-[#E9582A] text-[12px] sm:text-[15px] font-semibold truncate shrink">
          {profile.tagline}
        </span>
      </div>
      
      <!-- Heading -->
      <h1 class="text-[2rem] sm:text-[2.8rem] md:text-[3.5rem] lg:text-[4rem] font-extrabold tracking-tight text-[#0f172a] dark:text-white leading-[1.05] mb-6">
        <span class="text-[#E9582A] break-words">{profile.name}</span><br/>
        <span class="text-[1.35rem] sm:text-[1.8rem] md:text-[2.2rem] lg:text-[2.5rem] text-slate-600 dark:text-slate-300 mt-2 md:mt-3 block whitespace-normal">
          {profile.role}
        </span>
      </h1>

      <!-- Subheading -->
      <p class="text-[16px] md:text-[18px] text-[#475569] dark:text-neutral-300 max-w-[700px] leading-[1.7] mb-10 font-medium">
        {profile.bio}
      </p>
      
      <!-- Contact Links -->
      <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 mt-8">
        <!-- WhatsApp -->
        <a href={`https://wa.me/${profile.phone.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-full neu-flat neu-flat-hover border-none flex items-center justify-center text-slate-500 dark:text-neutral-400 hover:text-[#25D366] dark:hover:text-[#25D366] transition-all duration-300" aria-label="WhatsApp" title="WhatsApp">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 0C5.385 0 0 5.385 0 12.031c0 2.115.549 4.17 1.593 6L.045 24l6.115-1.603c1.765.98 3.766 1.5 5.871 1.5 6.646 0 12.031-5.385 12.031-12.031S18.677 0 12.031 0zm0 21.905c-1.815 0-3.593-.487-5.15-1.408l-.369-.219-3.832 1.004 1.025-3.738-.241-.383C2.518 15.656 2.025 13.882 2.025 12c0-5.513 4.487-10 10-10s10 4.487 10 10-4.487 10-10 10zm5.495-7.518c-.301-.151-1.782-.881-2.058-.981-.275-.101-.476-.151-.677.151-.201.301-.777.981-.953 1.182-.175.201-.351.226-.652.075-2.224-1.116-3.835-2.923-4.577-3.811-.175-.201.127-.234.426-.683.151-.226.301-.452.451-.678.151-.226.226-.376.126-.677-.101-.301-.677-1.632-.927-2.234-.241-.579-.485-.501-.677-.511-.175-.01-.376-.01-.577-.01-.201 0-.526.075-.802.376-.276.301-1.053 1.029-1.053 2.509s1.078 2.909 1.228 3.11c.151.201 2.115 3.23 5.123 4.53 2.001.865 2.766.936 3.734.783.921-.144 2.825-1.155 3.226-2.271.401-1.116.401-2.07.275-2.271-.125-.201-.476-.301-.777-.452z"/></svg>
        </a>
        <!-- LinkedIn -->
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-full neu-flat neu-flat-hover border-none flex items-center justify-center text-slate-500 dark:text-neutral-400 hover:text-[#0A66C2] dark:hover:text-[#0A66C2] transition-all duration-300" aria-label="LinkedIn" title="LinkedIn">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <!-- Email -->
        <a href={`mailto:${profile.email}`} class="w-12 h-12 rounded-full neu-flat neu-flat-hover border-none flex items-center justify-center text-slate-500 dark:text-neutral-400 hover:text-[#E9582A] dark:hover:text-[#E9582A] transition-all duration-300" aria-label="Email" title="Email">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        </a>
        <!-- Location (Text) -->
        <div class="flex items-center gap-2 px-4 py-2 ml-2 rounded-full neu-pressed border-none text-slate-600 dark:text-neutral-300 text-sm md:text-[15px] font-medium">
          <svg class="w-5 h-5 text-slate-400 dark:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          {profile.location}
        </div>
      </div>
    </div>
    
    <!-- Right Column (Image/Illustration) -->
    <div class="flex-1 flex justify-center lg:justify-end relative mt-12 lg:mt-0 reveal-right">
      <!-- Profile Picture Container -->
      <div class="relative w-full max-w-[380px] mx-auto lg:mr-8 mt-4 group">
        <!-- Main Image Card -->
        <div class="relative neu-flat p-3 rounded-full transform group-hover:-translate-y-2 group-hover:rotate-1 transition-all duration-500 ease-out">
          <div class="relative rounded-full overflow-hidden bg-[#E9582A]">
            <img
              src={profile.avatar}
              alt={profile.name}
              class="w-full h-auto aspect-square object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <!-- Inner overlay gradient for depth -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent pointer-events-none"></div>
          </div>
          
          <!-- Decorative Floating Status Badge -->
          <div class="absolute -bottom-4 -left-4 md:-left-8 neu-flat px-5 py-3 rounded-2xl flex items-center gap-3 transform group-hover:translate-x-2 group-hover:-translate-y-1 transition-all duration-500">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#25D366] opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-[#25D366]"></span>
            </span>
            <span class="text-[13px] md:text-sm font-bold text-slate-700 dark:text-neutral-200 tracking-wide">{profile.availabilityText}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 1.5 Skills Section -->
  <section class="max-w-[1400px] mx-auto px-8 py-8 md:py-12 reveal-up">
    <div class="py-8 md:py-10 px-6 flex flex-col neu-flat border-none rounded-3xl">
      <p class="text-[11px] font-bold text-slate-400 dark:text-neutral-500 uppercase tracking-widest mb-10 text-center">Keahlian & Spesialisasi</p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 w-full max-w-5xl mx-auto">
        {skills.map((skill, i) => {
          const style = skillStyles[i % skillStyles.length];
          return (
            <div class="flex flex-col gap-4">
              <div class="flex items-center gap-3 mb-2">
                <div class={`w-10 h-10 rounded-full ${style.bg} flex items-center justify-center ${style.text} shrink-0`}>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={style.d} /></svg>
                </div>
                <h3 class="font-extrabold text-slate-800 dark:text-white text-lg">{skill.category}</h3>
              </div>
              <div class="flex flex-wrap gap-2">
                {skill.items.map((item) => (
                  <span class={`px-3 py-1.5 neu-flat neu-flat-hover border-none rounded-lg text-sm font-medium text-slate-600 dark:text-slate-300 transition-all cursor-default ${style.tagHover}`}>{item}</span>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 2. Experience Section (Grid Layout) -->
  <section id="experience" class="py-16 max-w-[1400px] mx-auto px-8 relative border-none">
    <div class="mb-16 text-center max-w-2xl mx-auto">
      <h2 class="text-[36px] md:text-[44px] font-extrabold text-slate-900 dark:text-white mb-4 tracking-tight">Experience</h2>
      <p class="text-slate-500 dark:text-neutral-400 font-medium text-lg">Professional history and industry contributions.</p>
    </div>
    
    <div class="grid grid-cols-1 gap-6 md:gap-12 max-w-5xl mx-auto">
      {experiences.map((exp, index) => (
        <a href={`/experience/${exp.id}`} class={`group/card reveal-up flex flex-row md:flex-row ${index % 2 !== 0 ? 'md:flex-row-reverse' : ''} gap-3 md:gap-8 items-center neu-flat neu-flat-hover border-none rounded-2xl md:rounded-[2rem] p-2.5 md:p-4 transition-all duration-400 cursor-pointer`}>
          <!-- Image Section -->
          <div class="w-[110px] h-[110px] md:w-1/2 md:h-[300px] rounded-xl md:rounded-3xl overflow-hidden shrink-0 relative">
            {(() => {
              const rawPhotos = exp.data.photos;
              const photos = Array.isArray(rawPhotos) ? rawPhotos : (typeof rawPhotos === 'string' ? [rawPhotos] : []);
              return photos.length > 0 ? (
                <img src={photos[0]} alt={exp.data.title} class="w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-700 ease-out" loading="lazy" decoding="async" />
              ) : (
                <div class="w-full h-full bg-slate-100 dark:bg-[#222] flex items-center justify-center text-slate-400 dark:text-neutral-500">No Image</div>
              );
            })()}
            <div class="absolute inset-0 ring-1 ring-inset ring-black/10 dark:ring-white/10 rounded-xl md:rounded-3xl"></div>
          </div>

          <!-- Text Section -->
          <div class="flex-1 flex flex-col p-1 md:p-8 text-left min-w-0">
            <div class="bg-[#2a85ff]/10 dark:bg-[#2a85ff]/20 text-[#2a85ff] dark:text-[#60a5fa] text-[9px] md:text-[12px] font-bold px-2 md:px-4 py-0.5 md:py-1.5 rounded-full tracking-wider mb-1.5 md:mb-4 truncate max-w-full">
              {exp.data.duration}
            </div>
            <h3 class="text-[15px] md:text-[28px] font-extrabold text-slate-900 dark:text-white leading-tight tracking-tight mb-0.5 md:mb-2 group-hover/card:text-[#2a85ff] dark:group-hover/card:text-[#38bdf8] transition-colors">{exp.data.title}</h3>
            <div class="text-[12px] md:text-[16px] font-bold text-slate-600 dark:text-slate-300 mb-1 md:mb-4">{exp.data.company}</div>
            <p class="hidden md:block text-[15px] text-slate-500 dark:text-slate-400 leading-relaxed font-medium line-clamp-3 mb-6">{exp.body || exp.data?.description || ''}</p>
            <div class="text-[11px] md:text-[13px] font-bold text-[#E9582A] flex items-center gap-1 uppercase tracking-widest mt-auto">
              Details <span class="text-base md:text-xl leading-none transition-transform group-hover/card:translate-x-2">&rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 3. Sertifikat Kompetensi Section -->
  <section id="certificates" class="py-16 max-w-[1400px] mx-auto px-8 relative">
    <div class="mb-16 text-center max-w-2xl mx-auto">
      <h2 class="text-[36px] md:text-[44px] font-extrabold text-slate-900 dark:text-white mb-4 tracking-tight">Competency Certificates</h2>
      <p class="text-slate-500 dark:text-slate-400 font-medium text-lg">Recognition of expertise and industry safety standards.</p>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 md:gap-8">
      {certificates.map((cert) => (
        <a href={`/certificates/${cert.id}`} class="block reveal-up group neu-flat neu-flat-hover border-none rounded-xl md:rounded-2xl p-3 md:p-6 flex flex-row gap-3 md:gap-6 transition-all duration-300 cursor-pointer">
          <div class="w-14 h-14 md:w-32 md:h-32 rounded-lg md:rounded-xl neu-pressed border-none shrink-0 flex items-center justify-center text-[#10b981] dark:text-emerald-400 transition-colors duration-300">
            <svg class="w-7 h-7 md:w-12 md:h-12 opacity-80 transition-transform duration-500 ease-out group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <div class="flex-1 flex flex-col justify-center min-w-0">
            <div class="mb-1 md:mb-2">
              <span class="inline-block bg-[#10b981] dark:bg-[#10b981]/20 text-white dark:text-[#34d399] text-[10px] md:text-[11px] font-bold px-2 md:px-3 py-0.5 md:py-1 rounded-[4px] tracking-wider">
                {cert.data.date}
              </span>
            </div>
            <h3 class="text-[14px] md:text-[20px] font-extrabold text-slate-900 dark:text-white leading-tight mb-0.5 md:mb-2 tracking-tight group-hover:text-[#E9582A] dark:group-hover:text-[#fb923c] transition-colors">{cert.data.title}</h3>
            <p class="text-[12px] md:text-[14px] font-bold text-slate-500 dark:text-neutral-400 mb-0.5 md:mb-2 truncate">{cert.data.issuer}</p>
            <p class="hidden md:block text-[13.5px] text-slate-600 dark:text-neutral-300 leading-relaxed font-medium line-clamp-2">{cert.data.description}</p>
            <div class="text-[10px] md:text-[12px] font-bold text-slate-500 flex items-center gap-1 uppercase tracking-widest group-hover:text-[#E9582A] transition-colors mt-1 md:mt-4">
              Details <span class="text-base md:text-lg leading-none transition-transform group-hover:translate-x-1">&rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 4. Prestasi Section -->
  <section id="achievements" class="py-16 max-w-[1400px] mx-auto px-8 relative neu-flat border-none rounded-[2.5rem] my-8 overflow-hidden">
    
    <div class="mb-16 text-center max-w-2xl mx-auto relative z-10">
      <h2 class="text-[36px] md:text-[44px] font-extrabold text-slate-900 dark:text-white mb-4 tracking-tight">Achievements</h2>
      <p class="text-slate-500 dark:text-neutral-400 font-medium text-lg">Academic awards and non-academic competitions.</p>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-2 gap-3 md:gap-6 relative z-10">
      {achievements.map((achievement) => (
        <a href={`/achievements/${achievement.id}`} class="block reveal-up group neu-pressed border-none rounded-xl md:rounded-2xl p-3 md:p-6 transition-all duration-300 cursor-pointer">
          <div class="flex flex-col md:flex-row md:items-start gap-2 md:gap-4 h-full">
            <div class="w-9 h-9 md:w-12 md:h-12 rounded-full neu-flat text-orange-500 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-4 h-4 md:w-6 md:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
            </div>
            <div class="flex flex-col h-full w-full min-w-0">
              <div class="text-orange-500 text-[10px] md:text-[12px] font-bold tracking-widest mb-0.5 md:mb-1">{achievement.data.date}</div>
              <h3 class="text-[13px] md:text-[18px] font-bold text-slate-900 dark:text-white mb-0.5 md:mb-1 group-hover:text-orange-500 transition-colors leading-tight">{achievement.data.title}</h3>
              <p class="text-slate-500 dark:text-neutral-400 text-[11px] md:text-[13px] font-medium mb-1 md:mb-3 truncate">{achievement.data.issuer}</p>
              <p class="hidden md:block text-slate-600 dark:text-neutral-300 text-[14px] leading-relaxed mb-4">{achievement.data.description}</p>
              <div class="text-[10px] md:text-[12px] font-bold text-slate-500 flex items-center gap-1 uppercase tracking-widest group-hover:text-orange-500 transition-colors mt-auto pt-1 md:pt-2">
                Details <span class="text-base md:text-lg leading-none transition-transform group-hover:translate-x-1">&rarr;</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 5. Projects Section (Auto-Scrolling Marquee) -->
  <section id="projects" class="py-16 max-w-full overflow-hidden relative border-none transition-colors duration-300 reveal-up">
    <div class="max-w-[1400px] mx-auto px-8 mb-16 text-center">
      <h2 class="text-[36px] md:text-[44px] font-extrabold text-slate-900 dark:text-white mb-4 tracking-tight">Projects</h2>
      <p class="text-slate-500 dark:text-neutral-400 font-medium text-lg">Engineering works and solutions built.</p>
    </div>
    
    <!-- Auto-Scrolling Horizontal Marquee Container with Custom Drag -->
    <div class="relative w-full overflow-hidden cursor-grab active:cursor-grabbing" id="project-wrapper">
      <div class="absolute inset-y-0 left-0 w-20 md:w-48 bg-gradient-to-r from-[#ecf0f3] dark:from-[#1a1a1a] to-transparent z-20 pointer-events-none transition-colors duration-300"></div>
      <div class="absolute inset-y-0 right-0 w-20 md:w-48 bg-gradient-to-l from-[#ecf0f3] dark:from-[#1a1a1a] to-transparent z-20 pointer-events-none transition-colors duration-300"></div>
      
      <div class="flex w-full relative">
        <div id="project-track" class="flex items-start gap-4 md:gap-8 w-max px-4 py-8 will-change-transform">
          {marqueeProjects.map((proj, index) => (
            <a href={`/projects/${proj.id}`} class="w-[220px] md:w-[420px] shrink-0 block group/card neu-flat neu-flat-hover border-none rounded-xl md:rounded-3xl overflow-hidden transition-all duration-500">
              <div class="pointer-events-none">
                <!-- Cover Image -->
                <div class="w-full h-[140px] md:h-[200px] relative overflow-hidden bg-slate-200 dark:bg-[#222]">
                  {(() => {
                    const rawPhotos = proj.data.photos;
                    const photos = Array.isArray(rawPhotos) ? rawPhotos : (typeof rawPhotos === 'string' ? [rawPhotos] : []);
                    return photos.length > 0 ? (
