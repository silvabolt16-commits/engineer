<script is:inline>
  // Script for Smooth Subpixel Transform Marquee + Drag capability for Projects
  function setupMarquee() {
    const track = document.getElementById('project-track');
    const wrapper = document.getElementById('project-wrapper');
    if (!track || !wrapper) return;

    // Cegah inisialisasi ganda jika event dipanggil berkali-kali
    if (track.dataset.initialized) return;
    track.dataset.initialized = "true";

    let currentTranslate = 0;
    let isDragging = false;
    let startX = 0;
    let prevTranslate = 0;
    let isPaused = false;
    let isClick = true;
    
    let loopWidth = track.scrollWidth / 4;
    
    window.addEventListener('resize', () => {
      loopWidth = track.scrollWidth / 4;
    });

    wrapper.addEventListener('mousedown', (e) => {
      isDragging = true;
      isClick = true;
      startX = e.pageX;
      prevTranslate = currentTranslate;
    });
    
    wrapper.addEventListener('mouseleave', () => {
      isDragging = false;
      isPaused = false;
    });
    
    wrapper.addEventListener('mouseup', (e) => {
      isDragging = false;
    });
    
    wrapper.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const walk = (e.pageX - startX) * 1.5;
      if (Math.abs(walk) > 5) isClick = false; 
      currentTranslate = prevTranslate - walk;
    });

    track.addEventListener('click', (e) => {
      if (!isClick) {
        e.preventDefault();
        e.stopPropagation();
      }
    });

    wrapper.addEventListener('touchstart', (e) => {
      isDragging = true;
      startX = e.touches[0].pageX;
      prevTranslate = currentTranslate;
    }, { passive: true });
    
    wrapper.addEventListener('touchend', () => {
      isDragging = false;
    });
    
    wrapper.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      const walk = (e.touches[0].pageX - startX) * 1.5;
      currentTranslate = prevTranslate - walk;
    }, { passive: true });

    wrapper.addEventListener('mouseenter', () => isPaused = true);

    function animate() {
      // Berhenti jika elemen sudah tidak ada di DOM (pindah halaman)
      if (!document.getElementById('project-track')) return;

      if (!isDragging && !isPaused) {
        currentTranslate += 0.5; // Smooth subpixel speed (sangat lambat & halus)
      }
      
      if (currentTranslate >= loopWidth) {
        currentTranslate -= loopWidth;
        if (isDragging) prevTranslate -= loopWidth;
      } else if (currentTranslate < 0) {
        currentTranslate += loopWidth;
        if (isDragging) prevTranslate += loopWidth;
      }
      
      track.style.transform = `translate3d(${-currentTranslate}px, 0, 0)`;
      requestAnimationFrame(animate);
    }
    
    requestAnimationFrame(animate);
  }

  // Inisialisasi saat pertama load dan saat perpindahan halaman dengan ClientRouter
  setupMarquee();
  document.addEventListener('astro:page-load', setupMarquee);
</script>



<style is:global>
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0px); }
  }
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  /* Reveal Animations */
  .reveal-up {
    opacity: 0;
    transform: translateY(40px) scale(0.95);
    filter: blur(5px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-left {
    opacity: 0;
    transform: translateX(-40px);
    filter: blur(5px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-right {
    opacity: 0;
    transform: translateX(40px);
    filter: blur(5px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .reveal-up.is-revealed,
  .reveal-left.is-revealed,
  .reveal-right.is-revealed {
    opacity: 1;
    transform: translate(0) scale(1);
    filter: blur(0);
  }
</style>

<script is:inline>
  function setupScrollReveal() {
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -50px 0px', // Trigger slightly before entering fully
      threshold: 0.1
    };

    let staggerQueue = [];
    let staggerTimeout = null;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          // Tambahkan ke antrean jika belum memiliki class is-revealed
          if (!entry.target.classList.contains('is-revealed') && !staggerQueue.includes(entry.target)) {
            staggerQueue.push(entry.target);
          }
        } else {
          // Hapus class agar animasi diulang saat di-scroll kembali
          entry.target.classList.remove('is-revealed');
        }
      });

      if (staggerQueue.length > 0 && !staggerTimeout) {
        staggerTimeout = setTimeout(() => {
          staggerQueue.forEach((el, index) => {
            setTimeout(() => {
              el.classList.add('is-revealed');
            }, index * 120); // 120ms delay between elements appearing
          });
          staggerQueue = [];
          staggerTimeout = null;
        }, 30);
      }
    }, observerOptions);

    const revealElements = document.querySelectorAll('.reveal-up, .reveal-left, .reveal-right');
    // Clear any previously revealed classes on page load (useful for SPA transitions)
    revealElements.forEach(el => {
      el.classList.remove('is-revealed');
      observer.observe(el);
    });
  }
  
  setupScrollReveal();
  document.addEventListener('astro:page-load', setupScrollReveal);
</script>
