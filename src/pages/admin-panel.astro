---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Admin Panel - Upload Portofolio">
  <div class="max-w-4xl mx-auto py-24 px-4 sm:px-6 lg:px-8">
    
    <!-- 1. LOGIN FORM CONTAINER (FIREBASE AUTH) -->
    <div id="loginCard" class="neu-flat border-none rounded-3xl p-8 max-w-md mx-auto">
      <div class="text-center mb-8">
        <div class="w-16 h-16 bg-[#E9582A]/10 text-[#E9582A] rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
        </div>
        <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white">Admin Login</h2>
        <p class="text-slate-500 dark:text-neutral-400 text-sm mt-1">Login menggunakan akun Firebase Authentication resmi Anda.</p>
      </div>

      <form id="loginForm" class="space-y-5">
        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Email Firebase</label>
          <input type="email" id="email" required class="w-full neu-pressed border-none rounded-xl p-3.5 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#E9582A]" placeholder="fajriawwaluddin01@gmail.com">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Password</label>
          <div class="relative">
            <input type="password" id="password" required class="w-full neu-pressed border-none rounded-xl p-3.5 pr-12 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#E9582A]" placeholder="••••••••">
            <button type="button" id="togglePassword" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-[#E9582A] focus:outline-none transition-colors" aria-label="Toggle password visibility">
              <svg id="eyeIcon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
        </div>

        <div id="loginError" class="hidden text-red-500 text-xs font-bold text-center"></div>

        <button type="submit" id="loginBtn" class="w-full bg-[#E9582A] hover:bg-[#d04a1f] text-white font-bold py-3.5 rounded-xl shadow-md transition-all">
          Masuk dengan Firebase
        </button>
      </form>
    </div>

    <!-- 2. MAIN ADMIN UPLOAD PANEL (TERPROTEKSI FIREBASE AUTH) -->
    <div id="adminPanel" class="hidden neu-flat border-none rounded-3xl p-8">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-white/10 pb-6 mb-8">
        <div>
          <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">Admin Panel - Upload Konten</h1>
          <p id="userEmailText" class="text-[#E9582A] font-bold text-xs mt-1"></p>
        </div>
        <button id="logoutBtn" class="neu-flat neu-flat-hover text-red-500 font-bold px-4 py-2 rounded-xl text-xs uppercase tracking-wider border-none">
          Logout
        </button>
      </div>

      <form id="uploadForm" class="space-y-6">
        <!-- Pilihan Koleksi -->
        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Tipe Konten</label>
          <select id="collectionName" class="w-full neu-pressed border-none rounded-xl p-3.5 text-slate-900 dark:text-white dark:bg-[#1a1a1a] focus:outline-none focus:ring-2 focus:ring-[#E9582A]">
            <option value="projects">Projects (Proyek)</option>
            <option value="articles">Articles (Artikel)</option>
            <option value="experiences">Experiences (Pengalaman Kerja)</option>
            <option value="certificates">Certificates (Sertifikat)</option>
            <option value="achievements">Achievements (Prestasi)</option>
            <option value="skills">Skills (Keahlian)</option>
            <option value="settings_profile">Profil (Foto Profil & Profil Singkat)</option>
          </select>
        </div>

        <!-- Judul -->
        <div>
          <label id="lbl_title" class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Judul</label>
          <input type="text" id="title" required class="w-full neu-pressed border-none rounded-xl p-3.5 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#E9582A]" placeholder="Judul Proyek / Artikel / Posisi">
          <select id="title_select" class="hidden w-full neu-pressed border-none rounded-xl p-3.5 text-slate-900 dark:text-white dark:bg-[#1a1a1a] focus:outline-none focus:ring-2 focus:ring-[#E9582A]">
            <option value="Software">Software</option>
            <option value="Teknikal">Teknikal</option>
            <option value="Dokumen">Dokumen</option>
          </select>
        </div>

        <!-- Sub-Detail (Perusahaan / Issuer / Category / Tech) -->
        <div id="subDetailRow" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label id="lbl_subTitle" class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Kategori / Perusahaan / Issuer / Tech</label>
            <input type="text" id="subTitle" class="w-full neu-pressed border-none rounded-xl p-3.5 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#E9582A]" placeholder="Contoh: PT Engineering / Siemens / IoT">
          </div>
          <div>
            <label id="lbl_dateOrDuration" class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Tanggal / Durasi</label>
            <input type="text" id="dateOrDuration" class="w-full neu-pressed border-none rounded-xl p-3.5 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#E9582A]" placeholder="Contoh: 2023 - 2024 / Mei 2024">
          </div>
        </div>

        <!-- Link External -->
        <div id="linkRow">
          <label id="lbl_link" class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Link External (Opsional)</label>
          <input type="text" id="link" class="w-full neu-pressed border-none rounded-xl p-3.5 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#E9582A]" placeholder="https://github.com/...">
        </div>

        <!-- Deskripsi/Konten -->
        <div>
          <label id="lbl_description" class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Deskripsi / Detail Konten</label>
          <textarea id="description" required rows="5" class="w-full neu-pressed border-none rounded-xl p-3.5 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#E9582A]" placeholder="Tuliskan penjelasan atau konten markdown di sini..."></textarea>
          
          <!-- Dynamic Skills List -->
          <div id="skillsListContainer" class="hidden flex-col gap-3">
             <div id="skillsItems" class="flex flex-col gap-3">
               <!-- Items will be appended here -->
             </div>
             <button type="button" id="addSkillBtn" class="flex items-center gap-2 text-sm font-bold text-[#E9582A] hover:text-[#d04a1f] transition-colors w-max mx-auto mt-2 px-4 py-2 neu-flat rounded-full">
               <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
               Tambah Skill
             </button>
          </div>
        </div>

        <!-- File Upload Gambar -->
        <div id="imageRow">
          <label id="lbl_imageFile" class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Gambar Cover / Dokumentasi (Opsional)</label>
          <input type="file" id="imageFile" accept="image/*" class="w-full text-sm text-slate-600 dark:text-neutral-300 neu-pressed border-none rounded-xl p-3">
        </div>

        <button type="submit" id="submitBtn" class="w-full bg-[#E9582A] hover:bg-[#d04a1f] text-white font-bold py-4 rounded-xl shadow-md transition-all text-sm uppercase tracking-wider">
          Unggah Konten
        </button>
      </form>
      
      <!-- Status Message -->
      <div id="statusMessage" class="mt-6 hidden p-4 rounded-xl font-bold text-sm text-center"></div>
    </div>
  </div>
</MainLayout>

<script>
  import { db, storage, auth } from "../firebase/client";
  import { signInWithEmailAndPassword, signOut, onAuthStateChanged } from "firebase/auth";
  import { collection, addDoc, setDoc, doc } from "firebase/firestore";
  import { ref, uploadBytesResumable, getDownloadURL } from "firebase/storage";

  const loginCard = document.getElementById("loginCard");
  const adminPanel = document.getElementById("adminPanel");
  const loginForm = document.getElementById("loginForm") as HTMLFormElement;
  const loginBtn = document.getElementById("loginBtn") as HTMLButtonElement;
  const loginError = document.getElementById("loginError");
  const logoutBtn = document.getElementById("logoutBtn");
  const userEmailText = document.getElementById("userEmailText");

  const form = document.getElementById("uploadForm") as HTMLFormElement;
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
  const statusMessage = document.getElementById("statusMessage");

  // Listen to Firebase Auth state changes
  onAuthStateChanged(auth, (user) => {
    if (user) {
      loginCard?.classList.add("hidden");
      adminPanel?.classList.remove("hidden");
      if (userEmailText) userEmailText.textContent = `Logged in as: ${user.email}`;
    } else {
      adminPanel?.classList.add("hidden");
      loginCard?.classList.remove("hidden");
    }
  });

  const collectionNameSelect = document.getElementById("collectionName") as HTMLSelectElement;
  collectionNameSelect?.addEventListener("change", (e) => {
    const val = (e.target as HTMLSelectElement).value;
    const lblTitle = document.getElementById("lbl_title");
    const lblSubTitle = document.getElementById("lbl_subTitle");
    const lblDate = document.getElementById("lbl_dateOrDuration");
    const lblLink = document.getElementById("lbl_link");
    const lblDesc = document.getElementById("lbl_description");
    const lblImage = document.getElementById("lbl_imageFile");
    
    const inputTitle = document.getElementById("title") as HTMLInputElement;
    const selectTitle = document.getElementById("title_select") as HTMLSelectElement;
    const inputSubTitle = document.getElementById("subTitle") as HTMLInputElement;
    const inputDate = document.getElementById("dateOrDuration") as HTMLInputElement;
    const inputLink = document.getElementById("link") as HTMLInputElement;
    const inputDesc = document.getElementById("description") as HTMLTextAreaElement;
    
    const skillsListContainer = document.getElementById("skillsListContainer");
    const subDetailRow = document.getElementById("subDetailRow");
    const linkRow = document.getElementById("linkRow");
    const imageRow = document.getElementById("imageRow");
    
    if (val === "settings_profile") {
      if(lblTitle) lblTitle.textContent = "Nama Lengkap (Opsional)";
      if(inputTitle) inputTitle.placeholder = "Kosongkan jika tidak ingin diubah...";
      
      if(lblSubTitle) lblSubTitle.textContent = "Role / Pekerjaan (Opsional)";
      if(inputSubTitle) inputSubTitle.placeholder = "Kosongkan jika tidak ingin diubah...";
      
      if(lblDate) lblDate.textContent = "Status Ketersediaan (Opsional)";
      if(inputDate) inputDate.placeholder = "Kosongkan jika tidak ingin diubah...";
      
      if(subDetailRow) { subDetailRow.classList.remove("hidden"); subDetailRow.classList.add("grid"); }
      if(linkRow) { linkRow.classList.remove("hidden"); }
      
      if(lblLink) lblLink.textContent = "Lokasi (Kota, Provinsi) (Opsional)";
      if(inputLink) inputLink.placeholder = "Kosongkan jika tidak ingin diubah...";
      
      if(lblDesc) lblDesc.textContent = "Profil Singkat (Bio) (Opsional)";
      if(inputDesc) { inputDesc.classList.remove("hidden"); inputDesc.required = false; inputDesc.placeholder = "Kosongkan jika tidak ingin diubah..."; }
      if(skillsListContainer) { skillsListContainer.classList.add("hidden"); skillsListContainer.classList.remove("flex"); }
      
      if(imageRow) { imageRow.classList.remove("hidden"); }
      if(lblImage) lblImage.textContent = "Foto Profil";
      
      if(inputTitle) { inputTitle.classList.remove("hidden"); inputTitle.required = false; }
      if(selectTitle) selectTitle.classList.add("hidden");
    } else if (val === "skills") {
      if(lblTitle) lblTitle.textContent = "Kategori (Pilih salah satu)";
      if(inputTitle) { inputTitle.classList.add("hidden"); inputTitle.required = false; }
      if(selectTitle) selectTitle.classList.remove("hidden");
      
      if(subDetailRow) { subDetailRow.classList.add("hidden"); subDetailRow.classList.remove("grid"); }
      if(linkRow) { linkRow.classList.add("hidden"); }
      
      if(lblDesc) lblDesc.textContent = "Daftar Keahlian";
      if(inputDesc) { inputDesc.classList.add("hidden"); inputDesc.required = false; }
      if(skillsListContainer) { skillsListContainer.classList.remove("hidden"); skillsListContainer.classList.add("flex"); }
      
      if(imageRow) { imageRow.classList.add("hidden"); }
    } else {
      if(lblTitle) lblTitle.textContent = "Judul";
      if(inputTitle) { inputTitle.classList.remove("hidden"); inputTitle.required = true; inputTitle.placeholder = "Judul Proyek / Artikel / Posisi"; }
      if(selectTitle) selectTitle.classList.add("hidden");
      
      if(subDetailRow) { subDetailRow.classList.remove("hidden"); subDetailRow.classList.add("grid"); }
      if(linkRow) { linkRow.classList.remove("hidden"); }
      
      if(lblSubTitle) lblSubTitle.textContent = "Kategori / Perusahaan / Issuer / Tech";
      if(inputSubTitle) inputSubTitle.placeholder = "Contoh: PT Engineering / Siemens / IoT";
      
      if(lblDate) lblDate.textContent = "Tanggal / Durasi";
      if(inputDate) inputDate.placeholder = "Contoh: 2023 - 2024 / Mei 2024";
      
      if(lblLink) lblLink.textContent = "Link External (Opsional)";
      if(inputLink) inputLink.placeholder = "https://github.com/...";
      
      if(lblDesc) lblDesc.textContent = "Deskripsi / Detail Konten";
      if(inputDesc) { inputDesc.classList.remove("hidden"); inputDesc.required = true; inputDesc.placeholder = "Tuliskan penjelasan atau konten markdown di sini..."; }
      if(skillsListContainer) { skillsListContainer.classList.add("hidden"); skillsListContainer.classList.remove("flex"); }
      
      if(imageRow) { imageRow.classList.remove("hidden"); }
      if(lblImage) lblImage.textContent = "Gambar Cover / Dokumentasi (Opsional)";
    }
  });

  // Toggle password visibility (Fitur Intip Password)
  const togglePasswordBtn = document.getElementById("togglePassword");
  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const eyeIcon = document.getElementById("eyeIcon");

  togglePasswordBtn?.addEventListener("click", () => {
    if (passwordInput && eyeIcon) {
      if (passwordInput.type === "password") {
        passwordInput.type = "text";
        eyeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-5.908a10.025 10.025 0 013.682-.863c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21M3 3l18 18" />`;
      } else {
        passwordInput.type = "password";
        eyeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />`;
      }
    }
  });

  // Handle Firebase Login
  loginForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = (document.getElementById("email") as HTMLInputElement).value;
    const password = (document.getElementById("password") as HTMLInputElement).value;

    if (loginBtn) {
      loginBtn.disabled = true;
      loginBtn.textContent = "Memverifikasi...";
    }
    if (loginError) loginError.classList.add("hidden");

    try {
      await signInWithEmailAndPassword(auth, email, password);
      loginForm.reset();
    } catch (error: any) {
      console.error(error);
      if (loginError) {
        loginError.textContent = `Login Gagal: ${error.message || 'Email atau password salah'}`;
        loginError.classList.remove("hidden");
      }
    } finally {
      if (loginBtn) {
        loginBtn.disabled = false;
        loginBtn.textContent = "Masuk dengan Firebase";
      }
    }
  });

  // Handle Logout
  logoutBtn?.addEventListener("click", async () => {
    await signOut(auth);
  });

  function showStatus(message: string, isError = false) {
    if (!statusMessage) return;
    statusMessage.textContent = message;
    statusMessage.classList.remove("hidden", "bg-emerald-100", "text-emerald-800", "bg-red-100", "text-red-800");
    
    if (isError) {
      statusMessage.classList.add("bg-red-100", "text-red-800");
    } else {
      statusMessage.classList.add("bg-emerald-100", "text-emerald-800");
    }
  }

  // Dynamic skills logic
  const skillsItems = document.getElementById("skillsItems");
  const addSkillBtn = document.getElementById("addSkillBtn");

  function createSkillInput() {
    const div = document.createElement("div");
    div.className = "flex items-center gap-3";
    
    const input = document.createElement("input");
    input.type = "text";
    input.className = "w-full neu-pressed border-none rounded-xl p-3.5 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#E9582A] skill-input-item";
    input.placeholder = "Nama skill (Contoh: AutoCAD)";
    
    const delBtn = document.createElement("button");
    delBtn.type = "button";
    delBtn.className = "p-3.5 neu-flat text-red-500 hover:text-red-700 rounded-xl transition-colors shrink-0 flex items-center justify-center";
    delBtn.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>`;
    
    delBtn.addEventListener("click", () => div.remove());
    
    div.appendChild(input);
    div.appendChild(delBtn);
    skillsItems?.appendChild(div);
  }

  addSkillBtn?.addEventListener("click", createSkillInput);
  if (skillsItems && skillsItems.children.length === 0) createSkillInput();

  // Handle Upload Form Submit
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = "Mengunggah...";
    showStatus("Memproses unggahan...");

    const collectionName = (document.getElementById("collectionName") as HTMLSelectElement).value;
    const title = collectionName === "skills" 
      ? (document.getElementById("title_select") as HTMLSelectElement).value 
      : (document.getElementById("title") as HTMLInputElement).value;
    const subTitle = (document.getElementById("subTitle") as HTMLInputElement).value;
    const dateOrDuration = (document.getElementById("dateOrDuration") as HTMLInputElement).value;
    const link = (document.getElementById("link") as HTMLInputElement).value;
    const description = (document.getElementById("description") as HTMLTextAreaElement).value;
    const imageInput = document.getElementById("imageFile") as HTMLInputElement;
    const file = imageInput.files?.[0];

    try {
      let imageUrl = "";

      // 1. Upload Gambar ke Storage jika ada
      if (file) {
        const storageRef = ref(storage, `${collectionName}/${Date.now()}_${file.name}`);
        showStatus("Mengunggah gambar ke Firebase Storage...");
        
        const snapshot = await uploadBytesResumable(storageRef, file);
        imageUrl = await getDownloadURL(snapshot.ref);
      }

      // 2. Simpan Data ke Firestore
      showStatus("Menyimpan data ke Firestore...");
      
      if (collectionName === "settings_profile") {
        const profileData: any = {
          updatedAt: new Date().toISOString()
        };
        
        if (title && title.trim() !== "") profileData.name = title;
        if (subTitle && subTitle.trim() !== "") profileData.role = subTitle;
        if (dateOrDuration && dateOrDuration.trim() !== "") profileData.availabilityText = dateOrDuration;
        if (link && link.trim() !== "") profileData.location = link;
        if (description && description.trim() !== "") {
          profileData.bio = description;
          profileData.cvSummary = description;
        }
        
        if (imageUrl) {
          profileData.avatar = imageUrl; 
        }

        await setDoc(doc(db, "settings", "profile"), profileData, { merge: true });
      } else {
        const docData: any = {
          title,
          description,
          body: description,
          image: imageUrl,
          photos: imageUrl ? [imageUrl] : [],
          createdAt: new Date().toISOString()
        };

        if (collectionName === "projects") {
          docData.tech = subTitle || "General";
          docData.tags = subTitle ? subTitle.split(",").map(t => t.trim()) : ["Engineering"];
          docData.link = link || "#";
        } else if (collectionName === "articles") {
          docData.category = subTitle || "General";
          docData.date = dateOrDuration || new Date().toLocaleDateString("id-ID");
          docData.summary = description.slice(0, 150);
        } else if (collectionName === "experiences") {
          docData.company = subTitle || "Company";
          docData.duration = dateOrDuration || "2024";
          docData.details = description.split("\n").filter(line => line.trim() !== "");
        } else if (collectionName === "certificates" || collectionName === "achievements") {
          docData.issuer = subTitle || "Official";
          docData.date = dateOrDuration || "2024";
          docData.link = link || "#";
        } else if (collectionName === "skills") {
          docData.category = title || "Kategori Baru";
          const skillInputs = document.querySelectorAll(".skill-input-item");
          docData.items = Array.from(skillInputs).map(el => (el as HTMLInputElement).value.trim()).filter(v => v !== "");
        }

        await addDoc(collection(db, collectionName), docData);
      }

      showStatus("✅ Tersimpan! Sedang menginstruksikan Cloudflare untuk update...");
      
      // Memicu Cloudflare Deploy Hook agar website otomatis rebuild
      try {
        const deployHookUrl = "MASUKKAN_URL_DEPLOY_HOOK_CLOUDFLARE_DISINI";
        if (deployHookUrl !== "MASUKKAN_URL_DEPLOY_HOOK_CLOUDFLARE_DISINI") {
          await fetch(deployHookUrl, { 
            method: 'POST',
            mode: 'no-cors' // Menghindari error CORS dari browser
          });
        }
        showStatus("✅ Selesai! Website sedang diperbarui otomatis (Tunggu 1-2 menit lalu cek web Anda).");
      } catch (e) {
        showStatus("✅ Selesai! Website sedang diperbarui otomatis (Tunggu 1-2 menit lalu cek web Anda).");
      }

      form.reset();
    } catch (error) {
      console.error(error);
      showStatus(`❌ Gagal: ${(error as Error).message}`, true);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Unggah Konten";
    }
  });
</script>
