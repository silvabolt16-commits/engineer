---
import { getDB, getAllFromTable } from '../lib/d1';
import MainLayout from '../layouts/MainLayout.astro';
const db = getDB(Astro.locals);
const experiences = await getAllFromTable(db, 'experiences');

function formatDuration(durationStr: string) {
  if (!durationStr || !durationStr.includes('|')) return durationStr;
  
  const [start, end] = durationStr.split('|');
  const formatDate = (dateStr: string) => {
    if (dateStr === 'present') return 'Sekarang';
    if (!dateStr) return '';
    try {
      const [year, month] = dateStr.split('-');
      const date = new Date(parseInt(year), parseInt(month) - 1);
      return date.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
    } catch (e) {
      return dateStr;
    }
  };
  
  return `${formatDate(start)} - ${formatDate(end)}`;
}

// Gandakan 4 kali agar efek infinite scroll (marquee) mulus di layar ultra-wide
const marqueeItems = [...experiences, ...experiences, ...experiences, ...experiences];
---

<MainLayout title="Experience - Fajri Awwaluddin">
  <div class="pt-6 pb-10 md:pt-10 md:pb-16 max-w-full overflow-hidden relative">

    <div class="max-w-[1400px] mx-auto px-8 mb-8 md:mb-10 text-center">
      <h1 class="text-[40px] md:text-[50px] font-extrabold text-slate-900 mb-4 tracking-tight">Experience</h1>
      <p class="text-slate-500 font-medium text-lg">Riwayat profesional dan kontribusi industri.</p>
    </div>

    <!-- Auto-Scrolling Horizontal Marquee Container -->
    <div class="relative w-full marquee-container cursor-default">
      <!-- Efek Fade di sisi kiri dan kanan agar terlihat menyatu dengan background -->
      <div class="absolute inset-y-0 left-0 w-20 md:w-48 bg-gradient-to-r from-white to-transparent z-20 pointer-events-none"></div>
      <div class="absolute inset-y-0 right-0 w-20 md:w-48 bg-gradient-to-l from-white to-transparent z-20 pointer-events-none"></div>

      <div class="flex w-full relative">
        <!-- Track animasi -->
        <div class="flex animate-marquee-experience items-start gap-8 w-max px-4">

          {marqueeItems.map((exp, index) => (
            <a href={`/experience/${exp.slug}`} class="w-[420px] shrink-0 block group bg-transparent border border-transparent rounded-2xl overflow-hidden hover:bg-white hover:border-slate-200 hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-1 cursor-pointer">
              <div class="flex flex-col p-6 outline-none">

                <div class="flex items-center gap-5 mb-4">
                  <!-- Thumbnail / Ikon -->
                  <div class="w-20 h-20 rounded-xl bg-white group-hover:bg-[#e3f2fd] shrink-0 overflow-hidden relative flex items-center justify-center text-[#2a85ff] border border-slate-100 group-hover:border-blue-100 transition-colors duration-300">
                    <svg class="w-10 h-10 opacity-80 transition-transform duration-500 ease-out group-hover:scale-125" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>

                  <div class="flex-1">
                    <div class="inline-block bg-[#2a85ff] text-white text-[11px] font-bold px-3 py-1 rounded-[4px] tracking-wider mb-2">
                      {formatDuration(exp.duration)}
                    </div>
                    <h2 class="text-[18px] font-extrabold text-slate-900 leading-tight tracking-tight">{exp.title}</h2>
                  </div>
                </div>

                <div class="text-[14px] font-medium text-slate-600 mb-4">{exp.company}</div>

                <!-- Toggle Indicator -->
                <div class="text-[12px] font-bold text-slate-500 flex items-center gap-1 uppercase tracking-widest group-hover:text-[#E9582A] transition-colors mt-auto">
                  Baca Detail <span class="text-lg leading-none">&rarr;</span>
                </div>

              </div>
            </a>
          ))}

        </div>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  /*
    Karena kita menggandakan array experiences 4 kali,
    kita menggeser track sebesar 25% (1/4 dari total width)
    agar perulangannya mulus tanpa jeda (infinite seamless).
  */
  @keyframes marqueeExperience {
    0% { transform: translateX(0); }
    100% { transform: translateX(-25%); }
  }

  .animate-marquee-experience {
    /* Atur kecepatan scroll (semakin besar angkanya semakin lambat) */
    animation: marqueeExperience 25s linear infinite;
  }

  /* Hentikan animasi saat area di-hover */
  .marquee-container:hover .animate-marquee-experience {
    animation-play-state: paused;
  }
</style>
