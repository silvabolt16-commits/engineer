---
import MainLayout from '../../layouts/MainLayout.astro';
import { updates } from '../../data/portfolio.ts';

export function getStaticPaths() {
  return updates.map((update) => ({
    params: { slug: update.slug },
    props: { update },
  }));
}

const { update } = Astro.props;
---

<MainLayout title={`${update.title} - Fajri Awwaluddin`}>
  <!-- Article Header -->
  <div class="max-w-[800px] mx-auto px-8 pt-32 pb-12 text-center">
    <div class="inline-block text-[#10b981] font-extrabold tracking-widest uppercase mb-4 text-sm">
      {update.date}
    </div>
    <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-8">{update.title}</h1>
    
    <!-- Hero Image -->
    {update.photos.length > 0 && (
      <div class="w-full rounded-2xl overflow-hidden shadow-xl border border-slate-200">
        <img src={update.photos[0]} alt={update.title} class="w-full h-auto max-h-[450px] object-cover" />
      </div>
    )}
  </div>

  <!-- Content Section -->
  <div class="max-w-[700px] mx-auto px-8 pb-24">
    <div class="prose prose-lg prose-slate max-w-none text-slate-700 leading-loose text-justify">
      {update.content.split('\n').map((paragraph) => (
        <p class="mb-6">{paragraph}</p>
      ))}
    </div>
    
    <!-- Back button -->
    <div class="mt-16 pt-8 border-t border-slate-200 text-center">
      <a href="/updates" class="inline-flex items-center gap-2 text-slate-500 hover:text-[#E9582A] font-bold transition-colors">
        <span class="text-xl">&larr;</span> Kembali ke Updates
      </a>
    </div>
  </div>
</MainLayout>
