---
import { isAuthenticated } from "../../lib/auth";

if (isAuthenticated(Astro)) {
  return Astro.redirect("/admin");
}
---

<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login Admin Portofolio</title>
  <style>
    body {
      background-color: #0f172a;
      color: #f8fafc;
      font-family: system-ui, -apple-system, sans-serif;
    }
  </style>
</head>
<body class="flex items-center justify-center min-h-screen px-4">
  <div class="w-full max-w-md p-8 space-y-6 bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl">
    <div class="text-center">
      <h1 class="text-3xl font-bold bg-gradient-to-r from-blue-400 to-indigo-400 bg-clip-text text-transparent">
        Admin Portofolio
      </h1>
      <p class="mt-2 text-sm text-slate-400">Masukkan kata sandi untuk masuk ke Dashboard</p>
    </div>

    <form id="loginForm" class="space-y-4">
      <div>
        <label for="password" class="block text-sm font-medium text-slate-300">Kata Sandi</label>
        <input
          type="password"
          id="password"
          name="password"
          required
          placeholder="••••••••"
          class="w-full px-4 py-3 mt-1 text-slate-100 bg-slate-800 border border-slate-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none transition"
        />
      </div>

      <div id="errorAlert" class="hidden p-3 text-sm text-red-400 bg-red-950/50 border border-red-800 rounded-xl text-center"></div>

      <button
        type="submit"
        class="w-full py-3 text-white font-medium bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 rounded-xl shadow-lg transition duration-200"
      >
        Masuk Admin
      </button>
    </form>
  </div>

  <script>
    const form = document.getElementById("loginForm") as HTMLFormElement;
    const errorAlert = document.getElementById("errorAlert");

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorAlert?.classList.add("hidden");

      const password = (document.getElementById("password") as HTMLInputElement).value;

      try {
        const res = await fetch("/api/auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          window.location.href = "/admin";
        } else {
          if (errorAlert) {
            errorAlert.textContent = data.message || "Kata sandi salah";
            errorAlert.classList.remove("hidden");
          }
        }
      } catch (err) {
        if (errorAlert) {
          errorAlert.textContent = "Terjadi kesalahan jaringan";
          errorAlert.classList.remove("hidden");
        }
      }
    });
  </script>
</body>
</html>
