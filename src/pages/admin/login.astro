---
export const prerender = false;

import { isAuthenticated } from "../../lib/auth";
import AdminLayout from "../../layouts/AdminLayout.astro";

if (isAuthenticated(Astro)) {
  return Astro.redirect("/admin");
}
---

<AdminLayout title="Login Admin | Portofolio">
  <div class="max-w-md mx-auto mt-16 px-6 relative z-10">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-extrabold text-slate-800 dark:text-white mb-2 uppercase tracking-widest">
        Admin <span class="text-[#E9582A]">Login</span>
      </h1>
      <p class="text-sm text-slate-500 dark:text-neutral-400">Masukkan kata sandi untuk mengakses dashboard</p>
    </div>

    <div id="loginCard" class="neu-flat rounded-3xl p-8 mb-12">
      <form id="loginForm" class="space-y-6">
        <div>
          <label for="password" class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Kata Sandi</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            placeholder="••••••••"
            class="w-full px-4 py-3 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition"
          />
        </div>

        <div id="errorAlert" class="hidden p-4 text-sm font-semibold text-red-600 bg-red-100/80 border border-red-300 rounded-xl text-center"></div>

        <button
          type="submit"
          id="loginBtn"
          class="w-full bg-[#E9582A] hover:bg-[#d04a1f] text-white font-bold py-4 rounded-xl shadow-md transition-all text-sm uppercase tracking-wider"
        >
          Masuk Dashboard
        </button>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById("loginForm") as HTMLFormElement;
    const errorAlert = document.getElementById("errorAlert");
    const loginBtn = document.getElementById("loginBtn") as HTMLButtonElement;

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorAlert?.classList.add("hidden");
      if (loginBtn) {
        loginBtn.disabled = true;
        loginBtn.textContent = "Memverifikasi...";
      }

      const password = (document.getElementById("password") as HTMLInputElement).value;

      try {
        const res = await fetch("/api/auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          window.location.href = "/admin";
        } else {
          if (errorAlert) {
            errorAlert.textContent = data.message || "Kata sandi salah";
            errorAlert.classList.remove("hidden");
          }
          if (loginBtn) {
            loginBtn.disabled = false;
            loginBtn.textContent = "Masuk Dashboard";
          }
        }
      } catch (err) {
        if (errorAlert) {
          errorAlert.textContent = "Terjadi kesalahan jaringan";
          errorAlert.classList.remove("hidden");
        }
        if (loginBtn) {
          loginBtn.disabled = false;
          loginBtn.textContent = "Masuk Dashboard";
        }
      }
    });
  </script>
</AdminLayout>
