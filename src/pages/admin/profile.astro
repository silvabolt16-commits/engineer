---
export const prerender = false;
import { isAuthenticated } from "../../lib/auth";
import { getDB, getProfile } from "../../lib/d1";
import AdminLayout from "../../layouts/AdminLayout.astro";

if (!isAuthenticated(Astro)) {
  return Astro.redirect("/admin/login");
}

const db = getDB(Astro.locals);
const profile = await getProfile(db);

const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME || "";
const uploadPreset = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET || "";

if (!profile) {
  // If no profile, we can't edit it. In a real app we'd create one.
}
---

<AdminLayout title="Edit Profil | Admin">
  <div class="max-w-4xl mx-auto pt-6 pb-6 md:pt-10 md:pb-8 px-6">
    <div class="mb-10">
      <h1 class="text-3xl font-extrabold text-slate-800 dark:text-white mt-4 uppercase tracking-widest">Edit<span class="text-[#E9582A]">Profil & Kontak</span>
      </h1>
    </div>

    <div class="neu-flat rounded-3xl p-8 md:p-10">
      <form id="profileForm" class="space-y-8">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Nama Lengkap</label>
            <input type="text" name="name" value={profile?.name || ''} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Posisi (ID)</label>
            <input type="text" name="role" value={profile?.role || ''} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Posisi (EN)</label>
            <input type="text" name="role_en" value={profile?.role_en || ''} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>

          <input type="hidden" name="heroBadge" value={profile?.heroBadge || ''} />
          <input type="hidden" name="heroBadge_en" value={profile?.heroBadge_en || ''} />
          <input type="hidden" name="tagline" value={profile?.tagline || ''} />
          <input type="hidden" name="tagline_en" value={profile?.tagline_en || ''} />
          <input type="hidden" name="availabilityText" value={profile?.availabilityText || ''} />
          <input type="hidden" name="availabilityText_en" value={profile?.availabilityText_en || ''} />
          <input type="hidden" name="cvSummary" value={profile?.cvSummary || ''} />
          <input type="hidden" name="cvSummary_en" value={profile?.cvSummary_en || ''} />

          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Lokasi</label>
            <input type="text" name="location" value={profile?.location || ''} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Email</label>
            <input type="email" name="email" value={profile?.email || ''} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Telepon/WhatsApp</label>
            <input type="text" name="phone" value={profile?.phone || ''} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">LinkedIn URL</label>
            <input type="url" name="linkedin" value={profile?.linkedin || ''} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>
          <div class="md:col-span-2 p-6 neu-pressed rounded-2xl space-y-4">
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider">Gambar Avatar / Foto Profil</label>
            
            <div class="flex flex-col sm:flex-row items-center gap-4">
              <input type="file" id="imageFile" accept="image/*" class="w-full sm:w-auto text-sm text-slate-600 dark:text-neutral-300 file:mr-4 file:py-2.5 file:px-5 file:rounded-xl file:border-0 file:text-xs file:font-bold file:uppercase file:tracking-wider file:bg-[#E9582A] file:text-white hover:file:bg-[#d04a1f] cursor-pointer transition-colors" />
              <input type="hidden" name="avatar" id="avatarUrl" value={profile?.avatar || ''} />
            </div>

            <div id="uploadStatus" class="text-xs font-bold hidden uppercase tracking-wider mt-2"></div>
            <img id="imagePreview" src={profile?.avatar || ''} class={`w-32 h-32 object-cover rounded-full mx-auto mt-4 border-4 border-slate-800 ${profile?.avatar ? '' : 'hidden'}`} alt="Preview Avatar" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Bio Singkat (ID)</label>
            <textarea name="bio" rows="4" class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition">{profile?.bio || ''}</textarea>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Bio Singkat (EN)</label>
            <textarea name="bio_en" rows="4" class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition">{profile?.bio_en || ''}</textarea>
          </div>
        </div>


        <div class="pt-6 border-t border-slate-200 dark:border-slate-800 flex justify-end">
          <button type="submit" id="submitBtn" class="px-8 py-4 bg-[#E9582A] hover:bg-[#d04a1f] text-white font-bold rounded-xl shadow-md transition-all text-sm uppercase tracking-wider">
            Simpan Profil
          </button>
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ cloudName, uploadPreset }}>
    const imageFileInput = document.getElementById("imageFile");
    const avatarUrlInput = document.getElementById("avatarUrl");
    const imagePreview = document.getElementById("imagePreview");
    const uploadStatus = document.getElementById("uploadStatus");

    imageFileInput?.addEventListener("change", async (e) => {
      const fileInput = e.target.files[0];
      if (!fileInput) return;

      if (!cloudName || !uploadPreset) {
        alert("Konfigurasi Cloudinary belum diset di environment variable. Silakan tempel URL gambar langsung.");
        return;
      }

      uploadStatus.textContent = "Memproses dan kompresi gambar...";
      uploadStatus.classList.remove("hidden");
      uploadStatus.classList.add("text-[#E9582A]");
      uploadStatus.classList.remove("text-green-500", "text-red-500");

      // Client-side compression to WebP
      const compressImage = (file) => {
        return new Promise((resolve) => {
          if (!file.type.match(/image.*/)) {
            resolve(file); return;
          }
          const reader = new FileReader();
          reader.onload = (event) => {
            const img = new Image();
            img.onload = () => {
              const canvas = document.createElement('canvas');
              let width = img.width;
              let height = img.height;
              const MAX_SIZE = 1920;
              if (width > height && width > MAX_SIZE) {
                height *= MAX_SIZE / width;
                width = MAX_SIZE;
              } else if (height > MAX_SIZE) {
                width *= MAX_SIZE / height;
                height = MAX_SIZE;
              }
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext('2d');
              ctx.drawImage(img, 0, 0, width, height);
              canvas.toBlob((blob) => {
                const newFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".webp", {
                  type: 'image/webp',
                  lastModified: Date.now()
                });
                resolve(newFile);
              }, 'image/webp', 0.85);
            };
            img.src = event.target.result;
          };
          reader.readAsDataURL(file);
        });
      };

      const file = await compressImage(fileInput);

      uploadStatus.textContent = "Mengunggah gambar ke Cloudinary...";

      const formData = new FormData();
      formData.append("file", file);
      formData.append("upload_preset", uploadPreset);

      try {
        const res = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, {
          method: "POST",
          body: formData,
        });

        if (res.ok) {
          const data = await res.json();
          avatarUrlInput.value = data.secure_url;
          imagePreview.src = data.secure_url;
          imagePreview.classList.remove("hidden");
          uploadStatus.textContent = "✓ Gambar berhasil diunggah!";
          uploadStatus.classList.remove("text-[#E9582A]", "text-red-500");
          uploadStatus.classList.add("text-green-500");
        } else {
          const errData = await res.json().catch(() => ({}));
          console.error("Cloudinary Error:", errData);
          uploadStatus.textContent = "Gagal: " + (errData.error?.message || "Kesalahan API");
          uploadStatus.classList.remove("text-[#E9582A]", "text-green-500");
          uploadStatus.classList.add("text-red-500");
        }
      } catch (err) {
        uploadStatus.textContent = "Terjadi kesalahan saat upload gambar.";
        uploadStatus.classList.remove("text-[#E9582A]", "text-green-500");
        uploadStatus.classList.add("text-red-500");
      }
    });

    avatarUrlInput?.addEventListener("input", () => {
      if (avatarUrlInput.value) {
        imagePreview.src = avatarUrlInput.value;
        imagePreview.classList.remove("hidden");
      }
    });

    document.getElementById("profileForm")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById("submitBtn");
      if(submitBtn) { submitBtn.innerText = "Menyimpan..."; submitBtn.disabled = true; }

      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch("/api/cms/profile", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data)
        });

        if (res.ok) {
          alert("Profil berhasil disimpan!");
        } else {
          alert("Gagal menyimpan profil.");
        }
      } catch (err) {
        alert("Gagal menyimpan profil.");
      } finally {
        if(submitBtn) { submitBtn.innerText = "Simpan Profil"; submitBtn.disabled = false; }
      }
    });
  </script>
</AdminLayout>

