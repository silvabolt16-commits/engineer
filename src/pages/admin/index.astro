---
export const prerender = false;

import { isAuthenticated } from "../../lib/auth";
import AdminLayout from "../../layouts/AdminLayout.astro";

if (!isAuthenticated(Astro)) {
  return Astro.redirect("/admin/login");
}
---

<AdminLayout title="Dashboard Admin | Portofolio">
  <div class="max-w-6xl mx-auto py-12 px-6">
    <div class="flex flex-col md:flex-row items-center justify-between mb-12 gap-6">
      <div class="text-center md:text-left">
        <h1 class="text-3xl font-extrabold text-slate-800 dark:text-white uppercase tracking-widest mb-2">
          Admin <span class="text-[#E9582A]">Panel</span>
        </h1>
        <p class="text-sm text-slate-500 dark:text-neutral-400">Pusat Manajemen Konten Portofolio Anda</p>
      </div>

      <div class="flex items-center space-x-4">
        <a href="/" target="_blank" class="px-4 py-3 neu-flat rounded-xl text-sm font-bold text-slate-700 dark:text-neutral-200 hover:text-[#E9582A] dark:hover:text-[#E9582A] neu-flat-hover transition-all uppercase tracking-wider">Lihat Web ↗</a>

        <button id="logoutBtn" class="px-4 py-3 neu-pressed rounded-xl text-sm font-bold text-red-500 hover:text-red-600 transition-all uppercase tracking-wider">
          Keluar
        </button>
      </div>
    </div>

    <!-- CMS Navigation Cards -->
    <div class="mb-16">
      <h2 class="text-lg font-bold text-slate-800 dark:text-white uppercase tracking-widest mb-6 border-b border-slate-200 dark:border-slate-800 pb-2">Manajemen Konten (CMS)</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="/admin/profile" class="neu-flat rounded-2xl p-4 text-center group hover:-translate-y-1 transition-all cursor-pointer">
          <div class="w-10 h-10 mx-auto rounded-full neu-pressed flex items-center justify-center text-[#E9582A] mb-3 group-hover:scale-110 transition-transform">👤</div>
          <h3 class="text-xs font-bold text-slate-700 dark:text-neutral-200 uppercase tracking-wider">Profil Singkat</h3>
        </a>
        <a href="/admin/cms/experiences" class="neu-flat rounded-2xl p-4 text-center group hover:-translate-y-1 transition-all cursor-pointer">
          <div class="w-10 h-10 mx-auto rounded-full neu-pressed flex items-center justify-center text-[#E9582A] mb-3 group-hover:scale-110 transition-transform">💼</div>
          <h3 class="text-xs font-bold text-slate-700 dark:text-neutral-200 uppercase tracking-wider">Pengalaman</h3>
        </a>
        <a href="/admin/cms/education" class="neu-flat rounded-2xl p-4 text-center group hover:-translate-y-1 transition-all cursor-pointer">
          <div class="w-10 h-10 mx-auto rounded-full neu-pressed flex items-center justify-center text-[#E9582A] mb-3 group-hover:scale-110 transition-transform">🎓</div>
          <h3 class="text-xs font-bold text-slate-700 dark:text-neutral-200 uppercase tracking-wider">Pendidikan</h3>
        </a>
        <a href="/admin/cms/skills" class="neu-flat rounded-2xl p-4 text-center group hover:-translate-y-1 transition-all cursor-pointer">
          <div class="w-10 h-10 mx-auto rounded-full neu-pressed flex items-center justify-center text-[#E9582A] mb-3 group-hover:scale-110 transition-transform">⚡</div>
          <h3 class="text-xs font-bold text-slate-700 dark:text-neutral-200 uppercase tracking-wider">Skill / Posisi</h3>
        </a>
        <a href="/admin/cms/articles" class="neu-flat rounded-2xl p-4 text-center group hover:-translate-y-1 transition-all cursor-pointer">
          <div class="w-10 h-10 mx-auto rounded-full neu-pressed flex items-center justify-center text-[#E9582A] mb-3 group-hover:scale-110 transition-transform">📝</div>
          <h3 class="text-xs font-bold text-slate-700 dark:text-neutral-200 uppercase tracking-wider">Artikel</h3>
        </a>
        <a href="/admin/cms/achievements" class="neu-flat rounded-2xl p-4 text-center group hover:-translate-y-1 transition-all cursor-pointer">
          <div class="w-10 h-10 mx-auto rounded-full neu-pressed flex items-center justify-center text-[#E9582A] mb-3 group-hover:scale-110 transition-transform">🏆</div>
          <h3 class="text-xs font-bold text-slate-700 dark:text-neutral-200 uppercase tracking-wider">Pencapaian</h3>
        </a>
        <a href="/admin/cms/certificates" class="neu-flat rounded-2xl p-4 text-center group hover:-translate-y-1 transition-all cursor-pointer">
          <div class="w-10 h-10 mx-auto rounded-full neu-pressed flex items-center justify-center text-[#E9582A] mb-3 group-hover:scale-110 transition-transform">📜</div>
          <h3 class="text-xs font-bold text-slate-700 dark:text-neutral-200 uppercase tracking-wider">Pelatihan / Sert.</h3>
        </a>
        <a href="/admin/projects" class="neu-flat rounded-2xl p-4 text-center group hover:-translate-y-1 transition-all cursor-pointer">
          <div class="w-10 h-10 mx-auto rounded-full neu-pressed flex items-center justify-center text-[#E9582A] mb-3 group-hover:scale-110 transition-transform">🚀</div>
          <h3 class="text-xs font-bold text-slate-700 dark:text-neutral-200 uppercase tracking-wider">Proyek Web</h3>
        </a>
      </div>
    </div>


  </div>

  <script>
    // Logout Handler
    document.getElementById("logoutBtn")?.addEventListener("click", async () => {
      await fetch("/api/auth/logout", { method: "POST" });
      window.location.href = "/admin/login";
    });

  </script>
</AdminLayout>
