---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="Admin Panel - Upload Portofolio">
  <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="bg-white dark:bg-gray-800 shadow-xl rounded-2xl p-8 border border-gray-100 dark:border-gray-700">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Admin Panel</h1>
      <p class="text-gray-600 dark:text-gray-300 mb-8">
        Halaman ini digunakan untuk mengunggah proyek baru langsung ke Firebase Firestore & Storage.
      </p>

      <form id="uploadForm" class="space-y-6">
        <!-- Pilihan Koleksi -->
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Tipe Konten</label>
          <select id="collectionName" class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-3 border">
            <option value="projects">Projects</option>
            <option value="articles">Articles</option>
            <option value="experiences">Experiences</option>
          </select>
        </div>

        <!-- Judul -->
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Judul</label>
          <input type="text" id="title" required class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-3 border" placeholder="Judul Proyek / Artikel">
        </div>

        <!-- Deskripsi/Konten -->
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Deskripsi / Konten</label>
          <textarea id="description" required rows="4" class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-3 border" placeholder="Tuliskan deskripsi di sini..."></textarea>
        </div>

        <!-- File Upload -->
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Gambar Cover</label>
          <input type="file" id="imageFile" accept="image/*" class="mt-1 block w-full text-sm text-gray-900 dark:text-gray-300 border border-gray-300 dark:border-gray-600 rounded-md cursor-pointer bg-gray-50 dark:bg-gray-700 focus:outline-none p-2">
        </div>

        <button type="submit" id="submitBtn" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
          Unggah ke Firebase
        </button>
      </form>
      
      <!-- Status Message -->
      <div id="statusMessage" class="mt-4 hidden p-4 rounded-md"></div>
    </div>
  </div>
</MainLayout>

<script>
  import { db, storage } from "../../firebase/client";
  import { collection, addDoc } from "firebase/firestore";
  import { ref, uploadBytesResumable, getDownloadURL } from "firebase/storage";

  const form = document.getElementById("uploadForm") as HTMLFormElement;
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
  const statusMessage = document.getElementById("statusMessage");

  function showStatus(message: string, isError = false) {
    if (!statusMessage) return;
    statusMessage.textContent = message;
    statusMessage.classList.remove("hidden", "bg-green-50", "text-green-800", "bg-red-50", "text-red-800");
    
    if (isError) {
      statusMessage.classList.add("bg-red-50", "text-red-800");
    } else {
      statusMessage.classList.add("bg-green-50", "text-green-800");
    }
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = "Mengunggah...";
    showStatus("Memproses unggahan...");

    const collectionName = (document.getElementById("collectionName") as HTMLSelectElement).value;
    const title = (document.getElementById("title") as HTMLInputElement).value;
    const description = (document.getElementById("description") as HTMLTextAreaElement).value;
    const imageInput = document.getElementById("imageFile") as HTMLInputElement;
    const file = imageInput.files?.[0];

    try {
      let imageUrl = "";

      // 1. Upload Gambar ke Storage jika ada
      if (file) {
        const storageRef = ref(storage, `${collectionName}/${Date.now()}_${file.name}`);
        showStatus("Mengunggah gambar ke Firebase Storage...");
        
        const snapshot = await uploadBytesResumable(storageRef, file);
        imageUrl = await getDownloadURL(snapshot.ref);
      }

      // 2. Simpan Data ke Firestore
      showStatus("Menyimpan data ke Firestore...");
      await addDoc(collection(db, collectionName), {
        title,
        description,
        body: description,
        image: imageUrl,
        photos: imageUrl ? [imageUrl] : [],
        createdAt: new Date().toISOString()
      });

      showStatus("✅ Berhasil diunggah ke Firebase!");
      form.reset();
    } catch (error) {
      console.error(error);
      showStatus(`❌ Gagal: ${(error as Error).message}`, true);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Unggah ke Firebase";
    }
  });
</script>
