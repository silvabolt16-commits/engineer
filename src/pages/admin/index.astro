---
import { isAuthenticated } from "../../lib/auth";
import { getDB, getAllProjects } from "../../lib/d1";

if (!isAuthenticated(Astro)) {
  return Astro.redirect("/admin/login");
}

const db = getDB(Astro.locals);
const projects = await getAllProjects(db);
---

<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Admin Portofolio</title>
  <style>
    body {
      background-color: #0f172a;
      color: #f8fafc;
      font-family: system-ui, -apple-system, sans-serif;
    }
  </style>
</head>
<body class="min-h-screen pb-12">
  <!-- Header -->
  <header class="border-b border-slate-800 bg-slate-900/50 backdrop-blur sticky top-0 z-10">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <div>
        <h1 class="text-xl font-bold bg-gradient-to-r from-blue-400 to-indigo-400 bg-clip-text text-transparent">
          Dashboard Admin
        </h1>
        <p class="text-xs text-slate-400">Cloudflare D1 & Cloudinary Storage</p>
      </div>

      <div class="flex items-center space-x-4">
        <a href="/" target="_blank" class="text-sm text-slate-300 hover:text-white transition">Lihat Web ↗</a>
        <button id="logoutBtn" class="px-4 py-2 text-sm text-red-400 hover:text-red-300 bg-red-950/40 hover:bg-red-900/50 border border-red-800/50 rounded-xl transition">
          Keluar
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-6xl mx-auto px-6 pt-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold text-slate-100">Daftar Proyek Portofolio</h2>
        <p class="text-sm text-slate-400">Total: {projects.length} Proyek di Database D1</p>
      </div>

      <a
        href="/admin/projects/new"
        class="inline-flex items-center px-4 py-2.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-500 rounded-xl shadow-lg transition"
      >
        + Tambah Proyek Baru
      </a>
    </div>

    <!-- Projects Grid / Table -->
    {projects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) => (
          <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-lg flex flex-col justify-between">
            <div>
              {project.image_url ? (
                <img src={project.image_url} alt={project.title} class="w-full h-44 object-cover border-b border-slate-800" />
              ) : (
                <div class="w-full h-44 bg-slate-800 flex items-center justify-center text-slate-500 text-sm">
                  Tidak Ada Gambar
                </div>
              )}

              <div class="p-5">
                <div class="flex items-center justify-between mb-2">
                  <span class="px-2.5 py-1 text-xs font-semibold text-blue-400 bg-blue-950/60 border border-blue-800/50 rounded-full">
                    {project.category || 'Web'}
                  </span>
                  {project.featured ? (
                    <span class="px-2.5 py-1 text-xs font-semibold text-amber-400 bg-amber-950/60 border border-amber-800/50 rounded-full">
                      ★ Featured
                    </span>
                  ) : null}
                </div>

                <h3 class="text-lg font-bold text-slate-100 mb-2">{project.title}</h3>
                <p class="text-sm text-slate-400 line-clamp-2 mb-4">{project.description}</p>
              </div>
            </div>

            <div class="p-5 pt-0 flex items-center justify-between border-t border-slate-800/60 mt-2 pt-4">
              <a
                href={`/admin/projects/${project.id}/edit`}
                class="text-sm text-blue-400 hover:text-blue-300 font-medium"
              >
                Edit Data
              </a>

              <button
                data-id={project.id}
                class="deleteBtn text-sm text-red-400 hover:text-red-300 font-medium"
              >
                Hapus
              </button>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-slate-900/50 border border-slate-800 rounded-2xl">
        <p class="text-slate-400 mb-4">Belum ada proyek di database Cloudflare D1 Anda.</p>
        <a
          href="/admin/projects/new"
          class="inline-block px-5 py-2.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-500 rounded-xl"
        >
          Buat Proyek Pertama
        </a>
      </div>
    )}
  </main>

  <script>
    // Logout Handler
    document.getElementById("logoutBtn")?.addEventListener("click", async () => {
      await fetch("/api/auth/logout", { method: "POST" });
      window.location.href = "/admin/login";
    });

    // Delete Handlers
    document.querySelectorAll(".deleteBtn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const id = (e.target as HTMLElement).getAttribute("data-id");
        if (confirm("Apakah Anda yakin ingin menghapus proyek ini?")) {
          const res = await fetch(`/api/projects/${id}`, { method: "DELETE" });
          if (res.ok) {
            window.location.reload();
          } else {
            alert("Gagal menghapus proyek.");
          }
        }
      });
    });
  </script>
</body>
</html>
