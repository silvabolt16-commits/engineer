---
export const prerender = false;
import { isAuthenticated } from "../../../../lib/auth";
import { getDB, getAllFromTable } from "../../../../lib/d1";
import AdminLayout from "../../../../layouts/AdminLayout.astro";

if (!isAuthenticated(Astro)) {
  return Astro.redirect("/admin/login");
}

const table = Astro.params.table as string;
const allowedTables = ['experiences', 'certificates', 'achievements', 'articles', 'skills', 'education'];

if (!allowedTables.includes(table)) {
  return Astro.redirect("/admin");
}

const db = getDB(Astro.locals);
const items = await getAllFromTable(db, table);
---

<AdminLayout title={`Kelola ${table} | Admin`}>
  <div class="max-w-6xl mx-auto py-12 px-6">
    <div class="mb-10">
      <a href="/admin" class="text-sm font-bold text-slate-500 dark:text-neutral-400 hover:text-[#E9582A] uppercase tracking-wider transition-colors">&larr; Kembali ke Dashboard</a>
      <h1 class="text-3xl font-extrabold text-slate-800 dark:text-white mt-4 uppercase tracking-widest">
        Kelola <span class="text-[#E9582A] capitalize">{table}</span>
      </h1>
    </div>

    <div class="flex items-center justify-between mb-8 border-b border-slate-200 dark:border-slate-800 pb-2">
      <h2 class="text-lg font-bold text-slate-800 dark:text-white uppercase tracking-widest">Daftar {table}</h2>
      <a href={`/admin/cms/${table}/new`} class="px-4 py-2 bg-[#E9582A] hover:bg-[#d04a1f] text-white font-bold rounded-xl shadow-md transition-all text-[10px] uppercase tracking-wider">
        + Tambah Baru
      </a>
    </div>

    {items.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {items.map((item: any) => (
          <div class="neu-flat rounded-3xl overflow-hidden flex flex-col justify-between group transition-all p-6">
            <div>
              <h3 class="text-xl font-bold text-slate-800 dark:text-white mb-2">{item.title || item.institution || item.category || item.name || item.slug}</h3>
              <p class="text-sm text-slate-500 dark:text-neutral-400 line-clamp-2">{item.description || item.summary || item.degree || item.company}</p>
            </div>
            
            <div class="pt-6 mt-4 border-t border-slate-200 dark:border-slate-800 flex justify-between items-center">
              <a href={`/admin/cms/${table}/${item.id}/edit`} class="px-5 py-2.5 neu-flat rounded-xl text-xs font-bold text-slate-700 dark:text-neutral-200 hover:text-[#E9582A] dark:hover:text-[#E9582A] neu-flat-hover transition-all uppercase tracking-wider">Edit</a>
              <button data-id={item.id} class="deleteBtn px-5 py-2.5 neu-pressed rounded-xl text-xs font-bold text-red-500 hover:text-red-600 transition-all uppercase tracking-wider">Hapus</button>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-20 neu-flat rounded-3xl mt-12">
        <p class="text-slate-500 dark:text-neutral-400 mb-6 font-medium">Belum ada data di tabel {table}.</p>
        <a
          href={`/admin/cms/${table}/new`}
          class="inline-block px-8 py-4 bg-[#E9582A] hover:bg-[#d04a1f] text-white font-bold rounded-xl shadow-md transition-all text-sm uppercase tracking-wider"
        >
          Buat {table} Pertama
        </a>
      </div>
    )}
  </div>

  <script define:vars={{ table }}>
    document.querySelectorAll(".deleteBtn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const id = e.target.getAttribute("data-id");
        if (confirm("Yakin ingin menghapus?")) {
          const res = await fetch(`/api/cms/${table}/${id}`, { method: "DELETE" });
          if (res.ok) window.location.reload();
          else alert("Gagal menghapus.");
        }
      });
    });
  </script>
</AdminLayout>
