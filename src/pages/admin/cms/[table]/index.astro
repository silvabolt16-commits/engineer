---
export const prerender = false;
import { isAuthenticated } from "../../../../lib/auth";
import { getDB, getAllFromTable } from "../../../../lib/d1";
import AdminLayout from "../../../../layouts/AdminLayout.astro";

if (!isAuthenticated(Astro)) {
  return Astro.redirect("/admin/login");
}

const table = Astro.params.table as string;
const allowedTables = ['experiences', 'certificates', 'achievements', 'articles', 'skills', 'education'];

const TABLE_NAMES: Record<string, string> = {
  experiences: 'Pengalaman',
  certificates: 'Sertifikat',
  achievements: 'Pencapaian',
  articles: 'Artikel',
  skills: 'Keahlian',
  education: 'Pendidikan'
};
const tableName = TABLE_NAMES[table] || table;

if (!allowedTables.includes(table)) {
  return Astro.redirect("/admin");
}

const db = getDB(Astro.locals);
const items = await getAllFromTable(db, table);
---

<AdminLayout title={`Kelola ${tableName} | Admin`}>
  <div class="max-w-6xl mx-auto pt-6 pb-6 md:pt-10 md:pb-8 px-6">
    <div class="mb-10">
      <h1 class="text-3xl font-extrabold text-slate-800 dark:text-white mt-4 uppercase tracking-widest">
        Kelola <span class="text-[#E9582A] capitalize">{tableName}</span>
      </h1>
    </div>

    <div class="flex items-center justify-between mb-8 border-b border-slate-200 dark:border-slate-800 pb-2">
      <h2 class="text-lg font-bold text-slate-800 dark:text-white uppercase tracking-widest">Daftar {tableName}</h2>
      <a href={`/admin/cms/${table}/new`} title="Tambah Baru" class="w-10 h-10 bg-[#E9582A] hover:bg-[#d04a1f] text-white rounded-xl shadow-md transition-all flex items-center justify-center">
        <span class="material-symbols-outlined text-[20px]">add</span>
      </a>
    </div>

    {items.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {items.map((item: any) => (
          <div class="neu-flat rounded-3xl overflow-hidden flex flex-col justify-between group transition-all p-6">
            <div>
              <h3 class="text-xl font-bold text-slate-800 dark:text-white mb-2">{item.title || item.institution || item.category || item.name || item.slug}</h3>
              <p class="text-sm text-slate-500 dark:text-neutral-400 line-clamp-2">{item.description || item.summary || item.degree || item.company}</p>
            </div>
            
            <div class="pt-6 mt-4 border-t border-slate-200 dark:border-slate-800 flex justify-between items-center">
              <a href={`/admin/cms/${table}/${item.id}/edit`} title="Edit" class="w-10 h-10 flex items-center justify-center neu-flat rounded-xl text-slate-700 dark:text-neutral-200 hover:text-[#E9582A] dark:hover:text-[#E9582A] neu-flat-hover transition-all">
                <span class="material-symbols-outlined text-[18px]">edit</span>
              </a>
              <button data-id={item.id} title="Hapus" class="deleteBtn w-10 h-10 flex items-center justify-center neu-pressed rounded-xl text-red-500 hover:text-red-600 transition-all">
                <span class="material-symbols-outlined text-[18px] pointer-events-none">delete</span>
              </button>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-20 neu-flat rounded-3xl mt-12">
        <p class="text-slate-500 dark:text-neutral-400 mb-6 font-medium">Belum ada data di tabel {tableName}.</p>
        <a href={`/admin/cms/${table}/new`} title="Buat Baru" class="inline-flex w-16 h-16 bg-[#E9582A] hover:bg-[#d04a1f] text-white rounded-2xl shadow-md transition-all flex items-center justify-center">
          <span class="material-symbols-outlined text-[32px]">add</span>
        </a>
      </div>
    )}
  </div>

  <script define:vars={{ table }}>
    document.querySelectorAll(".deleteBtn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const id = e.target.getAttribute("data-id");
        if (confirm("Yakin ingin menghapus?")) {
          const res = await fetch(`/api/cms/${table}/${id}`, { method: "DELETE" });
          if (res.ok) window.location.reload();
          else alert("Gagal menghapus.");
        }
      });
    });
  </script>
</AdminLayout>
