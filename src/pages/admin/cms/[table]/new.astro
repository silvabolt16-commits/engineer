---
export const prerender = false;
import { isAuthenticated } from "../../../../lib/auth";
import AdminLayout from "../../../../layouts/AdminLayout.astro";

if (!isAuthenticated(Astro)) {
  return Astro.redirect("/admin/login");
}

const table = Astro.params.table as string;

const TABLE_SCHEMA: Record<string, string[]> = {
  experiences: ['slug', 'title', 'title_en', 'company', 'company_en', 'duration', 'photos', 'body', 'body_en'],
  certificates: ['slug', 'title', 'title_en', 'date', 'issuer', 'issuer_en', 'description', 'description_en', 'link', 'body', 'body_en'],
  achievements: ['slug', 'title', 'title_en', 'date', 'issuer', 'issuer_en', 'description', 'description_en', 'image', 'body', 'body_en'],
  articles: ['slug', 'title', 'title_en', 'date', 'category', 'category_en', 'summary', 'summary_en', 'image', 'body', 'body_en'],
  skills: ['category', 'category_en', 'items', 'items_en'],
  education: ['institution', 'institution_en', 'degree', 'degree_en', 'duration', 'achievements', 'achievements_en']
};

const TABLE_NAMES: Record<string, string> = {
  experiences: 'Pengalaman',
  certificates: 'Sertifikat',
  achievements: 'Pencapaian',
  articles: 'Artikel',
  skills: 'Keahlian',
  education: 'Pendidikan'
};
const tableName = TABLE_NAMES[table] || table;

const COLUMN_NAMES: Record<string, string> = {
  title: 'Judul',
  title_en: 'Judul (EN)',
  company: 'Perusahaan',
  company_en: 'Perusahaan (EN)',
  duration: 'Durasi',
  duration_en: 'Durasi (EN)',
  details: 'Detail (JSON)',
  details_en: 'Detail (JSON) (EN)',
  photos: 'Foto',
  body: 'Konten Utama',
  body_en: 'Konten Utama (EN)',
  date: 'Tanggal',
  issuer: 'Penerbit',
  issuer_en: 'Penerbit (EN)',
  description: 'Deskripsi Singkat',
  description_en: 'Deskripsi Singkat (EN)',
  link: 'Tautan (URL)',
  image: 'Gambar',
  category: 'Kategori',
  category_en: 'Kategori (EN)',
  summary: 'Ringkasan',
  summary_en: 'Ringkasan (EN)',
  items: 'Item (JSON)',
  items_en: 'Item (JSON) (EN)',
  institution: 'Institusi',
  institution_en: 'Institusi (EN)',
  degree: 'Gelar',
  degree_en: 'Gelar (EN)',
  achievements: 'Pencapaian (JSON)',
  achievements_en: 'Pencapaian Pendidikan (JSON) (EN)',
  slug: 'Slug (Otomatis)'
};

const schema = TABLE_SCHEMA[table];

if (!schema) {
  return Astro.redirect("/admin");
}

const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME || "";
const uploadPreset = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET || "";

const formData: any = {};
for (const col of schema) {
  formData[col] = '';
}
---

<AdminLayout title={`Tambah ${tableName} | Admin`}>
  <div class="max-w-4xl mx-auto pt-6 pb-6 md:pt-10 md:pb-8 px-6">
    <div class="mb-10">
      <h1 class="text-3xl font-extrabold text-slate-800 dark:text-white mt-4 uppercase tracking-widest">
        Tambah <span class="text-[#E9582A] capitalize">{tableName}</span>
      </h1>
    </div>

    <div class="neu-flat rounded-3xl p-8 md:p-10">
      <form id="editForm" class="space-y-8">
        {schema.map((col) => {
          if (col === 'slug' || col === 'details') {
            return <input type="hidden" name={col} value="" />;
          }
          if (col === 'photos' || col === 'image' || col === 'link') {
            const isMultiple = col === 'photos';
            return (
              <div class="p-6 neu-pressed rounded-2xl space-y-4">
                <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider">{COLUMN_NAMES[col] || col} (Unggah)</label>
                <div class="flex flex-col sm:flex-row items-center gap-4">
                  <input type="file" id={`${col}FileInput`} accept="image/*" multiple={isMultiple} class="w-full sm:w-auto text-sm text-slate-600 dark:text-neutral-300 file:mr-4 file:py-2.5 file:px-5 file:rounded-xl file:border-0 file:text-xs file:font-bold file:uppercase file:tracking-wider file:bg-[#E9582A] file:text-white hover:file:bg-[#d04a1f] cursor-pointer transition-colors" />
                </div>
                <div id={`${col}UploadStatus`} class="text-xs font-bold hidden uppercase tracking-wider mt-2"></div>
                <textarea name={col} id={`${col}HiddenInput`} class="hidden">{formData[col]}</textarea>
                <div id={`${col}PreviewContainer`} class="flex flex-wrap gap-4 mt-4"></div>
              </div>
            );
          }
          
          if (col === 'duration' || col === 'date') {
            return (
              <div>
                <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">{col === 'duration' ? 'Duration' : 'Date'} (Bulan Mulai - Bulan Selesai)</label>
                <div class="flex items-center gap-2">
                  <input type="month" id="durationStart" class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
                  <span class="text-slate-500 font-bold">-</span>
                  <input type="month" id="durationEnd" class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
                  <div class="flex items-center ml-2 shrink-0">
                    <input type="checkbox" id="durationPresent" class="w-4 h-4 rounded text-[#E9582A] focus:ring-[#E9582A]" />
                    <label for="durationPresent" class="ml-1 text-xs font-bold text-slate-500 cursor-pointer">Sekarang</label>
                  </div>
                </div>
                <input type="hidden" name={col} id="durationHidden" value="" />
              </div>
            );
          }

          return (
            <div>
              <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">{COLUMN_NAMES[col] || col}</label>
              {col === 'body' || col === 'body_en' || col === 'description' || col === 'description_en' || col === 'summary' || col === 'summary_en' || col === 'details' || col === 'details_en' || col === 'items' || col === 'items_en' || col === 'achievements' || col === 'achievements_en' ? (
                <textarea
                  name={col}
                  rows={col === 'body' ? 8 : 4}
                  class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition"
                >{formData[col]}</textarea>
              ) : (
                <input
                  type="text"
                  name={col}
                  value={formData[col]}
                  class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition"
                />
              )}
              {(col === 'details' || col === 'details_en' || col === 'items' || col === 'items_en' || col === 'achievements' || col === 'achievements_en') && (
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-2">Pisahkan setiap item dengan baris baru (Enter).</p>
              )}
            </div>
          );
        })}

        <div class="pt-6 border-t border-slate-200 dark:border-slate-800 flex justify-end">
          <button
            type="submit"
            id="submitBtn"
            class="px-8 py-4 bg-[#E9582A] hover:bg-[#d04a1f] text-white font-bold rounded-xl shadow-md transition-all text-sm uppercase tracking-wider"
          >
            Simpan Data
          </button>
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ table, schema, cloudName, uploadPreset }}>

    // Handle duration inputs
    const durationStart = document.getElementById('durationStart');
    const durationEnd = document.getElementById('durationEnd');
    const durationPresent = document.getElementById('durationPresent');
    const durationHidden = document.getElementById('durationHidden');
    
    if (durationPresent && durationEnd) {
      durationPresent.addEventListener('change', (e) => {
        if (e.target.checked) {
          durationEnd.value = '';
          durationEnd.disabled = true;
          durationEnd.classList.add('opacity-50', 'cursor-not-allowed');
        } else {
          durationEnd.disabled = false;
          durationEnd.classList.remove('opacity-50', 'cursor-not-allowed');
        }
      });
    }

    ['photos', 'image', 'link'].forEach(colId => {
      const fileInput = document.getElementById(`${colId}FileInput`);
      const hiddenInput = document.getElementById(`${colId}HiddenInput`);
      const statusText = document.getElementById(`${colId}UploadStatus`);
      const previewContainer = document.getElementById(`${colId}PreviewContainer`);
      const isMultiple = colId === 'photos';

      if (!fileInput) return;

      const renderPreview = () => {
        previewContainer.innerHTML = '';
        const val = hiddenInput.value.trim();
        if (!val) return;
        const urls = isMultiple ? val.split('\n') : [val];
        urls.forEach(url => {
          if(!url) return;
          const wrapper = document.createElement('div');
          wrapper.className = "relative inline-block group";
          
          const img = document.createElement('img');
          img.src = url;
          img.className = "w-32 h-32 object-cover rounded-xl border-2 border-slate-300 dark:border-slate-700";
          
          const delBtn = document.createElement('button');
          delBtn.innerHTML = '&times;';
          delBtn.className = "absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center text-sm font-bold shadow-md opacity-0 group-hover:opacity-100 transition-opacity hover:bg-red-600 focus:outline-none cursor-pointer";
          delBtn.title = "Hapus Gambar";
          delBtn.onclick = async (e) => {
            e.preventDefault();
            
            // Delete from Cloudinary
            if (url.includes('cloudinary')) {
              try {
                delBtn.innerHTML = '...';
                delBtn.disabled = true;
                const res = await fetch('/api/cloudinary/delete', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ url })
                });
                const json = await res.json();
                if (!res.ok) {
                   console.error("Gagal menghapus dari Cloudinary:", json.error);
                   alert("Gagal menghapus permanen: " + json.error);
                } else {
                   console.log("Berhasil dihapus dari server Cloudinary!");
                }
              } catch(e) {}
            }

            // Remove from hidden input
            let currentUrls = [];
            try {
              currentUrls = hiddenInput.value ? JSON.parse(hiddenInput.value) : [];
            } catch(e) {
              currentUrls = hiddenInput.value ? hiddenInput.value.split('\n').filter(Boolean) : [];
            }
            if (!Array.isArray(currentUrls)) currentUrls = [currentUrls];
            
            currentUrls = currentUrls.filter(u => u !== url);
            hiddenInput.value = isMultiple ? currentUrls.join('\n') : '';
            renderPreview();
          };

          wrapper.appendChild(img);
          wrapper.appendChild(delBtn);
          previewContainer.appendChild(wrapper);
        });
      };
      renderPreview();

      fileInput.addEventListener("change", async (e) => {
        const files = Array.from(e.target.files);
        if (files.length === 0) return;

        if (!cloudName || !uploadPreset) {
          alert("Konfigurasi Cloudinary belum diset di environment variable.");
          return;
        }

        statusText.textContent = "Memproses gambar...";
        statusText.classList.remove("hidden");
        statusText.classList.add("text-[#E9582A]");
        statusText.classList.remove("text-green-500", "text-red-500");

        let uploadedUrls = [];

        try {
          for (const file of files) {
            const compressedFile = await new Promise((resolve) => {
              if (!file.type.match(/image.*/)) { resolve(file); return; }
              const reader = new FileReader();
              reader.onload = (event) => {
                const img = new Image();
                img.onload = () => {
                  const canvas = document.createElement('canvas');
                  let width = img.width, height = img.height;
                  const MAX_SIZE = 1920;
                  if (width > height && width > MAX_SIZE) {
                    height *= MAX_SIZE / width; width = MAX_SIZE;
                  } else if (height > MAX_SIZE) {
                    width *= MAX_SIZE / height; height = MAX_SIZE;
                  }
                  canvas.width = width; canvas.height = height;
                  const ctx = canvas.getContext('2d');
                  ctx.drawImage(img, 0, 0, width, height);
                  canvas.toBlob(blob => {
                    resolve(new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".webp", { type: 'image/webp' }));
                  }, 'image/webp', 0.85);
                };
                img.src = event.target.result;
              };
              reader.readAsDataURL(file);
            });

            statusText.textContent = "Mengunggah gambar...";
            const formData = new FormData();
            formData.append("file", compressedFile);
            formData.append("upload_preset", uploadPreset);

            const res = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, {
              method: "POST",
              body: formData
            });

            if (!res.ok) throw new Error("Upload gagal");
            const result = await res.json();
            uploadedUrls.push(result.secure_url);
          }

          if (isMultiple) {
            const currentUrls = hiddenInput.value ? hiddenInput.value.split('\n').filter(Boolean) : [];
            hiddenInput.value = [...currentUrls, ...uploadedUrls].join('\n');
          } else {
            hiddenInput.value = uploadedUrls[0];
          }

          statusText.textContent = "Berhasil diunggah!";
          statusText.classList.replace("text-[#E9582A]", "text-green-500");
          renderPreview();
        } catch(err) {
          statusText.textContent = "Error: " + err.message;
          statusText.classList.replace("text-[#E9582A]", "text-red-500");
        }
      });
    });

    document.getElementById("editForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById("submitBtn");
      
      if (durationHidden && durationStart) {
        const start = durationStart.value;
        const end = durationPresent.checked ? 'present' : durationEnd.value;
        if (start) {
          durationHidden.value = `${start}|${end}`;
        }
      }

      submitBtn.innerText = "Menyimpan...";
      submitBtn.disabled = true;

      const formData = new FormData(e.target);
      const data = {};
      
      schema.forEach(col => {
        let val = formData.get(col);
        
        if (col === 'slug') {
          if (!val) {
             const baseStr = formData.get('title') || formData.get('institution') || formData.get('category') || Date.now().toString();
             val = baseStr.toString().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
          }
        }

        if (col === 'details' || col === 'photos' || col === 'items' || col === 'achievements') {
          data[col] = val ? val.split('\n').map(s => s.trim()).filter(s => s) : [];
        } else {
          data[col] = val;
        }
      });

      try {
        const res = await fetch(`/api/cms/${table}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data)
        });

        if (res.ok) {
          alert("Berhasil ditambahkan!");
          window.location.href = `/admin/cms/${table}`;
        } else {
          const err = await res.json();
          alert("Gagal: " + (err.error || 'Terjadi kesalahan'));
        }
      } catch (err) {
        alert("Gagal menyimpan data.");
      } finally {
        submitBtn.innerText = "Simpan Data";
        submitBtn.disabled = false;
      }
    });
  </script>
</AdminLayout>
