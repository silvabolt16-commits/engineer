---
export const prerender = false;
import { isAuthenticated } from "../../../lib/auth";
import { getDB, getAllFromTable } from "../../../lib/d1";
import AdminLayout from "../../../layouts/AdminLayout.astro";

if (!isAuthenticated(Astro)) {
  return Astro.redirect("/admin/login");
}

const db = getDB(Astro.locals);
const documents = await getAllFromTable(db, 'documents');
---

<AdminLayout title="Kelola Dokumen Pribadi | Admin">
  <div class="max-w-6xl mx-auto pt-6 pb-6 md:pt-10 md:pb-8 px-6">
    <div class="mb-10">
      <h1 class="text-3xl font-extrabold text-slate-800 dark:text-white mt-4 uppercase tracking-widest">
        Kelola <span class="text-[#E9582A]">Dokumen Pribadi</span>
      </h1>
      <p class="text-sm text-slate-500 dark:text-neutral-400 mt-2">Upload dan kelola dokumen penting seperti CV, Ijazah, KK (Hanya dapat diakses oleh Admin).</p>
    </div>

    <div class="flex items-center justify-between mb-8 border-b border-slate-200 dark:border-slate-800 pb-2">
      <h2 class="text-lg font-bold text-slate-800 dark:text-white uppercase tracking-widest">Daftar Dokumen</h2>
      <a href="/admin/documents/new" class="px-4 py-2 bg-[#E9582A] hover:bg-[#d04a1f] text-white font-bold rounded-xl shadow-md transition-all text-[10px] uppercase tracking-wider">
        + Upload Dokumen
      </a>
    </div>

    {documents.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {documents.map((doc: any) => (
          <div class="neu-flat rounded-3xl overflow-hidden flex flex-col justify-between group transition-all p-6">
            <div>
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-full neu-pressed flex items-center justify-center text-[#E9582A] text-xl">
                  {doc.file_url?.toLowerCase().endsWith('.pdf') ? '📄' : '🖼️'}
                </div>
                <div>
                  <h3 class="text-lg font-bold text-slate-800 dark:text-white leading-tight">{doc.title}</h3>
                  <p class="text-xs text-slate-500 dark:text-neutral-400 font-bold uppercase tracking-wider mt-1">{doc.category || 'Lainnya'}</p>
                </div>
              </div>
            </div>
            
            <div class="pt-6 mt-4 border-t border-slate-200 dark:border-slate-800 flex justify-between items-center">
              <a href={doc.file_url} target="_blank" class="px-5 py-2.5 neu-flat rounded-xl text-xs font-bold text-[#2a85ff] dark:text-[#60a5fa] hover:text-[#0056b3] dark:hover:text-[#93c5fd] neu-flat-hover transition-all uppercase tracking-wider">Lihat File</a>
              <button data-id={doc.id} class="deleteBtn px-5 py-2.5 neu-pressed rounded-xl text-xs font-bold text-red-500 hover:text-red-600 transition-all uppercase tracking-wider">Hapus</button>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-20 neu-flat rounded-3xl mt-12">
        <p class="text-slate-500 dark:text-neutral-400 mb-6 font-medium">Belum ada dokumen yang diupload.</p>
        <a
          href="/admin/documents/new"
          class="inline-block px-8 py-4 bg-[#E9582A] hover:bg-[#d04a1f] text-white font-bold rounded-xl shadow-md transition-all text-sm uppercase tracking-wider"
        >
          Upload Dokumen Pertama
        </a>
      </div>
    )}
  </div>

  <script>
    document.querySelectorAll(".deleteBtn").forEach((btn) => {
      btn.addEventListener("click", async (e: any) => {
        const id = e.target.getAttribute("data-id");
        if (confirm("Yakin ingin menghapus dokumen ini secara permanen? File di Cloudinary juga akan terhapus.")) {
          const res = await fetch(`/api/cms/documents/${id}`, { method: "DELETE" });
          if (res.ok) window.location.reload();
          else alert("Gagal menghapus dokumen.");
        }
      });
    });
  </script>
</AdminLayout>
