---
import { isAuthenticated } from "../../../../lib/auth";
import { getDB, getProjectById } from "../../../../lib/d1";
import AdminLayout from "../../../../layouts/AdminLayout.astro";

if (!isAuthenticated(Astro)) {
  return Astro.redirect("/admin/login");
}

const id = Number(Astro.params.id);
const db = getDB(Astro.locals);
const project = await getProjectById(db, id);

if (!project) {
  return Astro.redirect("/admin");
}

let cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME || "";
let uploadPreset = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET || "";

try {
  const runtimeEnv = (Astro.locals as any).runtime?.env;
  if (runtimeEnv?.PUBLIC_CLOUDINARY_CLOUD_NAME) cloudName = runtimeEnv.PUBLIC_CLOUDINARY_CLOUD_NAME;
  if (runtimeEnv?.PUBLIC_CLOUDINARY_UPLOAD_PRESET) uploadPreset = runtimeEnv.PUBLIC_CLOUDINARY_UPLOAD_PRESET;
} catch (e) {}
---

<AdminLayout title={`Edit Proyek: ${project.title} | Admin`}>
  <div class="max-w-4xl mx-auto pt-6 pb-6 md:pt-10 md:pb-8 px-6">
    <div class="mb-10">
      <h1 class="text-3xl font-extrabold text-slate-800 dark:text-white mt-4 uppercase tracking-widest">Edit<span class="text-[#E9582A]">Proyek</span>
      </h1>
      <p class="text-sm text-slate-500 dark:text-neutral-400 mt-2">{project.title}</p>
    </div>

    <div class="neu-flat rounded-3xl p-8 md:p-10">
      <form id="editProjectForm" class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Judul Proyek (ID) *</label>
            <input type="text" id="title" required value={project.title} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Project Title (EN) *</label>
            <input type="text" id="title_en" required value={project.title_en || ''} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Kategori (ID)</label>
            <input type="text" id="category" value={project.category || 'Web'} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Category (EN)</label>
            <input type="text" id="category_en" value={project.category_en || ''} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Tags (Dipisah Koma) (ID)</label>
            <input type="text" id="tags" value={project.tags || ''} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Tags (Comma Separated) (EN)</label>
            <input type="text" id="tags_en" value={project.tags_en || ''} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Duration / Date (Bulan Mulai - Bulan Selesai)</label>
          <div class="flex items-center gap-2">
            <input type="month" id="dateStart" class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
            <span class="text-slate-500 font-bold">-</span>
            <input type="month" id="dateEnd" class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
            <div class="flex items-center ml-2 shrink-0">
              <input type="checkbox" id="datePresent" class="w-4 h-4 rounded text-[#E9582A] focus:ring-[#E9582A]" />
              <label for="datePresent" class="ml-1 text-xs font-bold text-slate-500 cursor-pointer">Sekarang</label>
            </div>
          </div>
          <input type="hidden" id="dateHidden" value={project.date || ''} />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Deskripsi Singkat (ID) *</label>
            <textarea id="description" required rows="4" class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition">{project.description}</textarea>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Short Description (EN) *</label>
            <textarea id="description_en" required rows="4" class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition">{project.description_en || ''}</textarea>
          </div>
        </div>

        <!-- Cloudinary Upload / Image URL -->
        <div class="p-6 neu-pressed rounded-2xl space-y-4">
          <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider">Gambar Proyek (Upload)</label>
          
          <div class="flex flex-col sm:flex-row items-center gap-4">
            <input type="file" id="imageFile" accept="image/*" class="w-full sm:w-auto text-sm text-slate-600 dark:text-neutral-300 file:mr-4 file:py-2.5 file:px-5 file:rounded-xl file:border-0 file:text-xs file:font-bold file:uppercase file:tracking-wider file:bg-[#E9582A] file:text-white hover:file:bg-[#d04a1f] cursor-pointer transition-colors" />
            <input type="hidden" id="imageUrl" value={project.image_url || ''} />
          </div>

          <div id="uploadStatus" class="text-xs font-bold hidden uppercase tracking-wider mt-2"></div>
          {project.image_url ? (
            <img id="imagePreview" src={project.image_url} class="w-full h-56 object-cover rounded-xl mt-4 border-2 border-transparent neu-flat" alt="Preview Gambar" />
          ) : (
            <img id="imagePreview" class="hidden w-full h-56 object-cover rounded-xl mt-4 border-2 border-transparent neu-flat" alt="Preview Gambar" />
          )}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Link Demo / Live Website</label>
            <input type="url" id="demoUrl" value={project.demo_url || ''} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Link Repository (GitHub)</label>
            <input type="url" id="repoUrl" value={project.repo_url || ''} class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" />
          </div>
        </div>

        <div class="flex items-center space-x-3 pt-2">
          <input type="checkbox" id="featured" checked={Boolean(project.featured)} class="w-5 h-5 rounded text-[#E9582A] neu-pressed border-none focus:ring-[#E9582A] focus:ring-offset-0 bg-transparent" />
          <label for="featured" class="text-sm font-bold text-slate-600 dark:text-neutral-300">Tampilkan sebagai Proyek Unggulan (Featured)</label>
        </div>

        <div id="formAlert" class="hidden p-4 text-sm font-bold rounded-xl uppercase tracking-wider text-center"></div>

        <button type="submit" id="submitBtn" class="w-full py-4 mt-4 text-white font-bold bg-[#E9582A] hover:bg-[#d04a1f] rounded-xl shadow-md transition-all text-sm uppercase tracking-wider">
          Update Proyek
        </button>
      </form>
    </div>
  </div>

  <script define:vars={{ id, cloudName, uploadPreset }}>
    const imageFileInput = document.getElementById("imageFile");
    const imageUrlInput = document.getElementById("imageUrl");
    const imagePreview = document.getElementById("imagePreview");
    const uploadStatus = document.getElementById("uploadStatus");
    const form = document.getElementById("editProjectForm");
    const formAlert = document.getElementById("formAlert");
    const submitBtn = document.getElementById("submitBtn");
    const projectId = document.getElementById("projectId").value;

    const dateStart = document.getElementById('dateStart');
    const dateEnd = document.getElementById('dateEnd');
    const datePresent = document.getElementById('datePresent');
    const dateHidden = document.getElementById('dateHidden');

    if (dateHidden && dateHidden.value && dateHidden.value.includes('|')) {
      const [start, end] = dateHidden.value.split('|');
      if (dateStart) dateStart.value = start;
      if (end === 'present') {
        if (datePresent) datePresent.checked = true;
        if (dateEnd) {
          dateEnd.disabled = true;
          dateEnd.classList.add('opacity-50', 'cursor-not-allowed');
        }
      } else {
        if (dateEnd) dateEnd.value = end;
      }
    }

    if (datePresent && dateEnd) {
      datePresent.addEventListener('change', (e) => {
        if (e.target.checked) {
          dateEnd.value = '';
          dateEnd.disabled = true;
          dateEnd.classList.add('opacity-50', 'cursor-not-allowed');
        } else {
          dateEnd.disabled = false;
          dateEnd.classList.remove('opacity-50', 'cursor-not-allowed');
        }
      });
    }

    imageFileInput?.addEventListener("change", async (e) => {
      const fileInput = e.target.files[0];
      if (!fileInput) return;

      if (!cloudName || !uploadPreset) {
        alert("Konfigurasi Cloudinary belum diset di environment variable. Silakan tempel URL gambar langsung.");
        return;
      }

      uploadStatus.textContent = "Memproses dan kompresi gambar...";
      uploadStatus.classList.remove("hidden");
      uploadStatus.classList.add("text-[#E9582A]");
      uploadStatus.classList.remove("text-green-500", "text-red-500");

      // Client-side compression to WebP
      const compressImage = (file) => {
        return new Promise((resolve) => {
          if (!file.type.match(/image.*/)) {
            resolve(file); return;
          }
          const reader = new FileReader();
          reader.onload = (event) => {
            const img = new Image();
            img.onload = () => {
              const canvas = document.createElement('canvas');
              let width = img.width;
              let height = img.height;
              const MAX_SIZE = 1920;
              if (width > height && width > MAX_SIZE) {
                height *= MAX_SIZE / width;
                width = MAX_SIZE;
              } else if (height > MAX_SIZE) {
                width *= MAX_SIZE / height;
                height = MAX_SIZE;
              }
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext('2d');
              ctx.drawImage(img, 0, 0, width, height);
              canvas.toBlob((blob) => {
                const newFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".webp", {
                  type: 'image/webp',
                  lastModified: Date.now()
                });
                resolve(newFile);
              }, 'image/webp', 0.85);
            };
            img.src = event.target.result;
          };
          reader.readAsDataURL(file);
        });
      };

      const file = await compressImage(fileInput);

      uploadStatus.textContent = "Mengunggah gambar ke Cloudinary...";

      const formData = new FormData();
      formData.append("file", file);
      formData.append("upload_preset", uploadPreset);

      try {
        const res = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, {
          method: "POST",
          body: formData,
        });

        if (res.ok) {
          const data = await res.json();
          imageUrlInput.value = data.secure_url;
          imagePreview.src = data.secure_url;
          imagePreview.classList.remove("hidden");
          uploadStatus.textContent = "✓ Gambar berhasil diperbarui!";
          uploadStatus.classList.remove("text-[#E9582A]", "text-red-500");
          uploadStatus.classList.add("text-green-500");
        } else {
          uploadStatus.textContent = "Gagal mengunggah gambar.";
          uploadStatus.classList.remove("text-[#E9582A]", "text-green-500");
          uploadStatus.classList.add("text-red-500");
        }
      } catch (err) {
        uploadStatus.textContent = "Terjadi kesalahan saat upload gambar.";
        uploadStatus.classList.remove("text-[#E9582A]", "text-green-500");
        uploadStatus.classList.add("text-red-500");
      }
    });

    imageUrlInput?.addEventListener("input", () => {
      if (imageUrlInput.value) {
        imagePreview.src = imageUrlInput.value;
        imagePreview.classList.remove("hidden");
      }
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      formAlert.classList.add("hidden");
      if(submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Menyimpan...";
      }

      const payload = {
        title: document.getElementById("title").value,
        title_en: document.getElementById("title_en").value,
        category: document.getElementById("category").value,
        category_en: document.getElementById("category_en").value,
        tags: document.getElementById("tags").value,
        tags_en: document.getElementById("tags_en").value,
        description: document.getElementById("description").value,
        description_en: document.getElementById("description_en").value,
        image_url: imageUrlInput.value,
        demo_url: document.getElementById("demoUrl").value.trim(),
        repo_url: document.getElementById("repoUrl").value.trim(),
        featured: document.getElementById("featured").checked ? 1 : 0,
        date: ''
      };

      if (dateStart) {
        const start = dateStart.value;
        const end = datePresent.checked ? 'present' : dateEnd.value;
        if (start) {
          payload.date = `${start}|${end}`;
        }
      }

      try {
        const res = await fetch(`/api/projects/${projectId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          window.location.href = "/admin";
        } else {
          formAlert.textContent = data.error || "Gagal meng-update data";
          formAlert.className = "p-4 text-sm font-bold bg-red-100 text-red-600 border border-red-300 rounded-xl uppercase tracking-wider text-center";
          formAlert.classList.remove("hidden");
          if(submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Update Proyek";
          }
        }
      } catch (err) {
        formAlert.textContent = "Terjadi kesalahan koneksi";
        formAlert.className = "p-4 text-sm font-bold bg-red-100 text-red-600 border border-red-300 rounded-xl uppercase tracking-wider text-center";
        formAlert.classList.remove("hidden");
        if(submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Update Proyek";
        }
      }
    });
  </script>
</AdminLayout>
