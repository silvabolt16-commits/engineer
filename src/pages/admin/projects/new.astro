---
import { isAuthenticated } from "../../../lib/auth";

if (!isAuthenticated(Astro)) {
  return Astro.redirect("/admin/login");
}

const cloudName = Astro.locals.runtime?.env?.PUBLIC_CLOUDINARY_CLOUD_NAME || import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME || "";
const uploadPreset = Astro.locals.runtime?.env?.PUBLIC_CLOUDINARY_UPLOAD_PRESET || import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET || "";
---

<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tambah Proyek Baru - Admin</title>
  <style>
    body {
      background-color: #0f172a;
      color: #f8fafc;
      font-family: system-ui, -apple-system, sans-serif;
    }
  </style>
</head>
<body class="min-h-screen pb-16">
  <div class="max-w-3xl mx-auto px-6 pt-10">
    <div class="flex items-center justify-between mb-8">
      <div>
        <a href="/admin" class="text-sm text-blue-400 hover:text-blue-300">← Kembali ke Dashboard</a>
        <h1 class="text-2xl font-bold text-slate-100 mt-2">Tambah Proyek Portofolio</h1>
      </div>
    </div>

    <form id="createProjectForm" class="space-y-6 bg-slate-900 border border-slate-800 p-8 rounded-2xl shadow-xl">
      <div>
        <label class="block text-sm font-medium text-slate-300">Judul Proyek *</label>
        <input type="text" id="title" required class="w-full px-4 py-2.5 mt-1 bg-slate-800 border border-slate-700 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="Contoh: Aplikasi E-Commerce Mobile" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-slate-300">Kategori</label>
          <input type="text" id="category" class="w-full px-4 py-2.5 mt-1 bg-slate-800 border border-slate-700 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="Web / Mobile / AI / Cloud" value="Web" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-300">Tags (Dipisah Koma)</label>
          <input type="text" id="tags" class="w-full px-4 py-2.5 mt-1 bg-slate-800 border border-slate-700 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="Astro, React, Tailwind, Cloudflare" />
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-300">Deskripsi Singkat *</label>
        <textarea id="description" required rows="3" class="w-full px-4 py-2.5 mt-1 bg-slate-800 border border-slate-700 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="Penjelasan ringkas proyek ini..."></textarea>
      </div>

      <!-- Cloudinary Upload / Image URL -->
      <div class="p-5 bg-slate-950/60 border border-slate-800 rounded-xl space-y-4">
        <label class="block text-sm font-medium text-slate-200">Gambar Proyek (Cloudinary / Link Direct)</label>
        
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <input type="file" id="imageFile" accept="image/*" class="text-sm text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-500 cursor-pointer" />
          <span class="text-xs text-slate-500">atau</span>
          <input type="url" id="imageUrl" class="flex-1 w-full px-4 py-2 bg-slate-800 border border-slate-700 rounded-xl text-slate-100 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="https://res.cloudinary.com/... atau URL foto" />
        </div>

        <div id="uploadStatus" class="text-xs text-slate-400 hidden"></div>
        <img id="imagePreview" class="hidden w-full h-48 object-cover rounded-xl border border-slate-800 mt-2" alt="Preview Gambar" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-slate-300">Link Demo / Live Website</label>
          <input type="url" id="demoUrl" class="w-full px-4 py-2.5 mt-1 bg-slate-800 border border-slate-700 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="https://demo-app.com" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-300">Link Repository (GitHub)</label>
          <input type="url" id="repoUrl" class="w-full px-4 py-2.5 mt-1 bg-slate-800 border border-slate-700 rounded-xl text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="https://github.com/user/repo" />
        </div>
      </div>

      <div class="flex items-center space-x-3">
        <input type="checkbox" id="featured" class="w-5 h-5 rounded text-blue-600 bg-slate-800 border-slate-700 focus:ring-blue-500" />
        <label for="featured" class="text-sm font-medium text-slate-300">Tampilkan sebagai Proyek Unggulan (Featured)</label>
      </div>

      <div id="formAlert" class="hidden p-3 text-sm rounded-xl"></div>

      <button type="submit" id="submitBtn" class="w-full py-3 font-medium text-white bg-blue-600 hover:bg-blue-500 rounded-xl shadow-lg transition">
        Simpan Proyek
      </button>
    </form>
  </div>

  <script define:vars={{ cloudName, uploadPreset }}>
    const imageFileInput = document.getElementById("imageFile");
    const imageUrlInput = document.getElementById("imageUrl");
    const imagePreview = document.getElementById("imagePreview");
    const uploadStatus = document.getElementById("uploadStatus");
    const form = document.getElementById("createProjectForm");
    const formAlert = document.getElementById("formAlert");

    // Upload to Cloudinary direct from browser if file selected
    imageFileInput?.addEventListener("change", async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      if (!cloudName || !uploadPreset) {
        alert("Konfigurasi Cloudinary belum diset di environment variable. Silakan tempel URL gambar langsung.");
        return;
      }

      uploadStatus.textContent = "Mengunggah gambar ke Cloudinary...";
      uploadStatus.classList.remove("hidden");

      const formData = new FormData();
      formData.append("file", file);
      formData.append("upload_preset", uploadPreset);

      try {
        const res = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, {
          method: "POST",
          body: formData,
        });

        if (res.ok) {
          const data = await res.json();
          imageUrlInput.value = data.secure_url;
          imagePreview.src = data.secure_url;
          imagePreview.classList.remove("hidden");
          uploadStatus.textContent = "✓ Gambar berhasil diunggah!";
          uploadStatus.className = "text-xs text-green-400";
        } else {
          uploadStatus.textContent = "Gagal mengunggah gambar. Pastikan upload_preset valid.";
          uploadStatus.className = "text-xs text-red-400";
        }
      } catch (err) {
        uploadStatus.textContent = "Terjadi kesalahan saat upload gambar.";
        uploadStatus.className = "text-xs text-red-400";
      }
    });

    imageUrlInput?.addEventListener("input", () => {
      if (imageUrlInput.value) {
        imagePreview.src = imageUrlInput.value;
        imagePreview.classList.remove("hidden");
      }
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      formAlert.classList.add("hidden");

      const payload = {
        title: document.getElementById("title").value,
        category: document.getElementById("category").value,
        tags: document.getElementById("tags").value,
        description: document.getElementById("description").value,
        image_url: imageUrlInput.value,
        demo_url: document.getElementById("demoUrl").value,
        repo_url: document.getElementById("repoUrl").value,
        featured: document.getElementById("featured").checked,
      };

      try {
        const res = await fetch("/api/projects", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          window.location.href = "/admin";
        } else {
          formAlert.textContent = data.error || "Gagal menyimpan data";
          formAlert.className = "p-3 text-sm text-red-400 bg-red-950/50 border border-red-800 rounded-xl";
          formAlert.classList.remove("hidden");
        }
      } catch (err) {
        formAlert.textContent = "Terjadi kesalahan koneksi";
        formAlert.className = "p-3 text-sm text-red-400 bg-red-950/50 border border-red-800 rounded-xl";
        formAlert.classList.remove("hidden");
      }
    });
  </script>
</body>
</html>
