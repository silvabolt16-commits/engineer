---
import { isAuthenticated } from "../../../lib/auth";
import MainLayout from "../../../layouts/MainLayout.astro";

if (!isAuthenticated(Astro)) {
  return Astro.redirect("/admin/login");
}

const cloudName = Astro.locals.runtime?.env?.PUBLIC_CLOUDINARY_CLOUD_NAME || import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME || "";
const uploadPreset = Astro.locals.runtime?.env?.PUBLIC_CLOUDINARY_UPLOAD_PRESET || import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET || "";
---

<MainLayout title="Tambah Proyek Baru | Admin">
  <div class="max-w-4xl mx-auto py-12 px-6">
    <div class="mb-10">
      <a href="/admin" class="text-sm font-bold text-slate-500 dark:text-neutral-400 hover:text-[#E9582A] uppercase tracking-wider transition-colors">← Kembali ke Dashboard</a>
      <h1 class="text-3xl font-extrabold text-slate-800 dark:text-white mt-4 uppercase tracking-widest">
        Tambah <span class="text-[#E9582A]">Proyek Baru</span>
      </h1>
    </div>

    <div class="neu-flat rounded-3xl p-8 md:p-10">
      <form id="createProjectForm" class="space-y-8">
        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Judul Proyek *</label>
          <input type="text" id="title" required class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" placeholder="Contoh: Aplikasi E-Commerce Mobile" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Kategori</label>
            <input type="text" id="category" class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" placeholder="Web / Mobile / AI / Cloud" value="Web" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Tags (Dipisah Koma)</label>
            <input type="text" id="tags" class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" placeholder="Astro, React, Tailwind, Cloudflare" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Deskripsi Singkat *</label>
          <textarea id="description" required rows="4" class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" placeholder="Penjelasan ringkas proyek ini..."></textarea>
        </div>

        <!-- Cloudinary Upload / Image URL -->
        <div class="p-6 neu-pressed rounded-2xl space-y-4">
          <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider">Gambar Proyek (Upload / Link Direct)</label>
          
          <div class="flex flex-col sm:flex-row items-center gap-4">
            <input type="file" id="imageFile" accept="image/*" class="w-full sm:w-auto text-sm text-slate-600 dark:text-neutral-300 file:mr-4 file:py-2.5 file:px-5 file:rounded-xl file:border-0 file:text-xs file:font-bold file:uppercase file:tracking-wider file:bg-[#E9582A] file:text-white hover:file:bg-[#d04a1f] cursor-pointer transition-colors" />
            <span class="text-xs font-bold text-slate-400 uppercase">atau</span>
            <input type="url" id="imageUrl" class="flex-1 w-full px-4 py-3 text-slate-900 dark:text-white neu-flat border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] text-sm" placeholder="URL Foto (https://...)" />
          </div>

          <div id="uploadStatus" class="text-xs font-bold hidden uppercase tracking-wider mt-2"></div>
          <img id="imagePreview" class="hidden w-full h-56 object-cover rounded-xl mt-4" alt="Preview Gambar" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Link Demo / Live Website</label>
            <input type="url" id="demoUrl" class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" placeholder="https://demo-app.com" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 dark:text-neutral-400 uppercase tracking-wider mb-2">Link Repository (GitHub)</label>
            <input type="url" id="repoUrl" class="w-full px-4 py-3.5 text-slate-900 dark:text-white neu-pressed border-none rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E9582A] transition" placeholder="https://github.com/user/repo" />
          </div>
        </div>

        <div class="flex items-center space-x-3 pt-2">
          <input type="checkbox" id="featured" class="w-5 h-5 rounded text-[#E9582A] neu-pressed border-none focus:ring-[#E9582A] focus:ring-offset-0 bg-transparent" />
          <label for="featured" class="text-sm font-bold text-slate-600 dark:text-neutral-300">Tampilkan sebagai Proyek Unggulan (Featured)</label>
        </div>

        <div id="formAlert" class="hidden p-4 text-sm font-bold rounded-xl uppercase tracking-wider text-center"></div>

        <button type="submit" id="submitBtn" class="w-full py-4 mt-4 text-white font-bold bg-[#E9582A] hover:bg-[#d04a1f] rounded-xl shadow-md transition-all text-sm uppercase tracking-wider">
          Simpan Proyek
        </button>
      </form>
    </div>
  </div>

  <script define:vars={{ cloudName, uploadPreset }}>
    const imageFileInput = document.getElementById("imageFile");
    const imageUrlInput = document.getElementById("imageUrl");
    const imagePreview = document.getElementById("imagePreview");
    const uploadStatus = document.getElementById("uploadStatus");
    const form = document.getElementById("createProjectForm");
    const formAlert = document.getElementById("formAlert");
    const submitBtn = document.getElementById("submitBtn");

    imageFileInput?.addEventListener("change", async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      if (!cloudName || !uploadPreset) {
        alert("Konfigurasi Cloudinary belum diset di environment variable. Silakan tempel URL gambar langsung.");
        return;
      }

      uploadStatus.textContent = "Mengunggah gambar ke Cloudinary...";
      uploadStatus.classList.remove("hidden");
      uploadStatus.classList.add("text-blue-500");
      uploadStatus.classList.remove("text-green-500", "text-red-500");

      const formData = new FormData();
      formData.append("file", file);
      formData.append("upload_preset", uploadPreset);

      try {
        const res = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, {
          method: "POST",
          body: formData,
        });

        if (res.ok) {
          const data = await res.json();
          imageUrlInput.value = data.secure_url;
          imagePreview.src = data.secure_url;
          imagePreview.classList.remove("hidden");
          uploadStatus.textContent = "✓ Gambar berhasil diunggah!";
          uploadStatus.classList.remove("text-blue-500", "text-red-500");
          uploadStatus.classList.add("text-green-500");
        } else {
          uploadStatus.textContent = "Gagal mengunggah gambar. Pastikan upload_preset valid.";
          uploadStatus.classList.remove("text-blue-500", "text-green-500");
          uploadStatus.classList.add("text-red-500");
        }
      } catch (err) {
        uploadStatus.textContent = "Terjadi kesalahan saat upload gambar.";
        uploadStatus.classList.remove("text-blue-500", "text-green-500");
        uploadStatus.classList.add("text-red-500");
      }
    });

    imageUrlInput?.addEventListener("input", () => {
      if (imageUrlInput.value) {
        imagePreview.src = imageUrlInput.value;
        imagePreview.classList.remove("hidden");
      }
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      formAlert.classList.add("hidden");
      if(submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Menyimpan...";
      }

      const payload = {
        title: document.getElementById("title").value,
        category: document.getElementById("category").value,
        tags: document.getElementById("tags").value,
        description: document.getElementById("description").value,
        image_url: imageUrlInput.value,
        demo_url: document.getElementById("demoUrl").value,
        repo_url: document.getElementById("repoUrl").value,
        featured: document.getElementById("featured").checked,
      };

      try {
        const res = await fetch("/api/projects", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          window.location.href = "/admin";
        } else {
          formAlert.textContent = data.error || "Gagal menyimpan data";
          formAlert.className = "p-4 text-sm font-bold bg-red-100 text-red-600 border border-red-300 rounded-xl uppercase tracking-wider text-center";
          formAlert.classList.remove("hidden");
          if(submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Simpan Proyek";
          }
        }
      } catch (err) {
        formAlert.textContent = "Terjadi kesalahan koneksi";
        formAlert.className = "p-4 text-sm font-bold bg-red-100 text-red-600 border border-red-300 rounded-xl uppercase tracking-wider text-center";
        formAlert.classList.remove("hidden");
        if(submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Simpan Proyek";
        }
      }
    });
  </script>
</MainLayout>
