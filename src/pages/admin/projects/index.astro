---
export const prerender = false;

import { isAuthenticated } from "../../../lib/auth";
import { getDB, getAllProjects } from "../../../lib/d1";
import AdminLayout from "../../../layouts/AdminLayout.astro";

if (!isAuthenticated(Astro)) {
  return Astro.redirect("/admin/login");
}

const db = getDB(Astro.locals);
const projects = await getAllProjects(db);
---

<AdminLayout title="Dashboard Admin | Portofolio">
  <div class="max-w-6xl mx-auto pt-6 pb-6 md:pt-10 md:pb-8 px-6">
    <div class="flex flex-col md:flex-row items-center justify-between mb-12 gap-6">
      <div class="text-center md:text-left">
        <h1 class="text-3xl font-extrabold text-slate-800 dark:text-white uppercase tracking-widest mb-2">
          Admin <span class="text-[#E9582A]">Panel</span>
        </h1>
        <p class="text-sm text-slate-500 dark:text-neutral-400">Total: {projects.length} Proyek di Database D1</p>
      </div>

      <div class="flex items-center space-x-4">
        <a href="/" target="_blank" class="px-4 py-3 neu-flat rounded-xl text-sm font-bold text-slate-700 dark:text-neutral-200 hover:text-[#E9582A] dark:hover:text-[#E9582A] neu-flat-hover transition-all uppercase tracking-wider">Lihat Web ↗</a>
        <a href="/admin/projects/new" class="px-5 py-3 bg-[#E9582A] hover:bg-[#d04a1f] text-white font-bold rounded-xl shadow-md transition-all text-sm uppercase tracking-wider">
          + Tambah Proyek
        </a>
        <button id="logoutBtn" class="px-4 py-3 neu-pressed rounded-xl text-sm font-bold text-red-500 hover:text-red-600 transition-all uppercase tracking-wider">
          Keluar
        </button>
      </div>
    </div>

    <!-- Projects Grid / Table -->
    <div class="flex items-center justify-between mb-6 border-b border-slate-200 dark:border-slate-800 pb-2">
      <h2 class="text-lg font-bold text-slate-800 dark:text-white uppercase tracking-widest">Daftar Proyek Portofolio ({projects.length})</h2>
      <a href="/admin/projects/new" class="px-4 py-2 bg-[#E9582A] hover:bg-[#d04a1f] text-white font-bold rounded-xl shadow-md transition-all text-[10px] uppercase tracking-wider">
        + Tambah Proyek
      </a>
    </div>
    {projects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project) => (
          <div class="neu-flat rounded-3xl overflow-hidden flex flex-col justify-between group transition-all">
            <div>
              <div class="p-4">
                {project.image_url ? (
                  <div class="w-full h-48 rounded-2xl overflow-hidden neu-pressed p-1">
                    <img src={project.image_url} alt={project.title} class="w-full h-full object-cover rounded-xl" />
                  </div>
                ) : (
                  <div class="w-full h-48 rounded-2xl neu-pressed flex items-center justify-center text-slate-400 text-sm font-medium">
                    Tidak Ada Gambar
                  </div>
                )}
              </div>

              <div class="px-6 pb-2">
                <div class="flex items-center justify-between mb-3">
                  <span class="px-3 py-1.5 text-[10px] font-bold text-[#E9582A] neu-flat rounded-full uppercase tracking-wider">
                    {project.category || 'Web'}
                  </span>
                  {project.featured ? (
                    <span class="px-3 py-1.5 text-[10px] font-bold text-amber-500 neu-flat rounded-full uppercase tracking-wider">
                      ★ Featured
                    </span>
                  ) : null}
                </div>

                <h3 class="text-xl font-bold text-slate-800 dark:text-white mb-2">{project.title}</h3>
                <p class="text-sm text-slate-500 dark:text-neutral-400 line-clamp-2">{project.description}</p>
              </div>
            </div>

            <div class="px-6 pb-6 pt-4 flex items-center justify-between mt-auto">
              <a
                href={`/admin/projects/${project.id}/edit`}
                class="px-5 py-2.5 neu-flat rounded-xl text-xs font-bold text-slate-700 dark:text-neutral-200 hover:text-[#E9582A] dark:hover:text-[#E9582A] neu-flat-hover transition-all uppercase tracking-wider"
              >
                Edit
              </a>

              <button
                data-id={project.id}
                class="deleteBtn px-5 py-2.5 neu-pressed rounded-xl text-xs font-bold text-red-500 hover:text-red-600 transition-all uppercase tracking-wider"
              >
                Hapus
              </button>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-20 neu-flat rounded-3xl mt-12">
        <p class="text-slate-500 dark:text-neutral-400 mb-6 font-medium">Belum ada proyek di database Cloudflare D1 Anda.</p>
        <a
          href="/admin/projects/new"
          class="inline-block px-8 py-4 bg-[#E9582A] hover:bg-[#d04a1f] text-white font-bold rounded-xl shadow-md transition-all text-sm uppercase tracking-wider"
        >
          Buat Proyek Pertama
        </a>
      </div>
    )}
  </div>

  <script>
    // Logout Handler
    document.getElementById("logoutBtn")?.addEventListener("click", async () => {
      await fetch("/api/auth/logout", { method: "POST" });
      window.location.href = "/admin/login";
    });

    // Delete Handlers
    document.querySelectorAll(".deleteBtn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const id = (e.target as HTMLElement).getAttribute("data-id");
        if (confirm("Apakah Anda yakin ingin menghapus proyek ini?")) {
          const res = await fetch(`/api/projects/${id}`, { method: "DELETE" });
          if (res.ok) {
            window.location.reload();
          } else {
            alert("Gagal menghapus proyek.");
          }
        }
      });
    });
  </script>
</AdminLayout>
