---
import { isAuthenticated } from "../../lib/auth";
import { getDB, getAllProjects, getProfile, getAllFromTable } from "../../lib/d1";
import { marked } from "marked";

if (!isAuthenticated(Astro)) {
  return Astro.redirect("/admin/login");
}

const db = getDB(Astro.locals);
const profileData = (await getProfile(db)) || ({} as any);

const profile = {
  name: (profileData.name || "").toUpperCase(),
  role: profileData.role || "",
  phone: profileData.phone || "",
  email: profileData.email || "",
  linkedin: (profileData.linkedin || "").replace(/^https?:\/\//, ""),
  website: profileData.website || "https://fajri.web.id",
  summary: profileData.cvSummary || profileData.bio || "",
  avatar: profileData.avatar || "",
};

let faviconUrl = profile.avatar || '';
let favicon48 = '';
let favicon192 = '';
if (faviconUrl && faviconUrl.includes('cloudinary.com')) {
  faviconUrl = faviconUrl.replace('/upload/', '/upload/c_thumb,g_face,w_120,h_120,r_max/');
  favicon48 = profile.avatar.replace('/upload/', '/upload/c_thumb,g_face,w_48,h_48,r_max,f_png/');
  favicon192 = profile.avatar.replace('/upload/', '/upload/c_thumb,g_face,w_192,h_192,r_max,f_png/');
}

// Helper to parse dates/durations for sorting (newest to oldest)
function parseDateForSort(dateStr: string) {
  if (!dateStr) return 0;
  let targetDate = dateStr;
  if (dateStr.includes('|')) {
    const parts = dateStr.split('|');
    targetDate = parts[1]; // Use end date for sorting
    if (targetDate.toLowerCase() === 'present' || targetDate.toLowerCase() === 'sekarang') return Infinity;
  }
  if (targetDate.toLowerCase() === 'present' || targetDate.toLowerCase() === 'sekarang') return Infinity;
  
  try {
    const [year, month] = targetDate.split('-');
    if (year && month) {
      return new Date(parseInt(year), parseInt(month) - 1).getTime();
    }
    return parseInt(targetDate) || 0;
  } catch (e) {
    return 0;
  }
}

// Fetch other sections
let education = profileData.education || [];
education.sort((a: any, b: any) => parseDateForSort(b.duration) - parseDateForSort(a.duration));

let experiences = (await getAllFromTable(db, 'experiences') || []);
let certificates = await getAllFromTable(db, 'certificates') || [];
let achievements = await getAllFromTable(db, 'achievements') || [];
let skillsData = await getAllFromTable(db, 'skills') || [];
let allProjects = await getAllProjects(db);

const url = new URL(Astro.request.url);
const categoryQuery = url.searchParams.get("category");
const layoutQuery = url.searchParams.get("layout") || "image";

const expsQuery = url.searchParams.get("exps");
const skillsQuery = url.searchParams.get("skills");
const achsQuery = url.searchParams.get("achs");
const certsQuery = url.searchParams.get("certs");
const projsQuery = url.searchParams.get("projs");

if (categoryQuery && categoryQuery !== "all") {
  allProjects = allProjects.filter((p) => p.category === categoryQuery);
}

// FILTER BY IDS FROM URL PARAMS
if (expsQuery !== null) {
  const ids = expsQuery.split(',').filter(Boolean).map(id => parseInt(id));
  experiences = experiences.filter((e: any) => ids.includes(e.id));
}
if (achsQuery !== null) {
  const ids = achsQuery.split(',').filter(Boolean).map(id => parseInt(id));
  achievements = achievements.filter((a: any) => ids.includes(a.id));
}
if (certsQuery !== null) {
  const ids = certsQuery.split(',').filter(Boolean).map(id => parseInt(id));
  certificates = certificates.filter((c: any) => ids.includes(c.id));
}
if (projsQuery !== null) {
  const ids = projsQuery.split(',').filter(Boolean).map(id => parseInt(id));
  allProjects = allProjects.filter((p: any) => ids.includes(p.id));
}
experiences.sort((a: any, b: any) => parseDateForSort(b.duration) - parseDateForSort(a.duration));
certificates.sort((a: any, b: any) => parseDateForSort(b.date) - parseDateForSort(a.date));
achievements.sort((a: any, b: any) => parseDateForSort(b.date) - parseDateForSort(a.date));
allProjects.sort((a: any, b: any) => parseDateForSort(b.date) - parseDateForSort(a.date));

let skills = skillsData.map((skill: any) => {
  const itemsArray = Array.isArray(skill.items) ? skill.items : (typeof skill.items === 'string' ? JSON.parse(skill.items || '[]') : (skill.items || []));
  return { category: skill.category, items: itemsArray };
});

if (skillsQuery !== null) {
  const allowedSkills = skillsQuery.split('|').filter(Boolean);
  skills = skills.map((s: any) => {
    return { ...s, items: s.items.filter((item: string) => allowedSkills.includes(item)) };
  }).filter((s: any) => s.items.length > 0);
}

const chunkedExperiences = [];
for (let i = 0; i < experiences.length; i += 2) {
  chunkedExperiences.push(experiences.slice(i, i + 2));
}

const chunkedAchievements = [];
for (let i = 0; i < achievements.length; i += 4) {
  chunkedAchievements.push(achievements.slice(i, i + 4));
}

const chunkedCertificates = [];
for (let i = 0; i < certificates.length; i += 4) {
  chunkedCertificates.push(certificates.slice(i, i + 4));
}

const chunkedProjects = [];
// For landscape, we can easily fit 2 projects per slide via grid
for (let i = 0; i < allProjects.length; i += 2) {
  chunkedProjects.push(allProjects.slice(i, i + 2));
}

// Generate QR Code URL
const qrCodeUrl = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&color=1e293b&bgcolor=ffffff&data=${encodeURIComponent(profile.website)}`;
const qrCodeLightUrl = `https://api.qrserver.com/v1/create-qr-code/?size=150x150&color=1e293b&bgcolor=ffffff&data=${encodeURIComponent(profile.website)}`;

function formatDuration(durationStr: string) {
  if (!durationStr || !durationStr.includes('|')) return durationStr;
  const [start, end] = durationStr.split('|');
  const formatDate = (dateStr: string) => {
    if (dateStr === 'present') return 'Sekarang';
    if (!dateStr) return '';
    try {
      const [year, month] = dateStr.split('-');
      const date = new Date(parseInt(year), parseInt(month) - 1);
      return date.toLocaleDateString('id-ID', { month: 'short', year: 'numeric' });
    } catch (e) {
      return dateStr;
    }
  };
  return `${formatDate(start)} - ${formatDate(end)}`;
}

function formatDateSingle(dateStr: string) {
  if (!dateStr) return '';
  if (dateStr.includes('|')) return formatDuration(dateStr);
  try {
    const [year, month] = dateStr.split('-');
    const date = new Date(parseInt(year), parseInt(month) - 1);
    return date.toLocaleDateString('id-ID', { month: 'short', year: 'numeric' });
  } catch (e) {
    return dateStr;
  }
}
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <title>Portofolio - {profile.name}</title>
  <meta name="viewport" content="width=device-width" />
  
  <!-- Favicon: Profile Photo -->
  <link rel="icon" type="image/png" sizes="48x48" href={favicon48 || faviconUrl} />
  <link rel="icon" type="image/png" sizes="192x192" href={favicon192 || faviconUrl} />
  <link rel="icon" href={faviconUrl} />
  <link rel="apple-touch-icon" sizes="192x192" href={favicon192 || faviconUrl} />

  <!-- Google Material Symbols -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

  <!-- Tailwind CSS -->
  <style>
    @import "tailwindcss";

    @page {
      size: A4 landscape;
      margin: 0;
    }

    @media print {
      body {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        background-color: #f1f5f9 !important; /* light slate bg for contrast */
        margin: 0;
      }
      .no-print {
        display: none !important;
      }
      .page-break {
        page-break-after: always;
        break-after: page;
      }
      .page {
        width: 297mm;
        height: 210mm;
        box-shadow: none;
        margin: 0;
        overflow: hidden;
      }
    }

    body {
      font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
      background-color: #333;
    }

    .page {
      width: 297mm;
      min-height: 210mm;
      height: auto;
      margin: 2rem auto;
      background: white;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
      position: relative;
    }

    /* Markdown prose styles */
    .prose-custom p { margin-bottom: 0.5rem; }
    .prose-custom ul { list-style-type: none; padding-left: 0; margin-bottom: 0.5rem; }
    .prose-custom ul li { position: relative; padding-left: 1rem; margin-bottom: 0.25rem; }
    .prose-custom ul li::before {
      content: "•";
      color: #E9582A;
      font-weight: bold;
      position: absolute;
      left: 0;
    }
    .prose-custom a { color: #E9582A; text-decoration: none; font-weight: 600; }
  </style>

  <script>
    window.onload = () => {
      setTimeout(() => {
        window.print();
        window.onafterprint = () => {
          // window.close();
        };
      }, 1500);
    };
  </script>
</head>
<body class="text-slate-800 bg-[#333] print:bg-slate-100 antialiased text-[13px] leading-relaxed">
  
  <!-- SLIDE 1: COVER PITCH DECK -->
  <div class="page page-break bg-slate-50 flex overflow-hidden">
    <!-- Kiri: Foto Besar & Warna Dominan -->
    <div class="w-5/12 bg-[#1e293b] relative flex items-center justify-center border-r-[12px] border-[#E9582A]">
      <!-- Background pattern -->
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;"></div>
      
      {profile.avatar ? (
        <img src={profile.avatar} alt={profile.name} class="w-[340px] h-[340px] object-cover rounded-full border-8 border-[#E9582A] shadow-2xl z-10" />
      ) : (
        <div class="w-[340px] h-[340px] rounded-full border-8 border-[#E9582A] bg-slate-700 shadow-2xl z-10 flex items-center justify-center font-bold text-8xl text-white">{profile.name.charAt(0)}</div>
      )}
    </div>

    <!-- Kanan: Identitas -->
    <div class="w-7/12 flex flex-col justify-center px-20">
      <h1 class="text-6xl font-extrabold tracking-tighter uppercase text-slate-900 leading-none mb-4">{profile.name}</h1>
      <h2 class="text-2xl font-bold tracking-widest uppercase text-[#E9582A] mb-12">{profile.role}</h2>
      
      <div class="space-y-4 text-[14px] font-medium text-slate-600 mb-12">
        {profile.phone && <div class="flex items-center gap-4"><span class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-lg"><span class="material-symbols-outlined align-middle">call</span></span> {profile.phone}</div>}
        {profile.email && <div class="flex items-center gap-4"><span class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-lg"><span class="material-symbols-outlined align-middle">mail</span></span> {profile.email}</div>}
        {profile.linkedin && <div class="flex items-center gap-4"><span class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-lg"><span class="material-symbols-outlined align-middle">language</span></span> {profile.linkedin}</div>}
      </div>

      <div class="flex items-center gap-6 p-4 bg-white border border-slate-200 rounded-2xl shadow-sm self-start">
        <img src={qrCodeUrl} alt="QR Code" class="w-20 h-20 rounded-lg" />
        <div>
          <div class="text-[12px] font-bold text-slate-700">{profile.website.replace(/^https?:\/\//, '')}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- SLIDE 2: EXECUTIVE SUMMARY & SKILLS -->
  <div class="page page-break bg-white flex flex-col relative p-12">
    <!-- Header Decor -->
    <div class="absolute top-0 left-0 w-full h-3 bg-[#1e293b]"></div>
    <div class="absolute top-0 right-16 w-32 h-10 bg-[#E9582A] rounded-b-xl flex items-center justify-center text-white font-extrabold text-[12px] uppercase tracking-widest shadow-md">01 / Profile</div>

    <div class="flex gap-16 h-full mt-8">
      <!-- Kiri: Summary & Pendidikan -->
      <div class="w-1/2 flex flex-col">
        <h2 class="text-4xl font-extrabold text-slate-900 tracking-tight mb-2">Executive Summary</h2>
        <div class="w-16 h-1.5 bg-[#E9582A] mb-8"></div>
        <p class="text-[15px] leading-relaxed text-slate-600 text-justify mb-12">
          {profile.summary}
        </p>

        {education.length > 0 && (
          <div>
            <h3 class="text-2xl font-extrabold text-slate-900 tracking-tight mb-6">Pendidikan</h3>
            <div class="space-y-4">
              {education.map((edu: any) => (
                <div class="bg-slate-50 p-4 rounded-xl border-l-4 border-[#1e293b] shadow-sm">
                  <div class="flex justify-between items-start mb-1">
                    <div class="font-extrabold text-[14px] text-slate-900">{edu.institution}</div>
                    <div class="text-slate-500 font-bold text-[10px] uppercase tracking-wider bg-white px-2 py-1 rounded border border-slate-200">{edu.duration}</div>
                  </div>
                  <div class="text-[#E9582A] font-bold text-[12px] mb-2">{edu.degree}</div>
                  {edu.achievements.length > 0 && (
                    <ul class="text-[11px] text-slate-600 space-y-1 ml-4 list-disc marker:text-[#1e293b]">
                      {edu.achievements.map((ach: string) => (<li>{ach}</li>))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Kanan: Skills Infographic -->
      <div class="w-1/2 flex flex-col">
        <h2 class="text-4xl font-extrabold text-slate-900 tracking-tight mb-2">Keahlian Inti</h2>
        <div class="w-16 h-1.5 bg-[#E9582A] mb-8"></div>
        
        <div class="grid grid-cols-1 gap-6">
          {skills.map((skill: any) => (
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
              <div class="flex items-center gap-3 mb-4">
                <div class="text-[14px] font-extrabold text-slate-800 uppercase tracking-widest">{skill.category}</div>
              </div>
              <div class="flex flex-wrap gap-2">
                {skill.items.map((item: string) => (
                  <span class="inline-block px-3 py-1.5 bg-slate-800 text-white text-[11px] font-bold rounded-lg shadow-sm">{item.trim()}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- SLIDES: EXPERIENCE -->
  {chunkedExperiences.length > 0 && chunkedExperiences.map((pageExps, pageIndex) => (
    <div class="page page-break bg-white flex flex-col relative p-12">
      <div class="absolute top-0 left-0 w-full h-3 bg-[#1e293b]"></div>
      <div class="absolute top-0 right-16 w-32 h-10 bg-[#E9582A] rounded-b-xl flex items-center justify-center text-white font-extrabold text-[12px] uppercase tracking-widest shadow-md">02 / Track</div>

      <div class="flex flex-col gap-8 mt-8 pb-12">
        <div class="w-full flex flex-col">
          {pageIndex === 0 && (
            <div class="mb-4">
              <h2 class="text-4xl font-extrabold text-slate-900 tracking-tight mb-1">Pengalaman Profesional</h2>
              <p class="text-slate-500 text-[11px] font-medium mb-3">Rekam jejak perjalanan karir dan tanggung jawab profesional yang pernah saya laksanakan.</p>
              <div class="w-16 h-1.5 bg-[#E9582A] mb-4"></div>
            </div>
          )}
          
          <div class="space-y-6 relative before:absolute before:inset-0 before:ml-[11px] before:h-full before:w-[2px] before:bg-slate-200">
            {pageExps.map((exp: any) => {
              const details = typeof exp.details === 'string' ? (exp.details.startsWith('[') ? JSON.parse(exp.details) : exp.details.split(',').map((t: string) => t.trim())) : (exp.details || []);
              let photos = [];
              try { photos = typeof exp.photos === 'string' ? JSON.parse(exp.photos) : (exp.photos || []); } catch(e){}
              const hasImage = layoutQuery === 'image' && photos.length > 0;
              return (
                <div class="relative flex items-start pl-10">
                  <!-- Dot -->
                  <div class="absolute left-0 mt-1 w-6 h-6 rounded-full border-4 border-white bg-[#E9582A] shadow-sm"></div>
                  
                  <div class="w-full bg-slate-50 p-4 rounded-xl border border-slate-100 shadow-sm">
                    <div class="flex justify-between items-start mb-2">
                      <div class="flex-1 pr-2">
                        <h3 class="text-[15px] font-extrabold text-slate-900">{exp.title}</h3>
                        <div class="text-[#E9582A] font-bold text-[12px]">{exp.company}</div>
                      </div>
                      <span class="text-[10px] font-bold text-slate-500 bg-white border border-slate-200 px-2 py-1 rounded-md shadow-sm shrink-0">{formatDuration(exp.duration)}</span>
                    </div>
                    
                    <div class="flex flex-row gap-6 items-start mt-2">
                      <div class={hasImage ? "w-1/2" : "w-full"}>
                        {details.length > 0 && (
                          <ul class="text-[12px] text-slate-600 space-y-1.5 pl-4 list-disc marker:text-[#E9582A]">
                            {details.map((detail: string) => (<li>{detail}</li>))}
                          </ul>
                        )}
                      </div>
                      {hasImage && (
                        <div class="w-1/2 shrink-0">
                          <img src={photos[0]} alt={exp.title} class="w-full aspect-[16/9] object-cover rounded-xl border-2 border-slate-200 shadow-md" />
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  ))}

  <!-- SLIDES: AWARDS -->
  {chunkedAchievements.length > 0 && chunkedAchievements.map((pageAchs, pageIndex) => (
    <div class="page page-break bg-white flex flex-col relative p-12">
      <div class="absolute top-0 left-0 w-full h-3 bg-[#1e293b]"></div>
      <div class="absolute top-0 right-16 w-32 h-10 bg-[#E9582A] rounded-b-xl flex items-center justify-center text-white font-extrabold text-[12px] uppercase tracking-widest shadow-md">03 / Awards</div>
      
      <div class="flex flex-col gap-12 mt-8 pb-12">
        <div class="w-full flex flex-col">
          {pageIndex === 0 && (
            <div class="mb-4">
              <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-1">Penghargaan</h2>
              <p class="text-slate-500 text-[10px] font-medium mb-2">Apresiasi dan pencapaian yang berhasil diraih.</p>
              <div class="w-12 h-1 bg-[#E9582A] mb-6"></div>
            </div>
          )}
          
          <div class="grid grid-cols-2 gap-8">
            {pageAchs.map((ach: any) => {
              const hasImage = layoutQuery === 'image' && ach.image;
              return (
                <div class="flex flex-col bg-white p-5 rounded-3xl border border-slate-200 shadow-lg overflow-hidden">
                  {hasImage ? (
                    <img src={ach.image} class="w-full h-[160px] object-cover rounded-2xl border-4 border-slate-50 mb-4 shadow-sm" />
                  ) : (
                    <div class="w-full h-[160px] rounded-2xl bg-slate-50 flex items-center justify-center text-5xl mb-4 border-4 border-slate-100 shadow-sm"><span class="material-symbols-outlined align-middle">emoji_events</span></div>
                  )}
                  <div class="flex-1 flex flex-col justify-end">
                    <div class="text-[11px] font-extrabold text-[#E9582A] uppercase tracking-widest mb-1">{formatDateSingle(ach.date)}</div>
                    <div class="font-extrabold text-[16px] text-slate-800 leading-tight mb-1.5">{ach.title}</div>
                    <div class="text-slate-500 text-[12px] font-medium bg-slate-50 px-2 py-1 rounded-lg inline-block w-fit">{ach.issuer}</div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  ))}

  <!-- SLIDES: CERTIFICATES -->
  {chunkedCertificates.length > 0 && chunkedCertificates.map((pageCerts, pageIndex) => (
    <div class="page page-break bg-white flex flex-col relative p-12">
      <div class="absolute top-0 left-0 w-full h-3 bg-[#1e293b]"></div>
      <div class="absolute top-0 right-16 w-32 h-10 bg-[#E9582A] rounded-b-xl flex items-center justify-center text-white font-extrabold text-[12px] uppercase tracking-widest shadow-md">04 / Certs</div>
      
      <div class="flex flex-col gap-12 mt-8 pb-12">
        <div class="w-full flex flex-col">
          {pageIndex === 0 && (
            <div class="mb-4">
              <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-1">Sertifikasi & Pelatihan</h2>
              <p class="text-slate-500 text-[10px] font-medium mb-2">Lisensi dan program pelatihan profesional yang telah diselesaikan.</p>
              <div class="w-12 h-1 bg-[#E9582A] mb-6"></div>
            </div>
          )}
          
          <div class="grid grid-cols-2 gap-8">
            {pageCerts.map((cert: any) => {
              const hasImage = layoutQuery === 'image' && cert.link && cert.link.startsWith('http');
              return (
                <div class="flex flex-col bg-white p-5 rounded-3xl border border-slate-200 shadow-lg overflow-hidden">
                  {hasImage ? (
                    <img src={cert.link} class="w-full h-[160px] object-cover rounded-2xl border-4 border-slate-50 mb-4 shadow-sm" />
                  ) : (
                    <div class="w-full h-[160px] rounded-2xl bg-slate-50 flex items-center justify-center text-5xl mb-4 border-4 border-slate-100 shadow-sm"><span class="material-symbols-outlined align-middle">workspace_premium</span></div>
                  )}
                  <div class="flex-1 flex flex-col justify-end">
                    <div class="text-[11px] font-extrabold text-[#E9582A] uppercase tracking-widest mb-1">{formatDateSingle(cert.date)}</div>
                    <div class="font-extrabold text-[16px] text-slate-800 leading-tight mb-1.5">{cert.title}</div>
                    <div class="text-slate-500 text-[12px] font-medium bg-slate-50 px-2 py-1 rounded-lg inline-block w-fit">{cert.issuer}</div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  ))}

  <!-- SLIDES: PORTFOLIO PROJECTS -->
  {chunkedProjects.length > 0 ? (
    chunkedProjects.map((pageProjects, pageIndex) => (
      <div class={`page ${pageIndex === chunkedProjects.length - 1 ? '' : 'page-break'} bg-slate-50 flex flex-col relative px-12 py-10`}>
        <!-- Header Decor -->
        <div class="absolute top-0 left-0 w-full h-3 bg-[#1e293b]"></div>
        <div class="absolute top-0 right-16 w-32 h-10 bg-[#E9582A] rounded-b-xl flex items-center justify-center text-white font-extrabold text-[12px] uppercase tracking-widest shadow-md">05 / Karya</div>

        <!-- Header Title (only on first project page) -->
        {pageIndex === 0 && (
          <div class="mb-8 mt-4">
            <h2 class="text-4xl font-extrabold text-slate-900 tracking-tight mb-1">Katalog Portofolio</h2>
            <p class="text-slate-500 text-[11px] font-medium mb-2">Kumpulan karya dan proyek terpilih yang mendemonstrasikan keahlian teknis dan pendekatan kreatif saya.</p>
            <div class="flex items-center gap-4">
              <div class="w-16 h-1.5 bg-[#E9582A]"></div>
              <p class="text-slate-500 text-[12px] font-bold uppercase tracking-widest">{categoryQuery && categoryQuery !== 'all' ? `Kategori: ${categoryQuery}` : 'Semua Kategori'}</p>
            </div>
          </div>
        )}

        <!-- 2 Columns Grid for Projects (because landscape is wide) -->
        <div class={`grid ${pageProjects.length === 2 ? 'grid-cols-2 gap-10' : 'grid-cols-1 max-w-4xl'} h-full mt-auto mb-auto`}>
          {pageProjects.map((project: any, i: number) => {
            const index = pageIndex * 2 + i;
            const tags = project.tags ? project.tags.split(',').map((t: string) => t.trim()) : [];
            const parsedDesc = marked.parse(project.description || '');
            const hasImage = layoutQuery === 'image' && project.image_url;

            return (
              <div class="project-item flex flex-col h-full bg-white rounded-3xl overflow-hidden shadow-lg border border-slate-100">
                <!-- Project Image -->
                {hasImage && (
                  <div class="w-full h-[220px] shrink-0 relative bg-slate-900">
                    <img src={project.image_url} alt={project.title} class="w-full h-full object-cover opacity-95" />
                    <div class="absolute top-4 left-4 bg-[#E9582A] text-white px-3 py-1 rounded-lg font-extrabold text-[10px] uppercase tracking-widest shadow-md">
                      {project.category || 'Web'}
                    </div>
                  </div>
                )}
                
                <!-- Project Content -->
                <div class="p-6 flex flex-col flex-1">
                  <div class="flex justify-between items-start mb-3">
                    <h3 class="text-2xl font-extrabold text-slate-900 tracking-tight leading-tight pr-4">{project.title}</h3>
                    {project.date && <span class="text-[10px] font-bold text-slate-500 whitespace-nowrap bg-slate-100 px-2 py-1 rounded">{project.date.replace('|', ' - ')}</span>}
                  </div>
                  
                  <div class="text-[12.5px] leading-relaxed text-slate-600 prose-custom text-justify mb-6" set:html={parsedDesc} />
                  
                  <!-- Bottom Action/Tags -->
                  <div class="mt-auto pt-4 border-t border-slate-100">
                    <div class="flex flex-wrap items-center justify-between gap-4">
                      <div class="flex gap-2">
                        {project.demo_url && <a href={project.demo_url} target="_blank" class="px-3 py-1.5 bg-orange-50 text-[#E9582A] rounded-lg font-bold text-[10px] uppercase tracking-wider flex items-center gap-1"><span class="material-symbols-outlined align-middle">link</span> Live Demo</a>}
                        {project.repo_url && <a href={project.repo_url} target="_blank" class="px-3 py-1.5 bg-slate-800 text-white rounded-lg font-bold text-[10px] uppercase tracking-wider flex items-center gap-1"><span class="material-symbols-outlined align-middle">folder</span> Code</a>}
                      </div>
                      
                      <div class="flex flex-wrap gap-1.5 justify-end">
                        {tags.slice(0, 4).map((tag: string) => (
                          <span class="inline-block px-2 py-1 bg-slate-100 text-slate-500 text-[9px] font-bold rounded-md border border-slate-200">{tag}</span>
                        ))}
                        {tags.length > 4 && <span class="inline-block px-2 py-1 bg-slate-50 text-slate-400 text-[9px] font-bold rounded-md border border-slate-100">+{tags.length - 4}</span>}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
        
        <!-- Footer on each page -->
        <div class="absolute bottom-6 left-12 right-12 flex justify-between items-center">
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">{profile.name} &mdash; Portfolio Pitch Deck</span>
          <div class="flex items-center gap-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
            <img src={qrCodeLightUrl} class="w-6 h-6 rounded" /> 
            Scan for online version
          </div>
        </div>
      </div>
    ))
  ) : (
    <div class="page bg-slate-50 flex flex-col items-center justify-center text-center">
      <div class="w-32 h-32 bg-white rounded-full flex items-center justify-center text-5xl mb-6 shadow-sm border border-slate-200"><span class="material-symbols-outlined align-middle">inbox</span></div>
      <h2 class="text-3xl font-extrabold text-slate-900 mb-2">Katalog Kosong</h2>
      <p class="text-slate-500 text-[14px]">Belum ada proyek portofolio yang dapat ditampilkan dalam kategori ini.</p>
    </div>
  )}

</body>
</html>
