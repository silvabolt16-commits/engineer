              <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </button>
            
            <!-- Dropdown Menu -->
            <div id="lang-menu" class="hidden absolute right-0 md:right-auto md:-left-4 top-[calc(100%+8px)] w-40 z-50 neu-flat rounded-2xl p-2 bg-[#ecf0f3]/95 dark:bg-[#1a1a1a]/95 backdrop-blur-xl shadow-2xl border border-slate-300/40 dark:border-neutral-800">
              <div class="flex flex-col gap-1 font-medium text-sm">
                <a href={idPath} class={`w-full text-left px-3.5 py-2.5 rounded-xl hover:bg-slate-200/60 dark:hover:bg-neutral-800/80 transition-colors flex items-center gap-3 ${lang === 'id' ? 'text-[#E9582A] bg-orange-500/10' : 'text-slate-700 dark:text-neutral-200 hover:text-[#E9582A]'}`}>
                  <img src="https://flagcdn.com/id.svg" class="w-5 h-auto rounded-[2px] shadow-sm" alt="Indonesia Flag" />
                  <span>Indonesia</span>
                </a>
                <a href={enPath} class={`w-full text-left px-3.5 py-2.5 rounded-xl hover:bg-slate-200/60 dark:hover:bg-neutral-800/80 transition-colors flex items-center gap-3 ${lang === 'en' ? 'text-[#E9582A] bg-orange-500/10' : 'text-slate-700 dark:text-neutral-200 hover:text-[#E9582A]'}`}>
                  <img src="https://flagcdn.com/gb.svg" class="w-5 h-auto rounded-[2px] shadow-sm" alt="UK Flag" />
                  <span>English</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Theme Toggle Switch (Desktop Only) -->
          <button id="theme-toggle" type="button" aria-label="Toggle Dark Mode" class="hidden md:flex relative w-[76px] h-8 neu-pressed rounded-full transition-colors duration-500 cursor-pointer group items-center px-1.5 border-none outline-none">
            <!-- The glowing slider -->
            <div id="theme-toggle-slider" class="absolute left-1.5 w-5 h-5 bg-[#E9582A] rounded-full transition-all duration-500 shadow-[0_0_10px_rgba(233,88,42,0.6)]"></div>
            
            <div class="w-full flex justify-between items-center z-10 px-0.5">
              <!-- Sun icon -->
              <svg class="w-4 h-4 text-slate-500 dark:text-neutral-400 group-hover:text-slate-700 dark:group-hover:text-neutral-200 transition-colors" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"></path>
