    <main class="flex-grow w-full max-w-full mx-auto">
      <slot />
    </main>

    <footer class="bg-[#E9582A] border-t border-[#E9582A]/20 py-12 mt-12 transition-colors duration-300">
      <div class="max-w-[1400px] mx-auto px-8 text-center text-white text-sm font-bold">
        &copy; {new Date().getFullYear()} {profile.name}. All Rights Reserved.
      </div>
    </footer>

    <script is:inline>
      // Theme toggle script
      function setupThemeToggle() {
        const themeToggleBtns = [document.getElementById('theme-toggle'), document.getElementById('theme-toggle-mobile')].filter(Boolean);
        if (themeToggleBtns.length === 0) return;

        themeToggleBtns.forEach(btn => {
          const newBtn = btn.cloneNode(true);
          btn.parentNode.replaceChild(newBtn, btn);

          newBtn.addEventListener('click', function(e) {
            const isDark = document.documentElement.classList.contains('dark');
            
            const toggleTheme = () => {
              if (isDark) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('color-theme', 'light');
              } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('color-theme', 'dark');
              }
            };

            if (!document.startViewTransition) {
              toggleTheme();
              return;
            }

            document.documentElement.classList.add('circle-transition');
            
            // Get click coordinates
            const x = e.clientX || window.innerWidth / 2;
            const y = e.clientY || window.innerHeight / 2;
            const endRadius = Math.hypot(
              Math.max(x, window.innerWidth - x),
              Math.max(y, window.innerHeight - y)
            );

            const transition = document.startViewTransition(toggleTheme);
            
            transition.ready.then(() => {
              const clipPath = [
                `circle(0px at ${x}px ${y}px)`,
                `circle(${endRadius}px at ${x}px ${y}px)`
              ];
              
              document.documentElement.animate(
                { clipPath: clipPath },
                {
                  duration: 700,
                  easing: 'ease-in-out',
                  pseudoElement: '::view-transition-new(root)',
                }
              );
            });
            
            transition.finished.finally(() => {
              document.documentElement.classList.remove('circle-transition');
            });
          });
        });
      }
      
      let navScrollListener = null;

      function setupActiveNav() {
        const mobileLinks = document.querySelectorAll('.mobile-nav-link');
        const desktopLinks = document.querySelectorAll('.desktop-nav-link');
        
        function setActive(href) {
          // Reset
          mobileLinks.forEach(link => {
            link.classList.remove('text-[#eb5b28]', 'dark:text-[#eb5b28]', 'bg-orange-500/10');
            link.classList.add('text-slate-500', 'dark:text-slate-400');
          });
          desktopLinks.forEach(link => {
            link.classList.remove('text-[#eb5b28]', 'dark:text-[#eb5b28]');
            link.classList.add('text-slate-600', 'dark:text-neutral-300');
            const span = link.querySelector('span');
            if(span) span.style.width = '0';
          });

          // Mobile fallback for sections without dedicated icons
          let mobileHref = href;
          if (href === '/#certificates' || href === '/#achievements') {
            mobileHref = '/#experience';
          }

          // Set active
          mobileLinks.forEach(link => {
            if (link.getAttribute('href') === mobileHref) {
              link.classList.remove('text-slate-500', 'dark:text-slate-400');
              link.classList.add('text-[#eb5b28]', 'dark:text-[#eb5b28]', 'bg-orange-500/10');
            }
          });
          desktopLinks.forEach(link => {
            if (link.getAttribute('href') === href) {
              link.classList.remove('text-slate-600', 'dark:text-neutral-300');
              link.classList.add('text-[#eb5b28]', 'dark:text-[#eb5b28]');
              const span = link.querySelector('span');
              if(span) span.style.width = '100%';
            }
          });
        }

        const path = window.location.pathname;

        // Tambahkan fungsi klik manual untuk hash anchor links supaya selalu bisa di scroll meskipun URL-nya tidak berubah
        [...mobileLinks, ...desktopLinks].forEach(link => {
          link.addEventListener('click', (e) => {
            const href = link.getAttribute('href');
            if (href.startsWith('/#') && (path === '/' || path === '')) {
              const targetId = href.substring(2);
              const targetEl = document.getElementById(targetId);
              if (targetEl) {
                e.preventDefault();
                targetEl.scrollIntoView({ behavior: 'smooth' });
                history.pushState(null, null, href);
              }
            } else if (href === '/' && (path === '/' || path === '')) {
              e.preventDefault();
              window.scrollTo({ top: 0, behavior: 'smooth' });
              history.pushState(null, null, href);
            }
          });
        });

        if (navScrollListener) {
          window.removeEventListener('scroll', navScrollListener);
        }

        if (path === '/' || path === '') {
          const sections = Array.from(document.querySelectorAll('section[id]'));
          
          navScrollListener = function() {
            const scrollPos = window.scrollY + window.innerHeight / 3;
            let currentSection = '/';
            
            sections.forEach(sec => {
              const top = sec.offsetTop;
              const height = sec.offsetHeight;
              if (scrollPos >= top && scrollPos < top + height) {
                if (sec.id === 'projects') currentSection = '/projects';
                else if (sec.id === 'articles') currentSection = '/articles';
                else currentSection = '/#' + sec.id;
              }
            });
            
            setActive(currentSection);
          };
          
          window.addEventListener('scroll', navScrollListener, { passive: true });
          navScrollListener(); // trigger once on load
        } else {
          // Other pages
          if (path.startsWith('/projects')) setActive('/projects');
          else if (path.startsWith('/articles')) setActive('/articles');
          else if (path.startsWith('/certificates')) setActive('/#certificates');
        }
      }

      function setupMobileMenu() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const hamburgerIcon = document.getElementById('hamburger-icon');
        const closeIcon = document.getElementById('close-icon');

        if (!menuBtn || !mobileMenu) return;

        function closeMenu() {
          mobileMenu.classList.add('hidden');
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        }

        menuBtn.onclick = function(e) {
          e.stopPropagation();
          const isHidden = mobileMenu.classList.contains('hidden');
          if (isHidden) {
            mobileMenu.classList.remove('hidden');
            hamburgerIcon?.classList.add('hidden');
            closeIcon?.classList.remove('hidden');
          } else {
            closeMenu();
          }
        };

        const links = mobileMenu.querySelectorAll('a');
        links.forEach(link => {
          link.onclick = function() {
            closeMenu();
          };
        });
      }

      // Jalankan saat pertama load dan setiap perpindahan halaman
      setupThemeToggle();
      setupActiveNav();
      setupMobileMenu();
      
      document.addEventListener('astro:page-load', () => {
        setupThemeToggle();
        setupActiveNav();
        setupMobileMenu();
      });
    </script>
  </body>
</html>