---
import '../styles/global.css';
const { title } = Astro.props;
---
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title || 'Fajri Awwaluddin - Portofolio'}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      :root {
        --font-sans: 'Plus Jakarta Sans', sans-serif;
      }
      html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
      }
      body {
        /* Gradien biru muda (cyan) memudar ke putih persis seperti tina.io */
        background: linear-gradient(180deg, #dcf4f5 0%, #ffffff 500px, #ffffff 100%);
        background-repeat: no-repeat;
      }
      .dark body {
        /* Gradien full dark mode */
        background: linear-gradient(180deg, #111111 0%, #000000 500px, #000000 100%);
      }
    </style>
    <script is:inline>
      // Initialize dark mode on load to prevent FOUC
      if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
      } else {
          document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="text-slate-900 dark:text-slate-100 min-h-screen flex flex-col antialiased font-sans selection:bg-orange-100 selection:text-orange-900 dark:selection:bg-orange-500/30 dark:selection:text-orange-200">
    
    <nav class="sticky top-0 w-full z-50 pt-4 pb-4 transition-all duration-300 bg-white/70 dark:bg-black/70 backdrop-blur-xl border-b border-white/20 dark:border-white/5 shadow-sm">
      <div class="max-w-[1400px] mx-auto px-8 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-1.5 text-[22px] font-extrabold tracking-tight text-[#eb5b28] hover:opacity-90 transition-opacity">
          <!-- Clean abstract Llama-like or simple dot to avoid ugly SVG -->
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18.8 4.2C18.4 3.8 17.8 3.5 17.2 3.5H15.8V2C15.8 1.4 15.3 1 14.8 1H11.2C10.7 1 10.2 1.4 10.2 2V3.5H8.8C8.2 3.5 7.6 3.8 7.2 4.2L3.2 8.2C2.8 8.6 2.5 9.2 2.5 9.8V17C2.5 17.6 3 18 3.5 18H5V22C5 22.6 5.4 23 6 23H8C8.6 23 9 22.6 9 22V18H15V22C15 22.6 15.4 23 16 23H18C18.6 23 19 22.6 19 22V18H20.5C21 18 21.5 17.6 21.5 17V9.8C21.5 9.2 21.2 8.6 20.8 8.2L18.8 4.2ZM12 14C10.9 14 10 13.1 10 12C10 10.9 10.9 10 12 10C13.1 10 14 10.9 14 12C14 13.1 13.1 14 12 14Z" fill="#eb5b28"/>
          </svg>
          Fajri Awwaluddin, S.T.
        </a>
        
        <!-- Nav Links -->
        <div class="hidden md:flex items-center gap-8 font-semibold text-sm">
          <a href="/" class="text-slate-600 dark:text-neutral-300 hover:text-[#eb5b28] dark:hover:text-[#eb5b28] transition-colors relative group">
            Home
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#eb5b28] transition-all group-hover:w-full"></span>
          </a>
          <a href="/#experience" class="text-slate-600 dark:text-neutral-300 hover:text-[#eb5b28] dark:hover:text-[#eb5b28] transition-colors relative group">
            Experience
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#eb5b28] transition-all group-hover:w-full"></span>
          </a>
          <a href="/projects" class="text-slate-600 dark:text-neutral-300 hover:text-[#eb5b28] dark:hover:text-[#eb5b28] transition-colors relative group">
            Projects
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#eb5b28] transition-all group-hover:w-full"></span>
          </a>
          <a href="/#certificates" class="text-slate-600 dark:text-neutral-300 hover:text-[#eb5b28] dark:hover:text-[#eb5b28] transition-colors relative group">
            Certificates
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#eb5b28] transition-all group-hover:w-full"></span>
          </a>
          <a href="/articles" class="text-slate-600 dark:text-neutral-300 hover:text-[#eb5b28] dark:hover:text-[#eb5b28] transition-colors relative group">
            Articles
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#eb5b28] transition-all group-hover:w-full"></span>
          </a>
        </div>
        
        <!-- Button (TinaCloud style) -->
        <div class="flex items-center gap-4">
          <a href="/cv-print" target="_blank" class="hidden sm:inline-flex items-center gap-2 bg-[#020617] dark:bg-white text-white dark:text-black px-4 py-2 rounded-full font-bold text-sm hover:bg-[#eb5b28] dark:hover:bg-[#eb5b28] dark:hover:text-white transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Download CV
          </a>
          
          <!-- Theme Toggle -->
          <button id="theme-toggle" type="button" class="hidden sm:flex group relative w-8 h-8 rounded-full overflow-hidden border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#111] items-center justify-center cursor-pointer hover:bg-slate-100 dark:hover:bg-[#222] transition-colors">
            <svg id="theme-toggle-dark-icon" class="hidden w-4 h-4 text-slate-500 dark:text-neutral-400 group-hover:text-slate-800 dark:group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
            <svg id="theme-toggle-light-icon" class="hidden w-4 h-4 text-slate-500 dark:text-neutral-400 group-hover:text-slate-800 dark:group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
            <div class="absolute -bottom-8 bg-slate-800 text-white text-[10px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
              Theme
            </div>
          </button>
          
          <button onclick="document.getElementById('login-modal').classList.remove('hidden'); document.getElementById('login-modal').classList.add('flex')" class="group relative w-8 h-8 rounded-full overflow-hidden border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#111] flex items-center justify-center cursor-pointer hover:bg-[#E9582A] dark:hover:bg-[#E9582A] transition-colors">
            <svg class="w-4 h-4 text-slate-500 dark:text-neutral-400 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
            <div class="absolute -bottom-8 bg-[#E9582A] text-white text-[10px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
              Edit
            </div>
          </button>
        </div>
      </div>
    </nav>

    <main class="flex-grow w-full max-w-7xl mx-auto px-6">
      <slot />
    </main>

    <footer class="bg-white dark:bg-black border-t border-slate-200 dark:border-white/5 py-12 mt-12 transition-colors duration-300">
      <div class="max-w-[1400px] mx-auto px-8 text-center text-slate-500 dark:text-neutral-500 text-sm font-semibold">
        &copy; {new Date().getFullYear()} Fajri Awwaluddin. All Rights Reserved.
      </div>
    </footer>

    <!-- Login Modal -->
    <div id="login-modal" class="hidden fixed inset-0 z-[100] bg-slate-900/40 dark:bg-black/80 backdrop-blur-sm items-center justify-center p-4">
      <div class="bg-white dark:bg-[#111] border dark:border-white/10 rounded-2xl p-8 w-full max-w-sm shadow-2xl relative animate-[fadeIn_0.3s_ease-out]">
        <button onclick="document.getElementById('login-modal').classList.add('hidden'); document.getElementById('login-modal').classList.remove('flex')" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
        
        <div class="text-center mb-6">
          <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          </div>
          <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">Admin Login</h3>
          <p class="text-xs text-slate-500 dark:text-neutral-400 mt-1 font-medium">Enter credentials to edit web content.</p>
        </div>
        
        <form onsubmit="event.preventDefault(); window.handleAdminLogin()" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-neutral-300 mb-1">Username</label>
            <input type="text" id="admin-user" class="w-full border border-slate-200 dark:border-white/10 dark:bg-[#222] dark:text-white rounded-lg px-4 py-2.5 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 dark:focus:ring-blue-500/20 transition-all" required autocomplete="username" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-neutral-300 mb-1">Password</label>
            <input type="password" id="admin-pass" class="w-full border border-slate-200 dark:border-white/10 dark:bg-[#222] dark:text-white rounded-lg px-4 py-2.5 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 dark:focus:ring-blue-500/20 transition-all" required autocomplete="current-password" />
          </div>
          <div id="login-error" class="text-xs text-red-500 font-bold hidden">Invalid credentials!</div>
          <button type="submit" class="w-full bg-[#E9582A] hover:bg-[#d64e22] text-white font-bold py-2.5 rounded-lg transition-colors mt-2">
            Login to CMS
          </button>
        </form>
      </div>
    </div>
    
    <script is:inline>
      // Theme toggle script
      var themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
      var themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');

      // Change the icons inside the button based on previous settings
      if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          themeToggleLightIcon.classList.remove('hidden');
      } else {
          themeToggleDarkIcon.classList.remove('hidden');
      }

      var themeToggleBtn = document.getElementById('theme-toggle');

      themeToggleBtn.addEventListener('click', function() {
          // toggle icons inside button
          themeToggleDarkIcon.classList.toggle('hidden');
          themeToggleLightIcon.classList.toggle('hidden');

          // if set via local storage previously
          if (localStorage.getItem('color-theme')) {
              if (localStorage.getItem('color-theme') === 'light') {
                  document.documentElement.classList.add('dark');
                  localStorage.setItem('color-theme', 'dark');
              } else {
                  document.documentElement.classList.remove('dark');
                  localStorage.setItem('color-theme', 'light');
              }
          // if NOT set via local storage previously
          } else {
              if (document.documentElement.classList.contains('dark')) {
                  document.documentElement.classList.remove('dark');
                  localStorage.setItem('color-theme', 'light');
              } else {
                  document.documentElement.classList.add('dark');
                  localStorage.setItem('color-theme', 'dark');
              }
          }
      });

      window.handleAdminLogin = function() {
        const user = document.getElementById('admin-user').value;
        const pass = document.getElementById('admin-pass').value;
        
        // Simple hardcoded check for demo purposes
        if(user === 'fajri' && pass === 'admin123') {
          window.location.href = '/admin/index.html';
        } else if(user === 'admin' && pass === 'admin123') {
          window.location.href = '/admin/index.html';
        } else {
          document.getElementById('login-error').classList.remove('hidden');
        }
      }
    </script>
  </body>
</html>