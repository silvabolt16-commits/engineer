          <!-- Admin Edit Button (Desktop Only) -->
          <a href="/admin" aria-label="Admin / Edit Content" class="hidden md:flex group relative w-8 h-8 rounded-full neu-flat items-center justify-center cursor-pointer hover:text-[#E9582A] neu-flat-hover transition-all">
            <svg class="w-4 h-4 text-slate-500 dark:text-neutral-400 group-hover:text-[#E9582A] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
            <div class="absolute -bottom-8 bg-[#E9582A] text-white text-[10px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
              Edit
            </div>
