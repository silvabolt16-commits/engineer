---
import '../styles/global.css';
import { getDB, getProfile } from '../lib/d1';
const db = getDB(Astro.locals);
const profile = await getProfile(db) || { name: 'User', bio: '', avatar: '' };
import { ClientRouter } from 'astro:transitions';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
let idPath = currentPath;
let enPath = currentPath;

if (currentPath.startsWith('/en/')) {
  idPath = currentPath.replace('/en/', '/');
} else if (currentPath === '/en') {
  idPath = '/';
} else {
  enPath = currentPath === '/' ? '/en' : `/en${currentPath}`;
}


export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = `${profile.name} - Portofolio`, 
  description = profile.bio, 
  image = profile.avatar 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://fajriawwaluddin.com');

let faviconUrl = profile.avatar || '';
let favicon48 = '';
let favicon192 = '';
if (faviconUrl && faviconUrl.includes('cloudinary.com')) {
  faviconUrl = faviconUrl.replace('/upload/', '/upload/c_thumb,g_face,w_120,h_120,r_max/');
  favicon48 = profile.avatar.replace('/upload/', '/upload/c_thumb,g_face,w_48,h_48,r_max,f_png/');
  favicon192 = profile.avatar.replace('/upload/', '/upload/c_thumb,g_face,w_192,h_192,r_max,f_png/');
}
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <!-- Favicon: Google Search prefers PNG, 48x48 multiples -->
    <link rel="icon" type="image/png" sizes="48x48" href={favicon48 || faviconUrl} />
    <link rel="icon" type="image/png" sizes="192x192" href={favicon192 || faviconUrl} />
    <link rel="icon" href={faviconUrl} />
    <link rel="apple-touch-icon" sizes="192x192" href={favicon192 || faviconUrl} />
    
    <!-- SEO & Metadata -->
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <ClientRouter />
    <!-- Google Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style is:global>
      :root {
        --font-sans: 'Plus Jakarta Sans', sans-serif;
      }
      html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
      }
      body {
        /* Neumorphism Light Mode Background */
        background-color: #ecf0f3;
        color: #333333;
      }
      .dark body {
        /* Neumorphism Dark Mode Background */
        background-color: #1a1a1a;
        color: #e5e5e5;
      }
      
      /* Neumorphism Utility Classes */
      .neu-flat {
        background-color: #ecf0f3;
        box-shadow: 9px 9px 16px rgb(163,177,198,0.6), -9px -9px 16px rgba(255,255,255, 0.5);
      }
      .dark .neu-flat {
        background-color: #1a1a1a;
        box-shadow: 8px 8px 16px #101010, -8px -8px 16px #242424;
      }
      
      .neu-pressed {
        background-color: #ecf0f3;
        box-shadow: inset 6px 6px 10px 0 rgba(163, 177, 198, 0.7), inset -6px -6px 10px 0 rgba(255, 255, 255, 0.8);
      }
      .dark .neu-pressed {
        background-color: #1a1a1a;
        box-shadow: inset 6px 6px 10px 0 #101010, inset -6px -6px 10px 0 #242424;
      }
      
      /* Hover efek timbul */
      .neu-flat-hover:hover {
        box-shadow: 12px 12px 20px rgb(163,177,198,0.7), -12px -12px 20px rgba(255,255,255, 0.6);
        transform: translateY(-2px);
      }
      .dark .neu-flat-hover:hover {
        box-shadow: 12px 12px 20px #0d0d0d, -12px -12px 20px #272727;
        transform: translateY(-2px);
      }
      
      /* Fix Browser Autofill */
      input:-webkit-autofill,
      input:-webkit-autofill:hover, 
      input:-webkit-autofill:focus, 
      input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 30px #ecf0f3 inset !important;
        -webkit-text-fill-color: #333333 !important;
        transition: background-color 5000s ease-in-out 0s;
      }
      .dark input:-webkit-autofill,
      .dark input:-webkit-autofill:hover, 
      .dark input:-webkit-autofill:focus, 
      .dark input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 30px #1a1a1a inset !important;
        -webkit-text-fill-color: #e5e5e5 !important;
        transition: background-color 5000s ease-in-out 0s;
      }
      /* Animasi Theme Toggle: Circular */
      .circle-transition::view-transition-old(root),
      .circle-transition::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }
      .circle-transition::view-transition-old(root) {
        z-index: 1;
      }
      .circle-transition::view-transition-new(root) {
        z-index: 9999;
      }
      @keyframes lightning {
        0% { opacity: 0; background-color: #fff; }
        10% { opacity: 1; }
        20% { opacity: 0; }
        30% { opacity: 1; }
        40% { opacity: 0; background-color: #fff; }
        50% { opacity: 1; background-color: #fef08a; }
        100% { opacity: 0; }
      }
      .animate-lightning {
        animation: lightning 0.5s ease-out forwards !important;
      }
    </style>
    <script is:inline>
      // Initialize dark mode on load to prevent FOUC
      function initTheme() {
        if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
      }
      initTheme();
      document.addEventListener('astro:after-swap', initTheme);
    </script>
  </head>
  <body class="text-slate-900 dark:text-slate-100 min-h-screen flex flex-col antialiased font-sans selection:bg-orange-100 selection:text-orange-900 dark:selection:bg-orange-500/30 dark:selection:text-orange-200 overflow-x-hidden">
    
    <!-- Lightning Flash Overlay -->
    <div id="lightning-flash" class="fixed inset-0 bg-white z-[9999] opacity-0 pointer-events-none transition-none"></div>

    <nav class="sticky top-0 w-full z-50 pt-3 pb-3 md:pt-4 md:pb-4 transition-all duration-300 neu-flat rounded-b-3xl mb-4 md:mb-8">
      <div class="max-w-[1400px] mx-auto px-6 md:px-8 flex justify-between items-center">
        <!-- Logo -->
        <a href="/" class="text-xl md:text-2xl font-extrabold tracking-tighter text-slate-800 dark:text-white flex items-center gap-2 md:gap-3 group relative z-10 cursor-pointer active:scale-95 transition-transform">
          <div class="w-8 h-8 md:w-10 md:h-10 rounded-full neu-flat overflow-hidden group-hover:scale-110 transition-transform duration-300 border-2 border-transparent dark:border-slate-800">
            <img src={profile.avatar} alt={profile.name} class="w-full h-full object-cover pointer-events-none" />
          </div>
          <span class="pointer-events-none">{profile.name.split(' ')[0]}</span>
        </a>
        
        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center gap-8 font-semibold text-[15px]">
          <a href={lang === 'en' ? '/en' : '/'} class="desktop-nav-link text-slate-600 dark:text-neutral-300 hover:text-[#eb5b28] dark:hover:text-[#eb5b28] transition-colors relative group">
            {t('about.title')}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#eb5b28] transition-all group-hover:w-full"></span>
          </a>
          <a href={lang === 'en' ? '/en#keahlian' : '/#keahlian'} class="desktop-nav-link text-slate-600 dark:text-neutral-300 hover:text-[#eb5b28] dark:hover:text-[#eb5b28] transition-colors relative group">
            {t('skills.title')}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#eb5b28] transition-all group-hover:w-full"></span>
          </a>
          <a href={lang === 'en' ? '/en#pengalaman' : '/#pengalaman'} class="desktop-nav-link text-slate-600 dark:text-neutral-300 hover:text-[#eb5b28] dark:hover:text-[#eb5b28] transition-colors relative group">
            {t('nav.experiences')}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#eb5b28] transition-all group-hover:w-full"></span>
          </a>
          <a href={lang === 'en' ? '/en#sertifikat' : '/#sertifikat'} class="desktop-nav-link text-slate-600 dark:text-neutral-300 hover:text-[#eb5b28] dark:hover:text-[#eb5b28] transition-colors relative group">
            {t('experiences.tab.certificates')}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#eb5b28] transition-all group-hover:w-full"></span>
          </a>
          <a href={lang === 'en' ? '/en#pencapaian' : '/#pencapaian'} class="desktop-nav-link text-slate-600 dark:text-neutral-300 hover:text-[#eb5b28] dark:hover:text-[#eb5b28] transition-colors relative group">
            {t('experiences.tab.achievements')}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#eb5b28] transition-all group-hover:w-full"></span>
          </a>
          <a href={lang === 'en' ? '/en/proyek' : '/proyek'} class="desktop-nav-link text-slate-600 dark:text-neutral-300 hover:text-[#eb5b28] dark:hover:text-[#eb5b28] transition-colors relative group">
            {t('nav.projects')}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#eb5b28] transition-all group-hover:w-full"></span>
          </a>
          <a href={lang === 'en' ? '/en/artikel' : '/artikel'} class="desktop-nav-link text-slate-600 dark:text-neutral-300 hover:text-[#eb5b28] dark:hover:text-[#eb5b28] transition-colors relative group">
            {t('nav.articles')}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#eb5b28] transition-all group-hover:w-full"></span>
