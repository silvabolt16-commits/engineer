---
import '../styles/global.css';
import { getProfile } from '../firebase/content';
const profile = await getProfile();
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = `${profile.name} - Portofolio`, 
  description = profile.bio, 
  image = profile.avatar 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://fajriawwaluddin.com');
const safeAvatarUrl = (profile.avatar || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;');
const circularFavicon = `data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><mask id="c"><circle cx="50" cy="50" r="50" fill="%23fff"/></mask><image href="${safeAvatarUrl}" width="100" height="100" preserveAspectRatio="xMidYMid slice" mask="url(%23c)"/></svg>`;
---
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <!-- Circular Favicon / Tab Icon (Synced with Profile Avatar) -->
    <link rel="icon" type="image/svg+xml" href={circularFavicon} />
    <link rel="shortcut icon" type="image/svg+xml" href={circularFavicon} />
    <link rel="apple-touch-icon" href={profile.avatar} />

    <script is:inline define:vars={{ avatarUrl: profile.avatar }}>
      (function() {
        if (!avatarUrl) return;
        const img = new Image();
        img.crossOrigin = 'Anonymous';
        img.onload = function() {
          try {
            const canvas = document.createElement('canvas');
            canvas.width = 64;
            canvas.height = 64;
            const ctx = canvas.getContext('2d');
            if (!ctx) return;
            ctx.beginPath();
            ctx.arc(32, 32, 32, 0, Math.PI * 2);
            ctx.closePath();
            ctx.clip();
            ctx.drawImage(img, 0, 0, 64, 64);
            const iconUrl = canvas.toDataURL('image/png');
            let link = document.querySelector("link[rel='icon'][type='image/png']");
            if (!link) {
              link = document.createElement('link');
              link.rel = 'icon';
              link.type = 'image/png';
              document.head.appendChild(link);
            }
            link.href = iconUrl;
          } catch(e) {}
        };
        img.src = avatarUrl;
      })();
    </script>
    
    <!-- SEO & Metadata -->
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style is:global>
      :root {
        --font-sans: 'Plus Jakarta Sans', sans-serif;
      }
      html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
      }
      body {
        /* Neumorphism Light Mode Background */
        background-color: #ecf0f3;
        color: #333333;
      }
      .dark body {
        /* Neumorphism Dark Mode Background */
        background-color: #1a1a1a;
        color: #e5e5e5;
      }
      
      /* Neumorphism Utility Classes */
      .neu-flat {
        background-color: #ecf0f3;
        box-shadow: 9px 9px 16px rgb(163,177,198,0.6), -9px -9px 16px rgba(255,255,255, 0.5);
      }
      .dark .neu-flat {
        background-color: #1a1a1a;
        box-shadow: 8px 8px 16px #101010, -8px -8px 16px #242424;
      }
      
      .neu-pressed {
        background-color: #ecf0f3;
        box-shadow: inset 6px 6px 10px 0 rgba(163, 177, 198, 0.7), inset -6px -6px 10px 0 rgba(255, 255, 255, 0.8);
      }
      .dark .neu-pressed {
        background-color: #1a1a1a;
        box-shadow: inset 6px 6px 10px 0 #101010, inset -6px -6px 10px 0 #242424;
      }
      
      /* Hover efek timbul */
      .neu-flat-hover:hover {
        box-shadow: 12px 12px 20px rgb(163,177,198,0.7), -12px -12px 20px rgba(255,255,255, 0.6);
        transform: translateY(-2px);
      }
      .dark .neu-flat-hover:hover {
        box-shadow: 12px 12px 20px #0d0d0d, -12px -12px 20px #272727;
        transform: translateY(-2px);
      }
      /* Animasi Theme Toggle: Circular */
      .circle-transition::view-transition-old(root),
      .circle-transition::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }
      .circle-transition::view-transition-old(root) {
        z-index: 1;
      }
      .circle-transition::view-transition-new(root) {
        z-index: 9999;
      }
      @keyframes lightning {
        0% { opacity: 0; background-color: #fff; }
        10% { opacity: 1; }
        20% { opacity: 0; }
        30% { opacity: 1; }
        40% { opacity: 0; background-color: #fff; }
        50% { opacity: 1; background-color: #fef08a; }
        100% { opacity: 0; }
      }
      .animate-lightning {
        animation: lightning 0.5s ease-out forwards !important;
      }
    </style>
    <script is:inline>
      // Initialize dark mode on load to prevent FOUC
      function initTheme() {
        if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
      }
      initTheme();
      document.addEventListener('astro:after-swap', initTheme);
    </script>
  </head>
  <body class="text-slate-900 dark:text-slate-100 min-h-screen flex flex-col antialiased font-sans selection:bg-orange-100 selection:text-orange-900 dark:selection:bg-orange-500/30 dark:selection:text-orange-200 overflow-x-hidden">
    
