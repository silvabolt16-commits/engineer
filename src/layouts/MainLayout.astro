          <!-- Hamburger Menu Button (3 Lines) -->
          <button id="mobile-menu-btn" type="button" aria-label="Toggle Menu" class="md:hidden w-9 h-9 neu-flat rounded-full flex items-center justify-center text-slate-700 dark:text-neutral-200 hover:text-[#E9582A] neu-flat-hover transition-all border-none cursor-pointer">
