        <div class="flex flex-col gap-1 font-medium text-sm">
          <a href={lang === 'en' ? '/en' : '/'} class="mobile-nav-link px-3.5 py-2.5 rounded-xl hover:bg-slate-200/60 dark:hover:bg-neutral-800/80 hover:text-[#E9582A] dark:hover:text-[#E9582A] transition-colors flex items-center gap-3 text-slate-700 dark:text-neutral-200">
            <svg class="w-4 h-4 text-[#E9582A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            <span>{t('about.title')}</span>
          </a>
          <a href={lang === 'en' ? '/en#keahlian' : '/#keahlian'} class="mobile-nav-link px-3.5 py-2.5 rounded-xl hover:bg-slate-200/60 dark:hover:bg-neutral-800/80 hover:text-[#E9582A] dark:hover:text-[#E9582A] transition-colors flex items-center gap-3 text-slate-700 dark:text-neutral-200">
            <svg class="w-4 h-4 text-[#E9582A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            <span>{t('skills.title')}</span>
          </a>
          <a href={lang === 'en' ? '/en#pengalaman' : '/#pengalaman'} class="mobile-nav-link px-3.5 py-2.5 rounded-xl hover:bg-slate-200/60 dark:hover:bg-neutral-800/80 hover:text-[#E9582A] dark:hover:text-[#E9582A] transition-colors flex items-center gap-3 text-slate-700 dark:text-neutral-200">
            <svg class="w-4 h-4 text-[#E9582A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <span>{t('nav.experiences')}</span>
          </a>
          <a href={lang === 'en' ? '/en#sertifikat' : '/#sertifikat'} class="mobile-nav-link px-3.5 py-2.5 rounded-xl hover:bg-slate-200/60 dark:hover:bg-neutral-800/80 hover:text-[#E9582A] dark:hover:text-[#E9582A] transition-colors flex items-center gap-3 text-slate-700 dark:text-neutral-200">
            <svg class="w-4 h-4 text-[#E9582A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>{t('experiences.tab.certificates')}</span>
          </a>
          <a href={lang === 'en' ? '/en#pencapaian' : '/#pencapaian'} class="mobile-nav-link px-3.5 py-2.5 rounded-xl hover:bg-slate-200/60 dark:hover:bg-neutral-800/80 hover:text-[#E9582A] dark:hover:text-[#E9582A] transition-colors flex items-center gap-3 text-slate-700 dark:text-neutral-200">
            <svg class="w-4 h-4 text-[#E9582A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
            <span>{t('experiences.tab.achievements')}</span>
          </a>
          <a href={lang === 'en' ? '/en/proyek' : '/proyek'} class="mobile-nav-link px-3.5 py-2.5 rounded-xl hover:bg-slate-200/60 dark:hover:bg-neutral-800/80 hover:text-[#E9582A] dark:hover:text-[#E9582A] transition-colors flex items-center gap-3 text-slate-700 dark:text-neutral-200">
            <svg class="w-4 h-4 text-[#E9582A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
            <span>{t('nav.projects')}</span>
          </a>
          <a href={lang === 'en' ? '/en/artikel' : '/artikel'} class="mobile-nav-link px-3.5 py-2.5 rounded-xl hover:bg-slate-200/60 dark:hover:bg-neutral-800/80 hover:text-[#E9582A] dark:hover:text-[#E9582A] transition-colors flex items-center gap-3 text-slate-700 dark:text-neutral-200">
            <svg class="w-4 h-4 text-[#E9582A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
            <span>{t('nav.articles')}</span>
          </a>

          <div class="my-1 border-t border-slate-300/50 dark:border-neutral-700/50"></div>

          <a href="/admin" class="mobile-nav-link px-3.5 py-2.5 rounded-xl hover:bg-slate-200/60 dark:hover:bg-neutral-800/80 hover:text-[#E9582A] dark:hover:text-[#E9582A] transition-colors flex items-center gap-3 text-slate-700 dark:text-neutral-200">
            <svg class="w-4 h-4 text-[#E9582A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            <span>Admin Panel</span>
          </a>

          <!-- Mobile Theme Toggle (Model Saklar Slider) -->
          <div class="px-3.5 py-2.5 rounded-xl hover:bg-slate-200/60 dark:hover:bg-neutral-800/80 transition-colors flex items-center justify-between text-slate-700 dark:text-neutral-200">
            <span class="text-sm font-medium flex items-center gap-3">
              <svg class="w-4 h-4 text-[#E9582A] block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
              <svg class="w-4 h-4 text-[#E9582A] hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
              <span class="block dark:hidden">Mode Terang</span>
              <span class="hidden dark:block">Mode Gelap</span>
            </span>

            <button id="theme-toggle-mobile" type="button" aria-label="Toggle Dark Mode" class="relative w-[64px] h-7 neu-pressed rounded-full transition-colors duration-500 cursor-pointer group flex items-center px-1 border-none outline-none">
               <!-- The glowing slider -->
               <div id="theme-toggle-mobile-slider" class="absolute left-1 w-4 h-4 bg-[#E9582A] rounded-full transition-all duration-500 shadow-[0_0_10px_rgba(233,88,42,0.6)] z-10"></div>
               
               <div class="w-full flex justify-between items-center z-10 px-0.5">
                 <svg class="w-3.5 h-3.5 text-slate-500 dark:text-neutral-400 transition-colors" fill="currentColor" viewBox="0 0 20 20">
                   <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"></path>
                 </svg>
                 <svg class="w-3.5 h-3.5 text-slate-500 dark:text-neutral-400 transition-colors" fill="currentColor" viewBox="0 0 20 20">
                   <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                 </svg>
               </div>
            </button>
          </div>
        </div>
      </div>
    </nav>
    <main class="flex-grow w-full max-w-full mx-auto">
      <slot />
    </main>

    <footer class="bg-[#E9582A] border-t border-[#E9582A]/20 py-12 mt-12 transition-colors duration-300">
      <div class="max-w-[1400px] mx-auto px-8 text-center text-white text-sm font-bold">
        &copy; {new Date().getFullYear()} {profile.name}
      </div>
    </footer>

    <script is:inline>
      // Theme toggle script
      function setupThemeToggle() {
        const themeToggleBtns = [document.getElementById('theme-toggle'), document.getElementById('theme-toggle-mobile')].filter(Boolean);
        
        const updateSliders = () => {
          const isDark = document.documentElement.classList.contains('dark');
          const desktopSlider = document.getElementById('theme-toggle-slider');
          if (desktopSlider) {
            desktopSlider.style.transform = isDark ? 'translateX(44px)' : 'translateX(0)';
            desktopSlider.style.backgroundColor = isDark ? '#9333ea' : '#E9582A'; // Purple for dark
            desktopSlider.style.boxShadow = isDark ? '0 0 10px rgba(147,51,234,0.6)' : '0 0 10px rgba(233,88,42,0.6)';
          }
          const mobileSlider = document.getElementById('theme-toggle-mobile-slider');
          if (mobileSlider) {
            mobileSlider.style.transform = isDark ? 'translateX(40px)' : 'translateX(0)';
            mobileSlider.style.backgroundColor = isDark ? '#9333ea' : '#E9582A';
            mobileSlider.style.boxShadow = isDark ? '0 0 10px rgba(147,51,234,0.6)' : '0 0 10px rgba(233,88,42,0.6)';
          }
        };

        // Initialize sliders
        updateSliders();

        if (themeToggleBtns.length === 0) return;

        themeToggleBtns.forEach(btn => {
          const newBtn = btn.cloneNode(true);
          btn.parentNode.replaceChild(newBtn, btn);

          newBtn.addEventListener('click', function(e) {
            const isDark = document.documentElement.classList.contains('dark');
            
            const toggleTheme = () => {
              if (isDark) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('color-theme', 'light');
              } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('color-theme', 'dark');
              }
              updateSliders();
            };

            if (!document.startViewTransition) {
              toggleTheme();
              return;
            }

            document.documentElement.classList.add('circle-transition');
            
            // Always use the button's screen position for reliable coordinates on all devices
            const _r = this.getBoundingClientRect();
            const x = _r.left + _r.width / 2;
            const y = _r.top + _r.height / 2;
            const endRadius = Math.hypot(
              Math.max(x, window.innerWidth - x),
              Math.max(y, window.innerHeight - y)
            );

            const transition = document.startViewTransition(toggleTheme);
            
            transition.ready.then(() => {
              const clipPath = [
                `circle(0px at ${x}px ${y}px)`,
                `circle(${endRadius}px at ${x}px ${y}px)`
              ];
              
              document.documentElement.animate(
                { clipPath: clipPath },
                {
                  duration: 700,
                  easing: 'ease-in-out',
                  pseudoElement: '::view-transition-new(root)',
                }
              );
            });
            
            transition.finished.finally(() => {
              document.documentElement.classList.remove('circle-transition');
            });
          });
        });
      }
      
      let navScrollListener = null;

      function setupActiveNav() {
        const mobileLinks = document.querySelectorAll('.mobile-nav-link');
        const desktopLinks = document.querySelectorAll('.desktop-nav-link');
        
        function setActive(href) {
          // Reset
          mobileLinks.forEach(link => {
            link.classList.remove('text-[#eb5b28]', 'dark:text-[#eb5b28]', 'bg-orange-500/10');
            link.classList.add('text-slate-500', 'dark:text-slate-400');
          });
          desktopLinks.forEach(link => {
            link.classList.remove('text-[#eb5b28]', 'dark:text-[#eb5b28]');
            link.classList.add('text-slate-600', 'dark:text-neutral-300');
            const span = link.querySelector('span');
            if(span) span.style.width = '0';
          });

          // Mobile fallback for sections without dedicated icons
          let mobileHref = href;

          // Set active
          mobileLinks.forEach(link => {
            if (link.getAttribute('href') === mobileHref) {
              link.classList.remove('text-slate-500', 'dark:text-slate-400');
              link.classList.add('text-[#eb5b28]', 'dark:text-[#eb5b28]', 'bg-orange-500/10');
            }
          });
          desktopLinks.forEach(link => {
            if (link.getAttribute('href') === href) {
              link.classList.remove('text-slate-600', 'dark:text-neutral-300');
              link.classList.add('text-[#eb5b28]', 'dark:text-[#eb5b28]');
              const span = link.querySelector('span');
              if(span) span.style.width = '100%';
            }
          });
        }

        const path = window.location.pathname;

        // Tambahkan fungsi klik manual untuk hash anchor links supaya selalu bisa di scroll meskipun URL-nya tidak berubah
        [...mobileLinks, ...desktopLinks].forEach(link => {
          link.addEventListener('click', (e) => {
            const href = link.getAttribute('href');
            if (href.startsWith('/#') && (path === '/' || path === '')) {
              const targetId = href.substring(2);
              const targetEl = document.getElementById(targetId);
              if (targetEl) {
                e.preventDefault();
                targetEl.scrollIntoView({ behavior: 'smooth' });
                history.pushState(null, null, href);
              }
            } else if (href === '/' && (path === '/' || path === '')) {
              e.preventDefault();
              window.scrollTo({ top: 0, behavior: 'smooth' });
              history.pushState(null, null, href);
            }
          });
        });

        if (navScrollListener) {
          window.removeEventListener('scroll', navScrollListener);
        }

        if (path === '/' || path === '') {
          const sections = Array.from(document.querySelectorAll('section[id]'));
          
          navScrollListener = function() {
            const scrollPos = window.scrollY + window.innerHeight / 3;
            let currentSection = '/';
            
            sections.forEach(sec => {
              const top = sec.offsetTop;
              const height = sec.offsetHeight;
              if (scrollPos >= top && scrollPos < top + height) {
                if (sec.id === 'proyek') currentSection = '/proyek';
                else if (sec.id === 'artikel') currentSection = '/artikel';
                else currentSection = '/#' + sec.id;
              }
            });
            
            setActive(currentSection);
          };
          
          window.addEventListener('scroll', navScrollListener, { passive: true });
          navScrollListener(); // trigger once on load
        } else {
          // Other pages
          if (path.startsWith('/proyek')) setActive('/proyek');
          else if (path.startsWith('/artikel')) setActive('/artikel');
          else if (path.startsWith('/sertifikat')) setActive('/#sertifikat');
          else if (path.startsWith('/pencapaian')) setActive('/#pencapaian');
        }
      }

      function setupMobileMenu() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const hamburgerIcon = document.getElementById('hamburger-icon');
        const closeIcon = document.getElementById('close-icon');

        if (!menuBtn || !mobileMenu) return;

        function closeMenu() {
          mobileMenu.classList.add('hidden');
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        }

        menuBtn.onclick = function(e) {
          e.stopPropagation();
          const isHidden = mobileMenu.classList.contains('hidden');
          if (isHidden) {
            mobileMenu.classList.remove('hidden');
            hamburgerIcon?.classList.add('hidden');
            closeIcon?.classList.remove('hidden');
          } else {
            closeMenu();
          }
        };

        const onDocClick = function(e) {
          if (!mobileMenu.contains(e.target) && !menuBtn.contains(e.target)) {
            closeMenu();
          }
        };
        document.removeEventListener('click', onDocClick);
        document.addEventListener('click', onDocClick);

        const links = mobileMenu.querySelectorAll('a');
        links.forEach(link => {
          link.onclick = function() {
            closeMenu();
          };
        });
      }

      function setupLangMenu() {
        const langBtn = document.getElementById('lang-menu-btn');
        const langMenu = document.getElementById('lang-menu');

        if (!langBtn || !langMenu) return;

        langBtn.onclick = function(e) {
          e.stopPropagation();
          langMenu.classList.toggle('hidden');
        };

        document.addEventListener('click', function(e) {
          if (!langMenu.contains(e.target) && !langBtn.contains(e.target)) {
            langMenu.classList.add('hidden');
          }
        });
      }

      // Jalankan saat pertama load dan setiap perpindahan halaman
      setupThemeToggle();
      setupActiveNav();
      setupMobileMenu();
      setupLangMenu();
      
      document.addEventListener('astro:page-load', () => {
        setupThemeToggle();
        setupActiveNav();
        setupMobileMenu();
        setupLangMenu();
      });
    </script>
  </body>
</html>
