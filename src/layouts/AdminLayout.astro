---
import '../styles/global.css';

export interface Props {
  title?: string;
}

const { title = 'Admin Panel - Portofolio' } = Astro.props;
---
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --font-sans: 'Plus Jakarta Sans', sans-serif;
        --neu-bg-light: #ecf0f3;
        --neu-bg-dark: #1a1a1a;
        --accent: #E9582A;
      }
      html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
      }
      body {
        background-color: var(--neu-bg-light);
        color: #333333;
        min-height: 100vh;
      }
      html.dark body {
        background-color: var(--neu-bg-dark);
        color: #e5e5e5;
      }

      /* Neumorphism Utility Classes */
      .neu-flat {
        background-color: var(--neu-bg-light);
        box-shadow: 9px 9px 16px rgba(163,177,198,0.6), -9px -9px 16px rgba(255,255,255,0.5);
      }
      html.dark .neu-flat {
        background-color: var(--neu-bg-dark);
        box-shadow: 8px 8px 16px #101010, -8px -8px 16px #242424;
      }

      .neu-pressed {
        background-color: var(--neu-bg-light);
        box-shadow: inset 6px 6px 10px 0 rgba(163,177,198,0.7), inset -6px -6px 10px 0 rgba(255,255,255,0.8);
      }
      html.dark .neu-pressed {
        background-color: var(--neu-bg-dark);
        box-shadow: inset 6px 6px 10px 0 #101010, inset -6px -6px 10px 0 #242424;
      }

      .neu-flat-hover:hover {
        box-shadow: 12px 12px 20px rgba(163,177,198,0.7), -12px -12px 20px rgba(255,255,255,0.6);
        transform: translateY(-2px);
      }
      html.dark .neu-flat-hover:hover {
        box-shadow: 12px 12px 20px #0d0d0d, -12px -12px 20px #272727;
        transform: translateY(-2px);
      }

      /* Form inputs inherit Neumorphism background */
      input, textarea, select {
        background-color: var(--neu-bg-light);
        color: #333333;
      }
      html.dark input, html.dark textarea, html.dark select {
        background-color: var(--neu-bg-dark);
        color: #e5e5e5;
      }
    </style>
    <script is:inline>
      // Initialize dark mode early to prevent FOUC
      (function() {
        if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="antialiased font-sans">
    <!-- Admin Header Bar -->
    <header class="sticky top-0 z-50 neu-flat" style="border-bottom: 1px solid rgba(163,177,198,0.3);">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <!-- Logo / Brand -->
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full flex items-center justify-center" style="background-color: #E9582A;">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-extrabold text-slate-800 dark:text-white uppercase tracking-widest leading-none">Admin Panel</p>
            <p class="text-[10px] text-slate-400 dark:text-neutral-500 font-medium uppercase tracking-wider mt-0.5">Portofolio Manager</p>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3">
          <button id="admin-theme-toggle" type="button" aria-label="Toggle Dark Mode" class="w-8 h-8 neu-flat rounded-full flex items-center justify-center text-slate-600 dark:text-neutral-300 transition-all" style="cursor:pointer;">
            <!-- Moon icon: show in light mode (click to switch to dark) -->
            <svg class="w-4 h-4 block dark:hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
            <!-- Sun icon: show in dark mode -->
            <svg class="w-4 h-4 hidden dark:block" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"></path></svg>
          </button>
          <a href="/" target="_blank" class="px-3 py-1.5 neu-flat rounded-xl text-xs font-bold text-slate-600 dark:text-neutral-300 uppercase tracking-wider transition-all" style="text-decoration:none;">
            Lihat Web ↗
          </a>
        </div>
      </div>
    </header>

    <main class="min-h-screen">
      <slot />
    </main>

    <script is:inline>
      const btn = document.getElementById('admin-theme-toggle');
      if (btn) {
        btn.addEventListener('click', function() {
          const isDark = document.documentElement.classList.contains('dark');
          if (isDark) {
            document.documentElement.classList.remove('dark');
            localStorage.setItem('color-theme', 'light');
          } else {
            document.documentElement.classList.add('dark');
            localStorage.setItem('color-theme', 'dark');
          }
        });
      }
    </script>
  </body>
</html>
