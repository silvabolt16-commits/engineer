---
import '../styles/global.css';
import { getDB, getProfile } from '../lib/d1';

export interface Props {
  title?: string;
}

const { title = 'Admin Panel - Portofolio' } = Astro.props;

const db = getDB(Astro.locals);
const profile = await getProfile(db).catch(() => null) || { avatar: '' };

let faviconUrl = profile.avatar || '';
if (faviconUrl && faviconUrl.includes('cloudinary.com')) {
  faviconUrl = faviconUrl.replace('/upload/', '/upload/c_thumb,g_face,w_120,h_120,r_max/');
}
---
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    
    <!-- Circular Favicon / Tab Icon (Synced with Profile Avatar) -->
    <link rel="icon" href={faviconUrl} />
    <link rel="shortcut icon" href={faviconUrl} />
    <link rel="apple-touch-icon" href={faviconUrl} />
    
    <!-- Google Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --font-sans: 'Plus Jakarta Sans', sans-serif;
        --neu-bg-light: #ecf0f3;
        --neu-bg-dark: #1a1a1a;
        --accent: #E9582A;
      }
      html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
      }
      body {
        background-color: var(--neu-bg-light);
        color: #333333;
        min-height: 100vh;
      }
      html.dark body {
        background-color: var(--neu-bg-dark);
        color: #e5e5e5;
      }

      /* Neumorphism Utility Classes */
      .neu-flat {
        background-color: var(--neu-bg-light);
        box-shadow: 9px 9px 16px rgba(163,177,198,0.6), -9px -9px 16px rgba(255,255,255,0.5);
      }
      html.dark .neu-flat {
        background-color: var(--neu-bg-dark);
        box-shadow: 8px 8px 16px #101010, -8px -8px 16px #242424;
      }

      .neu-pressed {
        background-color: var(--neu-bg-light);
        box-shadow: inset 6px 6px 10px 0 rgba(163,177,198,0.7), inset -6px -6px 10px 0 rgba(255,255,255,0.8);
      }
      html.dark .neu-pressed {
        background-color: var(--neu-bg-dark);
        box-shadow: inset 6px 6px 10px 0 #101010, inset -6px -6px 10px 0 #242424;
      }

      .neu-flat-hover:hover {
        box-shadow: 12px 12px 20px rgba(163,177,198,0.7), -12px -12px 20px rgba(255,255,255,0.6);
        transform: translateY(-2px);
      }
      html.dark .neu-flat-hover:hover {
        box-shadow: 12px 12px 20px #0d0d0d, -12px -12px 20px #272727;
        transform: translateY(-2px);
      }

      /* Form inputs inherit Neumorphism background */
      input, textarea, select {
        background-color: var(--neu-bg-light);
        color: #333333;
      }
      html.dark input, html.dark textarea, html.dark select {
        background-color: var(--neu-bg-dark);
        color: #e5e5e5;
      }
      
      /* Fix Browser Autofill (e.g. Chrome password fill) */
      input:-webkit-autofill,
      input:-webkit-autofill:hover, 
      input:-webkit-autofill:focus, 
      input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 30px var(--neu-bg-light) inset !important;
        -webkit-text-fill-color: #333333 !important;
        transition: background-color 5000s ease-in-out 0s;
      }
      html.dark input:-webkit-autofill,
      html.dark input:-webkit-autofill:hover, 
      html.dark input:-webkit-autofill:focus, 
      html.dark input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 30px var(--neu-bg-dark) inset !important;
        -webkit-text-fill-color: #e5e5e5 !important;
        transition: background-color 5000s ease-in-out 0s;
      }

      /* Animasi Theme Toggle: Circular */
      .circle-transition::view-transition-old(root),
      .circle-transition::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }
      .circle-transition::view-transition-old(root) {
        z-index: 1;
      }
      .circle-transition::view-transition-new(root) {
        z-index: 9999;
      }
    </style>
    <script is:inline>
      // Initialize dark mode early to prevent FOUC
      (function() {
        if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="antialiased font-sans">
    <!-- Admin Header Bar -->
    <header class="sticky top-0 z-50 neu-flat" style="border-bottom: 1px solid rgba(163,177,198,0.3);">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <!-- Logo / Brand -->
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full flex items-center justify-center" style="background-color: #E9582A;">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-extrabold text-slate-800 dark:text-white uppercase tracking-widest leading-none">Admin Panel</p>
            
          </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3">
          <button id="admin-theme-toggle" type="button" aria-label="Toggle Dark Mode" class="relative shrink-0 w-[76px] h-8 neu-pressed rounded-full transition-colors duration-500 cursor-pointer group flex items-center px-1.5 border-none outline-none">
            <!-- The glowing slider -->
            <div id="admin-theme-toggle-slider" class="absolute left-1.5 w-5 h-5 bg-[#E9582A] rounded-full transition-all duration-500 shadow-[0_0_10px_rgba(233,88,42,0.6)]"></div>
            
            <div class="w-full flex justify-between items-center z-10 px-0.5">
              <!-- Sun icon -->
              <svg class="w-4 h-4 text-slate-500 dark:text-neutral-400 group-hover:text-slate-700 dark:group-hover:text-neutral-200 transition-colors" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"></path>
              </svg>
              <!-- Moon icon -->
              <svg class="w-4 h-4 text-slate-500 dark:text-neutral-400 group-hover:text-slate-700 dark:group-hover:text-neutral-200 transition-colors" fill="currentColor" viewBox="0 0 20 20">
                <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
              </svg>
            </div>
          </button>
          <a href="/" target="_blank" title="Lihat Web" class="w-8 h-8 neu-flat rounded-xl flex items-center justify-center text-slate-600 dark:text-neutral-300 hover:text-[#E9582A] transition-all" style="text-decoration:none;">
            <span class="material-symbols-outlined text-[16px]">open_in_new</span>
          </a>
        </div>
      </div>
    </header>

    <main class="min-h-screen">
      <slot />
    </main>

    <script is:inline>
      const btn = document.getElementById('admin-theme-toggle');
      const slider = document.getElementById('admin-theme-toggle-slider');

      const updateSlider = () => {
        if (!slider) return;
        if (document.documentElement.classList.contains('dark')) {
          slider.style.transform = 'translateX(44px)';
          slider.style.backgroundColor = '#9333ea'; // Purple for dark
          slider.style.boxShadow = '0 0 10px rgba(147,51,234,0.6)';
        } else {
          slider.style.transform = 'translateX(0)';
          slider.style.backgroundColor = '#E9582A'; // Orange for light
          slider.style.boxShadow = '0 0 10px rgba(233,88,42,0.6)';
        }
      };

      if (btn) {
        btn.addEventListener('click', function(e) {
          const isDark = document.documentElement.classList.contains('dark');
          
          const toggleTheme = () => {
            if (isDark) {
              document.documentElement.classList.remove('dark');
              localStorage.setItem('color-theme', 'light');
            } else {
              document.documentElement.classList.add('dark');
              localStorage.setItem('color-theme', 'dark');
            }
            updateSlider();
          };

          if (!document.startViewTransition) {
            toggleTheme();
            return;
          }

          document.documentElement.classList.add('circle-transition');
          
          // Always use the button's screen position for reliable coordinates on all devices
          const _r = this.getBoundingClientRect();
          const x = _r.left + _r.width / 2;
          const y = _r.top + _r.height / 2;
          const endRadius = Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y)
          );

          const transition = document.startViewTransition(toggleTheme);
          
          transition.ready.then(() => {
            const clipPath = [
              `circle(0px at ${x}px ${y}px)`,
              `circle(${endRadius}px at ${x}px ${y}px)`
            ];
            
            document.documentElement.animate(
              { clipPath: clipPath },
              {
                duration: 700,
                easing: 'ease-in-out',
                pseudoElement: '::view-transition-new(root)',
              }
            );
          });
          
          transition.finished.finally(() => {
            document.documentElement.classList.remove('circle-transition');
          });
        });
      }

      // Initialize slider position
      updateSlider();
    </script>
  </body>
</html>
